# Runtime-only image: expects frontend-uni/dist/build/h5 prebuilt (low-RAM servers)
FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends fonts-wqy-zenhei fonts-arphic-uming libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt
COPY backend backend
COPY frontend frontend
COPY knowledge knowledge
COPY frontend-uni/dist/build/h5 frontend-uni/dist/build/h5
ENV DB_PATH=/data/data.db
VOLUME /data
EXPOSE 8000
WORKDIR /app/backend
# keep-alive 空闲时限须大于反代连接池 idle 上限（Caddy 默认 2min），避免复用陈旧连接 reset 即时 502
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-keep-alive", "130"]
