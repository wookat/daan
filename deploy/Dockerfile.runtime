# Runtime-only image: expects frontend-uni/dist/build/h5 prebuilt (low-RAM servers)
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi uvicorn httpx python-multipart
COPY backend backend
COPY frontend frontend
COPY knowledge knowledge
COPY frontend-uni/dist/build/h5 frontend-uni/dist/build/h5
ENV DB_PATH=/data/data.db
VOLUME /data
EXPOSE 8000
WORKDIR /app/backend
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
