{
  "name": "kaogong-miniapp-native",
  "version": "0.1.0",
  "private": true,
  "description": "答岸微信原生小程序（TypeScript + TDesign）",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node ../tools/design-tokens/build.mjs --check && node ../tools/design-tokens/lint-pages.mjs --strict && node -e \"process.env.ESLINT_USE_FLAT_CONFIG='false'; require('child_process').execFileSync(process.execPath,['node_modules/eslint/bin/eslint.js','miniprogram','--ext','.ts'],{stdio:'inherit'})\"",
    "test": "node ../frontend-uni/node_modules/vitest/vitest.mjs run --config scripts/vitest.config.mts"
  },
  "dependencies": {
    "tdesign-miniprogram": "~1.9.7"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^8.57.1",
    "miniprogram-api-typings": "^4.0.7",
    "miniprogram-automator": "^0.12.1",
    "typescript": "^5.9.3"
  }
}
