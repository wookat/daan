/* 设计 token：唯一来源 tools/design-tokens/tokens.json，改完跑 node tools/design-tokens/build.mjs。
   生成文件含 semantic/scale/component/module 变量、深色映射（prefers-color-scheme）、
   tdesign 主题变量、deprecated 别名（--t1/--surface/--success 等）与 .num/.q-text/.safe-b 工具类。回滚 = 删下面这一行。 */
@import './styles/tokens.generated.wxss';

page {
  background-color: var(--bg);
  color: var(--ink);
  font-size: var(--fs-body);
  font-family: var(--font-sans);
  /* webview 下 page 无默认高度，各页 .page-scroll{flex:1;height:100%} 依赖此约束 */
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 下面是页面沿用的全局类，值已换成 token；页面组接入 kg-* 组件后逐步删除 */
.card {
  background: var(--card);
  border-radius: var(--r-md);
  box-shadow: var(--sh-1);
  padding: var(--card-pad);
  margin-bottom: var(--card-gap);
}

.sec-h {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: var(--sp-16) 0 var(--sp-12);
}

.sec-t {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: var(--fs-h3);
  font-weight: var(--fw-semibold);
  color: var(--ink);
}

.sec-bar {
  width: 4px;
  height: 14px;
  border-radius: 2px;
  background: var(--brand);
  margin-right: var(--sp-8);
}

.sec-more {
  font-size: var(--fs-sub);
  color: var(--ink-3);
  font-weight: var(--fw-medium);
}

.btn-primary {
  height: var(--btn-h-lg);
  line-height: var(--btn-h-lg);
  background: var(--brand);
  color: var(--on-brand);
  border-radius: var(--r-full);
  text-align: center;
  font-size: var(--fs-body);
  font-weight: var(--fw-semibold);
}

.btn-ghost {
  height: var(--btn-h-lg);
  line-height: var(--btn-h-lg);
  background: var(--brand-soft);
  color: var(--brand-text);
  border-radius: var(--r-full);
  text-align: center;
  font-size: var(--fs-body);
  font-weight: var(--fw-semibold);
}

.tag {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  height: var(--tag-h);
  padding: 0 var(--sp-8);
  border-radius: var(--r-xs);
  font-size: var(--fs-caption);
  font-weight: var(--fw-medium);
}

.tag-brand { background: var(--brand-soft); color: var(--brand-text); }
.tag-ok { background: var(--ok-soft); color: var(--ok-strong); }
.tag-bad { background: var(--bad-soft); color: var(--bad-strong); }
.tag-warn { background: var(--warn-soft); color: var(--warn-strong); }
.tag-gray { background: var(--fill); color: var(--ink-3); }
.tag-accent { background: var(--streak-soft); color: var(--streak); }

.bar {
  height: 8px;
  border-radius: 4px;
  background: var(--brand-soft-2);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 4px;
  background: var(--brand);
}
