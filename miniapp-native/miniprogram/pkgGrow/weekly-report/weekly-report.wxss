.wrap {
  padding: var(--sp-16) var(--page-x) var(--sp-48);
}

.skel {
  display: flex;
  flex-direction: column;
  gap: var(--sp-12);
}

.sec {
  display: block;
  margin-bottom: var(--card-gap);
}

.row--hover {
  opacity: 0.7;
}

.h {
  display: block;
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: var(--sp-12);
}

/* 头部概览（H5 kg-hero-card plain + kg-stat-row） */
.hero-lab {
  display: block;
  font-size: var(--fs-sub);
  color: var(--ink-3);
}

.hero-val {
  display: flex;
  align-items: baseline;
  gap: var(--sp-4);
  font-size: var(--fs-display);
  font-weight: 600;
  color: var(--ink);
  line-height: var(--lh-display);
}

.hero-unit {
  font-size: var(--fs-sub);
  color: var(--ink-3);
  font-weight: 400;
}

.stat-row {
  display: flex;
  margin-top: var(--sp-12);
  padding-top: var(--sp-12);
  border-top: 1px solid var(--line);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.stat-n {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.stat-n.is-brand {
  color: var(--brand-text);
}

.stat-n.is-ok {
  color: var(--ok-strong);
}

.stat-n.is-bad {
  color: var(--bad-strong);
}

.stat-k {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

/* 徽章 */
.badges {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
  margin-bottom: var(--card-gap);
}

.badge {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  background: var(--warn-soft);
  border-radius: var(--r-md);
  padding: var(--sp-12) var(--sp-16);
  min-height: var(--hit-min);
}

.badge-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.badge-t {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--warn-strong);
}

.badge-s {
  font-size: var(--fs-caption);
  color: var(--warn-strong);
  margin-top: 2px;
}

/* 本周 vs 上周 */
.cmp-row {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  min-height: var(--hit-min);
  border-bottom: 1px solid var(--line);
}

.cmp-row:last-child {
  border-bottom: none;
}

.cmp-k {
  flex-shrink: 0;
  width: 72px;
  font-size: var(--fs-sub);
  color: var(--ink-2);
}

.cmp-v {
  flex: 1;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.cmp-p {
  flex-shrink: 0;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

/* 掌握度变化 */
.ms-row {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  min-height: var(--hit-min);
}

.ms-tag {
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
}

.ms-tag-t {
  font-size: var(--fs-caption);
  font-weight: 600;
  line-height: 1;
}

.ms-tag.up {
  background: var(--ok-soft);
  color: var(--ok-strong);
}

.ms-tag.down {
  background: var(--bad-soft);
  color: var(--bad-strong);
}

.ms-t {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-sub);
  color: var(--ink);
}

.ms-v {
  flex-shrink: 0;
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

/* 错因分布 */
.rs-row {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  min-height: var(--hit-min);
}

.rs-k {
  flex-shrink: 0;
  width: 72px;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rs-bar {
  flex: 1;
  height: 8px;
  background: var(--bad-soft);
  border-radius: var(--r-full);
  overflow: hidden;
}

.rs-fill {
  height: 100%;
  background: var(--bad);
  border-radius: var(--r-full);
}

.rs-v {
  flex-shrink: 0;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink);
}

.rs-p {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  font-weight: 400;
}

/* 模考回顾 */
.mk-line {
  display: block;
  font-size: var(--fs-body);
  color: var(--ink);
  margin-bottom: var(--sp-8);
}

.mk-line.sub {
  font-size: var(--fs-sub);
  color: var(--ink-2);
}

.mk-n {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--brand-text);
}

.mk-none {
  display: block;
  font-size: var(--fs-sub);
  color: var(--ink-2);
  margin-bottom: var(--sp-8);
}

/* 下周行动 */
.act-row {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  min-height: var(--hit-min);
  border-bottom: 1px solid var(--line);
}

.act-row:last-child {
  border-bottom: none;
}

.act-t {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-sub);
  color: var(--ink);
}

.act-go {
  flex-shrink: 0;
  font-size: var(--fs-sub);
  color: var(--brand-text);
  font-weight: 600;
}

/* 分享 */
.share-img {
  width: 100%;
  border-radius: var(--r-md);
  margin-bottom: var(--sp-12);
}

.share-wait {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-12);
  padding: var(--sp-16) 0;
}

.share-wait-t {
  font-size: var(--fs-sub);
  color: var(--ink-2);
}

.share-btns {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
}

.hidden-canvas {
  position: absolute;
  left: -9999px;
  top: 0;
  width: 660px;
  height: 760px;
}
