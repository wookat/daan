@import '../../styles/pkg-social.wxss';
@import '../../styles/md.wxss';

.ivhero { display: flex; flex-direction: column; gap: var(--sp-8); padding: var(--card-pad); border-radius: var(--r-lg); background: var(--brand-grad); color: var(--on-brand); margin-bottom: var(--card-gap); }
.ivhero-l { font-size: var(--fs-caption); color: var(--on-brand-2); }
.ivhero-v { display: flex; align-items: baseline; gap: var(--sp-4); }
.ivhero-n { font-size: var(--fs-display); font-weight: var(--fw-semibold); line-height: 1; }
.ivhero-u { font-size: var(--fs-sub); color: var(--on-brand-2); }
.ivhero-s { font-size: var(--fs-sub); line-height: var(--lh-sub); color: var(--on-brand-2); }
.ivhero-sum { font-size: var(--fs-sub); line-height: var(--lh-sub); color: var(--on-brand); border-top: 1px solid var(--on-brand-2); padding-top: var(--sp-8); opacity: 0.92; }
.row--hover { background: var(--fill); }
.qcard { display: block; margin-bottom: var(--sp-12); }
.qmeta { display: flex; align-items: center; gap: var(--sp-8); margin-bottom: var(--sp-8); }
.qsrc { font-size: var(--fs-caption); color: var(--ink-2); }
.stem { display: block; font-size: var(--fs-body); line-height: var(--lh-question); color: var(--ink); }
.timer-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--sp-12); }
.timer { display: flex; align-items: center; gap: var(--sp-4); font-size: var(--fs-sub); color: var(--ink-2); }
.anscard { display: block; margin-bottom: var(--sp-4); }
.ansbox { width: 100%; box-sizing: border-box; min-height: 160px; background: transparent; color: var(--ink); font-size: var(--fs-body); line-height: var(--lh-body); }
.ipt-ph { color: var(--ink-4); }
.cnt { display: block; text-align: right; font-size: var(--fs-caption); color: var(--ink-3); margin-bottom: var(--sp-12); }
.cnt-save { color: var(--ok); }
.btn-row { display: flex; gap: var(--sp-8); margin: var(--sp-12) 0; }
.grow { flex: 1; }
.card { display: block; margin-bottom: var(--card-gap); }
.card-t { display: block; font-size: var(--fs-sub); font-weight: var(--fw-semibold); color: var(--ink-2); margin-bottom: var(--sp-8); }
.dim-row { display: flex; align-items: center; gap: var(--sp-8); padding: var(--sp-4) 0; }
.dim-l { width: 72px; flex-shrink: 0; font-size: var(--fs-sub); color: var(--ink); }
.dim-bar { flex: 1; }
.dim-v { width: 24px; text-align: right; font-size: var(--fs-sub); font-weight: var(--fw-semibold); color: var(--brand-text); }
.pt { display: block; font-size: var(--fs-sub); line-height: var(--lh-sub); color: var(--ink-2); margin-top: var(--sp-4); }
.regen { margin-top: var(--sp-8); }
.regen-tip { display: block; font-size: var(--fs-caption); color: var(--warn-strong); }
.loading { display: flex; flex-direction: column; gap: var(--sp-8); }
.loading-t { font-size: var(--fs-caption); color: var(--ink-3); }
