<navbar title="学习提醒" back="{{true}}" />
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="wrap">
    <t-cell-group class="cells">
      <t-cell title="每日刷题提醒" description="每天 {{time}} · 未完成今日目标时提醒">
        <view slot="left-icon" class="row-ico bg-brand"><l-icon name="alarm-clock" size="20" tone="brand-text" /></view>
        <t-switch slot="note" value="{{on}}" size="small" bind:change="onToggle" />
      </t-cell>
      <picker mode="time" value="{{time}}" disabled="{{!on}}" bindchange="onTime">
        <t-cell title="提醒时间" description="建议安排在晚间黄金学习时段" arrow="{{on}}" hover="{{on}}" class="{{on ? '' : 'is-dim'}}">
          <view slot="left-icon" class="row-ico bg-brand"><l-icon name="clock" size="20" tone="brand-text" /></view>
          <text slot="note" class="time-v num">{{time}}</text>
        </t-cell>
      </picker>
    </t-cell-group>

    <t-cell-group wx:if="{{subAvail}}" class="cells">
      <t-cell
        title="微信订阅提醒"
        description="{{subOn ? '已订阅 · 点击关闭' : '一次授权可收到一条服务通知'}}"
        arrow
        hover
        bind:click="onSubTap"
      >
        <view slot="left-icon" class="row-ico bg-brand"><l-icon name="send" size="20" tone="brand-text" /></view>
        <text slot="note" class="time-v">{{subOn ? '已订阅' : '去订阅'}}</text>
      </t-cell>
    </t-cell-group>

    <kg-section-header title="提醒样式预览" />
    <kg-card variant="raised" class="push">
      <view class="hd"><text class="appico">岸</text><text class="hd-t">岸上见 · <text class="num">{{time}}</text></text></view>
      <text class="tt">{{reached ? '今日目标已完成' : '今天还差 ' + left + ' 题到目标'}}</text>
      <text class="bd">今日目标 {{goal}} 题，已做 {{done}} 题</text>
    </kg-card>
    <kg-card variant="soft" padding="12" class="tip">
      <l-icon name="lightbulb" size="16" tone="brand-text" />
      <text class="tip-t">提醒只在「有事可做」时打扰你：当天已达成目标则改为轻量鼓励；微信端通过订阅消息送达，每次授权可收到一条。</text>
    </kg-card>
  </view>
</scroll-view>
