<navbar class="{{tc}}" title="PK 战绩" back="{{true}}" />
<scroll-view class="{{tc}} page-scroll" scroll-y type="list">
  <view class="wrap">
    <block wx:if="{{loading}}">
      <view class="hero"><t-skeleton theme="text" animation="gradient" /></view>
      <kg-card variant="raised" class="vs"><t-skeleton theme="paragraph" animation="gradient" /></kg-card>
    </block>

    <!-- 无效 / 未结束对局 -->
    <kg-empty
      wx:elif="{{errMsg}}"
      icon="swords"
      title="看不到这场战绩"
      desc="{{errMsg}}"
      ctaText="去 PK 大厅"
      bind:cta="onChallenge"
    />

    <block wx:elif="{{d}}">
      <view class="hero">
        <view class="hero-ico"><l-icon name="swords" size="28" tone="on-brand" /></view>
        <view class="hero-txt">
          <text class="hero-t">答题 PK 战绩</text>
          <text class="hero-s">{{modLabel}} · 同组 <text class="num">{{d.n_questions}}</text> 题 · 挑战码 <text class="num">{{d.code}}</text></text>
        </view>
      </view>

      <kg-card variant="raised" class="vs" body-class="vs-body">
        <view class="p {{d.winner === 'creator' ? 'win' : ''}}">
          <view class="crown"><l-icon wx:if="{{d.winner === 'creator'}}" name="crown" size="20" tone="streak" /></view>
          <view class="av">{{creatorAv}}</view>
          <text class="nm">{{creatorName}}</text>
          <text class="sc num">{{d.creator.score}}</text>
          <text class="meta">{{creatorMeta}}</text>
        </view>
        <view class="mid">
          <text class="mid-vs">VS</text>
          <kg-tag class="mid-tag" tone="{{d.winner === 'draw' ? 'neutral' : 'warn'}}"><text class="mid-res">{{resultText}}</text></kg-tag>
        </view>
        <view class="p {{d.winner === 'opponent' ? 'win' : ''}}">
          <view class="crown"><l-icon wx:if="{{d.winner === 'opponent'}}" name="crown" size="20" tone="streak" /></view>
          <view class="av rival">{{opponentAv}}</view>
          <text class="nm">{{opponentName}}</text>
          <text class="sc num">{{d.opponent.score}}</text>
          <text class="meta">{{opponentMeta}}</text>
        </view>
      </kg-card>

      <kg-card variant="raised" class="cta" body-class="cta-body">
        <text class="cta-t">不服来战？</text>
        <text class="cta-s">同组 10 题拼手速，答对 +80 分，越快加成越高</text>
        <kg-button variant="primary" size="lg" block icon="zap" bind:click="onChallenge">去 PK 大厅，不服来战</kg-button>
        <kg-button variant="text" size="md" block icon="copy" bind:click="onCopyLink">复制战绩链接</kg-button>
      </kg-card>
    </block>
  </view>
</scroll-view>
