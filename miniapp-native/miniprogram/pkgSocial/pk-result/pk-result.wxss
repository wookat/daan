.wrap {
  padding: var(--sp-12) var(--page-x) calc(var(--sp-40) + env(safe-area-inset-bottom));
}

.hero {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  padding: var(--card-pad);
  border-radius: var(--r-lg);
  background: var(--brand-grad);
  color: var(--on-brand);
  margin-bottom: var(--card-gap);
}

.hero-ico {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  border-radius: var(--r-md);
  background: var(--brand-press);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-txt {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.hero-t {
  font-size: var(--fs-h2);
  font-weight: 600;
}

.hero-s {
  font-size: var(--fs-caption);
  color: var(--on-brand-2);
  margin-top: 2px;
}

/* 对阵卡 */
.vs {
  display: block;
  margin-bottom: var(--card-gap);
}

.vs-body {
  display: flex;
  align-items: stretch;
}

.p {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--sp-8) var(--sp-4);
  border-radius: var(--r-md);
}

.p.win {
  background: var(--warn-soft);
}

.crown {
  height: 20px;
}

.av {
  width: 48px;
  height: 48px;
  border-radius: var(--r-full);
  background: var(--brand);
  color: var(--on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-h2);
  font-weight: 600;
  margin-top: var(--sp-4);
}

.av.rival {
  background: var(--bad);
}

.nm {
  margin-top: var(--sp-8);
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sc {
  font-size: var(--fs-display);
  font-weight: 600;
  color: var(--ink);
  line-height: 1.2;
  margin-top: var(--sp-4);
}

.meta {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}

.mid {
  min-width: 56px;
  max-width: 40%;
  flex: 0 1 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--sp-8);
}

.mid-vs {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink-4);
  font-style: italic;
}

/* CTA */
.cta {
  display: block;
}

.cta-body {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--sp-8);
  text-align: center;
}

.cta-t {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink);
}

.cta-s {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-bottom: var(--sp-8);
}

@media (min-width: 1024px) {
  .wrap {
    max-width: 640px;
    margin: 0 auto;
  }
}

/* 胜者标签「长昵称 获胜」：随 .mid 收缩省略，不撑破两侧选手列 */
.mid-tag {
  display: block;
  max-width: 100%;
}

.mid-res {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
