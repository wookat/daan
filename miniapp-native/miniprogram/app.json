{
  "pages": [
    "pages/home/home",
    "pages/book/book",
    "pages/exam/exam",
    "pages/exam/mini",
    "pages/exam/report",
    "pages/stats/stats",
    "pages/profile/profile",
    "pages/practice/practice",
    "pages/login/login",
    "pages/team/team",
    "pages/team/panel",
    "pages/share/share",
    "pages/share/pk-result",
    "pages/social/poster"
  ],
  "subPackages": [
    {
      "root": "pkgLearn",
      "name": "learn",
      "pages": [
        "setup/setup",
        "search/search",
        "practice-history/practice-history",
        "offline/offline"
      ]
    },
    {
      "root": "pkgExam",
      "name": "exam",
      "pages": [
        "list/list",
        "exam/exam",
        "report/report",
        "contest/contest",
        "contest-report/contest-report",
        "shenlun/shenlun"
      ]
    },
    {
      "root": "pkgSocial",
      "name": "social",
      "pages": [
        "ask/ask",
        "pk/pk",
        "pk-result/pk-result",
        "discuss/discuss",
        "plaza/plaza",
        "inbox/inbox",
        "favorites/favorites",
        "interview/interview",
        "history/history",
        "reminders/reminders"
      ]
    },
    {
      "root": "pkgGrow",
      "pages": ["daily/daily", "calendar/calendar", "weekly-report/weekly-report", "mastery-map/mastery-map"]
    }
  ],
  "preloadRule": {
    "pages/exam/exam": { "network": "all", "packages": ["pkgExam"] },
    "pages/home/home": { "network": "wifi", "packages": ["pkgLearn", "pkgGrow"] },
    "pages/profile/profile": { "network": "wifi", "packages": ["pkgSocial", "pkgGrow"] }
  },
  "renderer": "webview",
  "componentFramework": "glass-easel",
  "lazyCodeLoading": "requiredComponents",
  "darkmode": true,
  "themeLocation": "theme.json",
  "window": {
    "navigationStyle": "custom",
    "navigationBarTitleText": "错题邦",
    "navigationBarTextStyle": "@navTxtStyle",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle"
  },
  "tabBar": {
    "custom": true,
    "color": "#7D818F",
    "selectedColor": "#1e4a6b",
    "backgroundColor": "#ffffff",
    "list": [
      { "pagePath": "pages/home/home", "text": "刷题" },
      { "pagePath": "pages/book/book", "text": "错题本" },
      { "pagePath": "pages/exam/exam", "text": "模考" },
      { "pagePath": "pages/stats/stats", "text": "统计" },
      { "pagePath": "pages/profile/profile", "text": "我的" }
    ]
  },
  "usingComponents": {},
  "sitemapLocation": "sitemap.json"
}
