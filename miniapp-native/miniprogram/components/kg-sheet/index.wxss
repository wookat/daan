.kg-sheet { background: var(--card); border-radius: var(--r-lg) var(--r-lg) 0 0; padding: var(--sp-8) var(--page-x) calc(var(--sp-16) + env(safe-area-inset-bottom)); display: flex; flex-direction: column; box-sizing: border-box; }
.kg-sheet__handle { width: 36px; height: 4px; border-radius: var(--r-full); background: var(--line-strong); margin: 0 auto var(--sp-8); }
.kg-sheet__hd { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-8); min-height: var(--hit-min); margin-bottom: var(--sp-4); }
.kg-sheet__t { flex: 1; min-width: 0; font-size: var(--fs-h3); font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.kg-sheet__x { flex-shrink: 0; width: var(--hit-min); height: var(--hit-min); margin-right: calc(-1 * var(--sp-8)); display: flex; align-items: center; justify-content: center; border-radius: var(--r-full); }
.kg-sheet__x--hover { background: var(--fill); }
.kg-sheet__body { flex: 1; min-height: 0; }
.kg-sheet__ft:empty { display: none; }
