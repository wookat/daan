/* 柱宽有上限：柱少时不铺满成色块；空柱不画，只靠连续基线表达“这天没数据”（不画浅色轨道，避免读成 100%） */
.kg-bars { position: relative; display: flex; align-items: flex-end; justify-content: space-evenly; gap: var(--sp-4); padding-top: var(--sp-8); border-bottom: 1px solid var(--line); }
.kg-bars.has-labels { border-bottom: none; }
.kg-bars__base { position: absolute; left: 0; right: 0; bottom: 18px; border-top: 1px solid var(--line-strong); }
.kg-bars__col { flex: 1; min-width: 0; max-width: 36px; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.kg-bars__pct { font-size: var(--fs-caption); color: var(--ink-2); height: 14px; line-height: 14px; }
.kg-bars__track { flex: 1; width: 100%; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
.kg-bars__bar { width: 100%; border-radius: 3px 3px 0 0; background: var(--brand); min-height: 2px; }
.kg-bars__bar.is-empty { min-height: 0; background: transparent; }
.kg-bars__bar.is-soft { background: var(--brand-soft-2); }
.kg-bars__bar.is-ok { background: var(--ok); }
.kg-bars__bar.is-warn { background: var(--warn); }
.kg-bars__bar.is-bad { background: var(--bad); }
.kg-bars__day { font-size: var(--fs-caption); color: var(--ink-3); height: 14px; line-height: 14px; margin-top: var(--sp-4); }
.kg-bars__target { position: absolute; left: 0; right: 0; border-top: 1px dashed var(--warn-strong); z-index: 1; pointer-events: none; }
.kg-bars__target-t { position: absolute; right: 0; top: -16px; font-size: var(--fs-caption); color: var(--warn-strong); }
.kg-bars__x { display: flex; justify-content: space-between; font-size: var(--fs-caption); color: var(--ink-3); margin-top: var(--sp-4); }
