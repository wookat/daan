/* KgButton 小程序版：薄封装 t-button，高度/圆角/字号走 --btn-* / --r-* token，与 H5 kg-button 同一口径 */
.kg-btn {
  --td-button-border-radius: var(--r-sm);
  --td-button-font-weight: 600;
  --td-button-large-height: var(--btn-h-lg);
  --td-button-medium-height: var(--btn-h-md);
  --td-button-small-height: var(--btn-h-sm);
  --td-button-large-font-size: var(--fs-body);
  --td-button-medium-font-size: var(--fs-body);
  --td-button-small-font-size: var(--fs-sub);
  --td-button-primary-bg-color: var(--brand);
  --td-button-primary-active-bg-color: var(--brand-press);
  --td-button-primary-border-color: var(--brand);
  --td-button-primary-active-border-color: var(--brand-press);
  --td-button-primary-color: var(--on-brand);
  --td-button-light-bg-color: var(--brand-soft);
  --td-button-light-active-bg-color: var(--brand-soft-2);
  --td-button-light-color: var(--brand-text);
  --td-button-light-border-color: var(--brand-soft);
  --td-button-light-active-border-color: var(--brand-soft-2);
  /* ghost → t-button variant=outline：走 *-outline-* 与 --td-bg-color-container，而非 default-* */
  --td-bg-color-container: var(--card);
  --td-button-default-outline-color: var(--ink);
  --td-button-default-outline-border-color: var(--line);
  --td-button-default-outline-active-bg-color: var(--fill);
  --td-button-default-outline-active-border-color: var(--line);
  --td-button-primary-text-color: var(--brand-text);
  --td-button-primary-text-active-bg-color: var(--brand-soft);
  --td-button-danger-text-color: var(--bad);
  --td-button-danger-text-active-bg-color: var(--bad-soft);
  --td-button-danger-bg-color: var(--bad);
  --td-button-danger-active-bg-color: var(--bad-strong);
  --td-button-danger-border-color: var(--bad);
  --td-button-danger-color: var(--on-brand);
}
.kg-btn--ghost.kg-btn--tone-bad {
  --td-button-default-outline-color: var(--bad);
  --td-button-default-outline-border-color: var(--bad);
  --td-button-default-outline-active-bg-color: var(--bad-soft);
  --td-button-default-outline-active-border-color: var(--bad);
}
.kg-btn--tone-inverse {
  --td-button-primary-bg-color: var(--on-brand);
  --td-button-primary-active-bg-color: var(--on-brand-2);
  --td-button-primary-border-color: var(--on-brand);
  --td-button-primary-color: var(--brand);
  --td-bg-color-container: transparent;
  --td-button-default-outline-color: var(--on-brand);
  --td-button-default-outline-border-color: rgba(255, 255, 255, 0.5);
  --td-button-default-outline-active-bg-color: rgba(255, 255, 255, 0.14);
  --td-button-default-outline-active-border-color: rgba(255, 255, 255, 0.7);
}
/* 图标与文字间距与 H5 kg-btn__in gap 同口径 */
.kg-btn__icon {
  margin-right: var(--sp-8);
}
/* sm/md/lg 视觉高度不变（30/32/40px），命中区纵向扩到 --hit-min(44px)，
   与 H5 kg-button.vue 的 ::after 命中层同口径 */
.kg-btn { position: relative; }
.kg-btn::after {
  content: '';
  display: block;
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: var(--hit-min);
  border: none;
  transform: translateY(-50%);
}
