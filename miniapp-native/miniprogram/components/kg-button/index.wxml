<t-button
  class="kg-btn kg-btn--{{variant}} kg-btn--{{size}} kg-btn--tone-{{tone}}"
  theme="{{theme}}"
  variant="{{tVariant}}"
  size="{{tSize}}"
  block="{{block}}"
  disabled="{{disabled}}"
  loading="{{loading}}"
  shape="round"
  open-type="{{openType}}"
  bind:tap="onTap"
>
  <l-icon wx:if="{{icon}}" class="kg-btn__icon" name="{{icon}}" size="{{size === 'sm' ? 16 : 20}}" tone="inherit" />
  <slot />
</t-button>
