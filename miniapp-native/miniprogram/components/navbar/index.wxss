.navbar {
  position: relative;
  z-index: 100;
  background: transparent;
}

/* 沉浸式品牌头：由页面渲染渐变背景，导航栏透明 + 白字 */
.navbar-brand {
  background: transparent;
}

.nav-row {
  position: relative;
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 32rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  margin-left: -16rpx;
  margin-right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 400;
  color: var(--t1, #171a23);
  flex-shrink: 0;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--t1, #171a23);
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.navbar-brand .nav-title {
  color: #fff;
}

.navbar-brand .nav-back {
  color: #fff;
}
