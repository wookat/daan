.navbar {
  position: relative;
  z-index: 100;
  background: transparent;
}

/* 沉浸式品牌头：由页面渲染渐变背景，导航栏透明 + 白字 */
.navbar-brand {
  background: transparent;
}

.nav-row {
  position: relative;
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 32rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  margin-left: -16rpx;
  margin-right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-h2);
  font-weight: 400;
  color: var(--ink);
  flex-shrink: 0;
}

.nav-title {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.navbar-brand .nav-title {
  color: var(--on-brand);
}

.navbar-brand .nav-back {
  color: var(--on-brand);
}
