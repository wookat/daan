.navbar {
  position: relative;
  z-index: 100;
  background: transparent;
}

/* 沉浸式品牌头：由页面渲染渐变背景，导航栏透明 + 白字 */
.navbar-brand {
  background: transparent;
}

.nav-row {
  position: relative;
  height: var(--hit-min);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 var(--page-x);
}

.nav-back {
  width: var(--hit-min);
  height: var(--hit-min);
  margin-left: calc(-1 * var(--sp-12));
  margin-right: var(--sp-4);
  border-radius: var(--r-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back--hover {
  background: var(--fill);
}

.navbar-brand .nav-back--hover {
  background: var(--brand-press);
}

.nav-title {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.navbar-brand .nav-title {
  color: var(--on-brand);
}
