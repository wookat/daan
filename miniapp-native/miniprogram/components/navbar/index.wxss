.navbar {
  position: relative;
  z-index: 100;
  background: var(--bg, #f5f7fb);
}

/* 沉浸式品牌头：由页面渲染渐变背景，导航栏透明 + 白字 */
.navbar-brand {
  background: transparent;
}

.nav-row {
  position: relative;
  height: 88rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.nav-back {
  position: absolute;
  left: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border-radius: var(--r-full, 999rpx);
  background: var(--surface, #ffffff);
  box-shadow: var(--sh-1, 0 2rpx 8rpx rgba(23, 26, 35, 0.06));
  color: var(--t1, #171a23);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--t1, #171a23);
}

.navbar-brand .nav-title {
  color: #fff;
}

.navbar-brand .nav-back {
  background: rgba(255, 255, 255, 0.22);
  box-shadow: none;
  color: #fff;
}
