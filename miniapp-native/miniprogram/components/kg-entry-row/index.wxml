<view class="kg-entry" hover-class="kg-entry--hover" hover-stay-time="60" bind:tap="onTap">
  <l-icon wx:if="{{icon}}" name="{{icon}}" size="20" tone="ink-2" />
  <view class="kg-entry__main">
    <text class="kg-entry__t">{{title}}</text>
    <text wx:if="{{desc}}" class="kg-entry__s">{{desc}}</text>
  </view>
  <slot />
  <l-icon wx:if="{{chevron}}" class="kg-entry__chev" name="chevron-right" size="16" tone="faint" />
</view>
