.kg-sh { display: flex; align-items: center; justify-content: space-between; min-height: 44px; }
.kg-sh__t { font-size: var(--fs-h3); font-weight: 600; color: var(--ink); }
.kg-sh__more { display: flex; align-items: center; gap: 2px; min-height: var(--hit-min); padding: 0 var(--sp-4); font-size: var(--fs-sub); color: var(--ink-3); }
.kg-sh__more--hover { opacity: 0.6; }
