:host { display: block; }
.kg-grid4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: var(--card);
  border-radius: var(--r-sm);
  padding: var(--sp-8) 0;
}
.kg-grid4__it {
  height: 72px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--sp-8);
  border-radius: var(--r-sm);
}
.kg-grid4__it--hover { background: var(--fill); }
.kg-grid4__ico { position: relative; width: 24px; height: 24px; }
.kg-grid4__badge {
  position: absolute;
  top: -6px;
  right: -14px;
  padding: 0 4px;
  min-width: 14px;
  height: 14px;
  line-height: 14px;
  border-radius: 7px;
  background: var(--bad);
  color: var(--on-brand);
  font-size: var(--fs-caption);
  transform: scale(0.85);
  text-align: center;
}
.kg-grid4__l { font-size: var(--fs-sub); color: var(--ink-2); line-height: 1; }
