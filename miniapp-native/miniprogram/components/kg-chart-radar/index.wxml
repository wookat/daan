<view class="kg-radar" style="{{boxStyle}}" role="img" aria-label="能力雷达">
  <view wx:for="{{rings}}" wx:key="*this" class="kg-radar__ring" style="{{item}}" />
  <view class="kg-radar__poly" style="{{polyStyle}}" />
  <view wx:for="{{labels}}" wx:key="key" class="kg-radar__lab" style="{{item.style}}">
    <text class="kg-radar__name">{{item.name}}</text>
    <text class="kg-radar__val num">{{item.pct}}%</text>
  </view>
</view>
