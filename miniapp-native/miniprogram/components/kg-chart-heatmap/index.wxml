<view class="kg-hm" role="img" aria-label="近 12 周学习热力图，共 {{total}} 次">
  <view class="kg-hm__body">
    <view class="kg-hm__ylab">
      <text wx:for="{{yLabels}}" wx:key="index" class="kg-hm__yl">{{item}}</text>
    </view>
    <view class="kg-hm__grid">
      <view wx:for="{{cols}}" wx:key="index" wx:for-item="col" class="kg-hm__col">
        <view wx:for="{{col}}" wx:key="index" class="kg-hm__c lv{{item.lv}} {{item.future ? 'is-fut' : ''}}" />
      </view>
    </view>
  </view>
  <view class="kg-hm__legend">
    <text class="kg-hm__note">{{note}}</text>
    <text class="kg-hm__lt">少</text>
    <view wx:for="{{legend}}" wx:key="*this" class="kg-hm__c is-lg lv{{item}}" />
    <text class="kg-hm__lt">多</text>
  </view>
</view>
