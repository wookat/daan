.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: row;
  background: var(--surface, #ffffff);
  border-top: 1rpx solid var(--border, #eceef4);
  padding: 6rpx 16rpx 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 10rpx;
}

.tab-ic {
  width: 44rpx;
  height: 44rpx;
}

.tab-t {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: var(--t3, #858ba3);
}

.tab.on .tab-t {
  color: var(--brand-500, #3b6ff5);
  font-weight: 600;
}

.tab.on .tab-ic {
  transform: translateY(-2rpx);
}
