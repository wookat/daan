.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: row;
  background: var(--card);
  border-top: 1px solid var(--line);
  padding: var(--sp-4) var(--sp-8) 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab {
  flex: 1;
  min-height: var(--hit-min);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-4) 0;
}

.tab-ic {
  width: 22px;
  height: 22px;
}

.tab-t {
  margin-top: 2px;
  font-size: var(--fs-caption);
  font-weight: 500;
  color: var(--ink-3);
}

.tab.on .tab-t {
  color: var(--brand-text);
  font-weight: 600;
}

.tab.on .tab-ic {
  transform: translateY(-1px);
}
