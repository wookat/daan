<view class="tabbar kg-theme-root {{tc}}">
  <view
    wx:for="{{tabs}}"
    wx:key="pagePath"
    class="tab {{active === index ? 'on' : ''}}"
    data-index="{{index}}"
    bind:tap="onTap"
  >
    <image class="tab-ic" src="{{active === index ? item.iconOn : item.icon}}" mode="aspectFit" />
    <text class="tab-t">{{item.text}}</text>
  </view>
</view>
