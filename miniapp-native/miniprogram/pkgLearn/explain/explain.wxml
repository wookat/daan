<navbar title="AI 讲解" back="{{true}}" />
<scroll-view class="page-scroll" scroll-y type="list" scroll-into-view="{{r && !r.streaming ? 'bottom' : ''}}">
  <view class="wrap">
    <!-- 输入面板：无题目上下文时手动粘贴 -->
    <kg-card wx:if="{{!r && !loading}}" class="card">
      <text class="h">粘贴题目文字，AI 逐步讲解</text>
      <t-textarea
        class="ta"
        value="{{qtext}}"
        placeholder="把题干和选项粘贴到这里…"
        maxlength="{{2000}}"
        autosize="{{ {minHeight: 120, maxHeight: 260} }}"
        bind:change="onQtext"
      />
      <view class="row">
        <text class="lb">我选的答案（可选）</text>
        <t-input class="ua" value="{{uanswer}}" placeholder="A/B/C/D" borderless bind:change="onUanswer" />
      </view>
      <kg-button variant="primary" size="md" block icon="sparkles" bind:click="onSubmitText">开始讲解</kg-button>
      <kg-empty wx:if="{{error}}" compact icon="wifi-off" title="生成失败：{{error}}" ctaText="重试" bind:cta="onRetry" />
    </kg-card>

    <!-- 生成中 -->
    <kg-card wx:if="{{loading}}" class="card" variant="soft">
      <view class="gen"><l-icon name="sparkles" size="20" tone="brand-text" /><text class="gen-t">AI 正在分析题目… <text class="num">{{secs}}</text>s</text></view>
      <t-skeleton theme="paragraph" animation="gradient" />
    </kg-card>

    <block wx:if="{{r}}">
      <!-- 用户消息 -->
      <view class="msg user">
        <view class="bubble ub">
          <text class="ub-t">{{r.userText}}</text>
          <text wx:if="{{r.user_answer}}" class="ub-ans">我选：{{r.user_answer}}</text>
        </view>
      </view>

      <!-- AI 消息 -->
      <view class="msg ai">
        <kg-card variant="soft" class="bubble ab">
          <view wx:if="{{r.module_name || r.question_type}}" class="tags">
            <kg-tag wx:if="{{r.module_name}}" tone="brand">{{r.module_name}}</kg-tag>
            <kg-tag wx:if="{{r.question_type}}" tone="neutral">{{r.question_type}}</kg-tag>
          </view>
          <view wx:if="{{r.ansCard}}" class="anscard">
            <view class="ans-big num">{{r.ansCard.ans}}</view>
            <view class="ans-r">
              <kg-tag wx:if="{{r.ansCard.method}}" tone="brand">{{r.ansCard.method}}</kg-tag>
              <text class="ans-brief">{{r.ansCard.brief}}</text>
            </view>
          </view>
          <rich-text wx:if="{{r.html}}" nodes="{{r.html}}" class="md" />
          <t-skeleton wx:elif="{{r.streaming}}" theme="paragraph" animation="gradient" />

          <view wx:if="{{r.explain_key && !r.streaming}}" class="raterow">
            <text class="rate-q">{{r.rated ? (r.rated === 'up' ? '已反馈：有用' : '已反馈：有误，我们会核查') : '这条解析有帮助吗？'}}</text>
            <view wx:if="{{!r.rated}}" class="rate-btns">
              <kg-button variant="ghost" size="sm" icon="thumbs-up" bind:click="onRateUp">有用</kg-button>
              <kg-button variant="ghost" size="sm" tone="bad" icon="thumbs-down" bind:click="onRateDown">有误</kg-button>
            </view>
          </view>

          <view wx:if="{{!r.streaming}}" class="chips">
            <kg-button variant="secondary" size="sm" bind:click="onFollowupDetail">再讲细一点</kg-button>
            <kg-button variant="secondary" size="sm" loading="{{r.simLoading}}" disabled="{{r.simLoading}}" bind:click="onGenSimilar">{{r.simLoading ? '出题中…' + r.simSecs + 's' : '出一道同款题'}}</kg-button>
            <kg-button variant="{{r.saved ? 'ghost' : 'secondary'}}" size="sm" icon="{{r.saved ? 'check' : ''}}" bind:click="onSave">{{r.saved ? '已存错题本' : '存入错题本'}}</kg-button>
            <kg-button wx:if="{{r.qid}}" variant="text" size="sm" bind:click="onViewQuestion">查看原题</kg-button>
          </view>
        </kg-card>
      </view>

      <!-- 举一反三 -->
      <view wx:if="{{r.sim}}" class="msg ai">
        <kg-card variant="soft" class="bubble ab">
          <view class="tags"><kg-tag tone="brand">举一反三</kg-tag></view>
          <rich-text nodes="{{r.sim.qHtml}}" class="md" />
          <text class="label">先选你的答案再看解析：</text>
          <view class="ans-chips">
            <view
              wx:for="{{simOpts}}"
              wx:key="*this"
              class="ans-chip {{r.sim.optCls[item]}} {{r.sim.picked ? 'locked' : ''}}"
              role="button"
              aria-disabled="{{r.sim.picked ? 'true' : 'false'}}"
              data-o="{{item}}"
              bind:tap="onPickSim"
            >{{item}}</view>
          </view>
          <view wx:if="{{r.sim.picked && r.sim.ansHtml}}">
            <rich-text nodes="{{r.sim.ansHtml}}" class="md" />
            <view class="chips">
              <kg-button variant="secondary" size="sm" bind:click="onExplainSim">详解这道题</kg-button>
              <kg-button
                wx:if="{{r.sim.correct && r.sim.picked !== r.sim.correct}}"
                variant="{{r.sim.saved ? 'ghost' : 'secondary'}}"
                size="sm"
                icon="{{r.sim.saved ? 'check' : ''}}"
                bind:click="onSaveSim"
              >{{r.sim.saved ? '已存错题本' : '存入错题本'}}</kg-button>
            </view>
          </view>
        </kg-card>
      </view>

      <!-- 追问记录 -->
      <block wx:for="{{r.fu}}" wx:key="index" wx:for-item="m">
        <view wx:if="{{m.role === 'user'}}" class="msg user"><view class="bubble ub"><text class="ub-t">{{m.content}}</text></view></view>
        <view wx:else class="msg ai"><kg-card variant="soft" class="bubble ab"><rich-text nodes="{{m.html}}" class="md" /></kg-card></view>
      </block>
      <view wx:if="{{r.fuLoading}}" class="msg ai"><kg-card variant="soft" class="bubble ab"><t-skeleton theme="text" animation="gradient" /></kg-card></view>
    </block>
    <view id="bottom" class="bottom-pad"></view>
  </view>
</scroll-view>

<!-- 追问输入栏 -->
<view wx:if="{{r && !r.streaming}}" class="fubar">
  <t-input class="fu-in" value="{{fuText}}" placeholder="继续追问，比如：为什么不能选 B？" borderless confirm-type="send" bind:change="onFuText" bind:enter="onSendFollowup" />
  <kg-button variant="primary" size="sm" icon="send" disabled="{{!fuText || r.fuLoading}}" bind:click="onSendFollowup">发送</kg-button>
</view>
