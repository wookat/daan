.wrap {
  padding: var(--sp-16) var(--page-x) calc(var(--sp-48) + env(safe-area-inset-bottom));
}

.group {
  margin-bottom: var(--sp-8);
}

.item {
  margin-bottom: var(--card-gap);
}

.row {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  min-height: var(--hit-min);
}

.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}

.row-top {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  flex-wrap: wrap;
}

.time {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.meta {
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

.pct {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink);
  flex-shrink: 0;
}

.pct.hi {
  color: var(--ok-strong);
}

.pct.lo {
  color: var(--bad-strong);
}

.arrow {
  flex-shrink: 0;
  display: flex;
  transition: transform var(--dur-fast);
}

.arrow.open {
  transform: rotate(90deg);
}

.detail {
  border-top: 1px solid var(--line);
  margin-top: var(--sp-12);
  padding-top: var(--sp-8);
}

.d-item {
  border-bottom: 1px solid var(--line);
}

.d-item:last-child {
  border-bottom: none;
}

.d-row {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-8);
  padding: var(--sp-12) 0;
}

.d-mark {
  flex-shrink: 0;
  margin-top: 2px;
  display: flex;
}

.d-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}

.d-q {
  font-size: var(--fs-sub);
  color: var(--ink);
  line-height: 1.6;
}

.d-q.ellip2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.d-row.wrong .d-q {
  color: var(--bad-strong);
}

.d-ans {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.d-secs {
  flex-shrink: 0;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}

.d-exp {
  padding: 0 0 var(--sp-12) var(--sp-24);
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
}

.d-opt {
  font-size: var(--fs-sub);
  color: var(--ink-2);
}

.d-opt.ans {
  color: var(--ok-strong);
  font-weight: 600;
}

.d-opt.bad {
  color: var(--bad-strong);
  text-decoration: line-through;
}

.d-ansline {
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

.d-expl {
  font-size: var(--fs-sub);
  color: var(--ink-2);
  line-height: 1.7;
}

.d-ops {
  display: flex;
  gap: var(--sp-8);
}

.btn-redo {
  display: block;
  margin-top: var(--sp-12);
}

.skel {
  display: flex;
  flex-direction: column;
  gap: var(--sp-12);
}
