<navbar title="打卡海报" back="{{true}}" />
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="wrap">
    <block wx:if="{{loading}}">
      <view class="poster poster-skel"><t-skeleton theme="image" animation="gradient" /></view>
      <text class="tip">正在生成海报…</text>
    </block>
    <block wx:else>
      <image wx:if="{{imgSrc}}" class="poster" src="{{imgSrc}}" mode="widthFix" bind:longpress="onSave" />
      <kg-empty
        wx:else
        icon="triangle-alert"
        title="海报生成失败"
        desc="{{err || '请稍后重试'}}"
        ctaText="重新生成"
        bind:cta="build"
      />
      <view class="actions">
        <kg-button variant="primary" size="lg" block icon="save" disabled="{{!imgSrc || streak0}}" bind:click="onSave">保存图片</kg-button>
        <t-button class="share-btn" theme="light" size="large" shape="round" block open-type="share">
          <l-icon name="share-2" size="20" tone="brand-text" />分享给好友
        </t-button>
        <text wx:if="{{streak0}}" class="tip tip-warn">打卡 1 天后可生成海报，先去做一组题吧</text>
        <text wx:else class="tip">保存后可分享到朋友圈 / 小红书，和考友一起上岸</text>
      </view>
    </block>
    <canvas id="posterCanvas" type="2d" class="hidden-canvas" />
  </view>
</scroll-view>
