.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  max-width: 480px;
  margin: 0 auto;
  padding: var(--sp-12) var(--page-x) calc(var(--sp-40) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster {
  width: 100%;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-3);
}

.poster-skel {
  aspect-ratio: 660 / 900;
  overflow: hidden;
  background: var(--fill);
}

.actions {
  width: 100%;
  margin-top: var(--sp-16);
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
}

.share-btn {
  --td-button-border-radius: var(--r-full);
  --td-button-large-height: var(--btn-h-lg);
  --td-button-large-font-size: var(--fs-body);
  --td-button-light-color: var(--brand-text);
  --td-button-light-bg-color: var(--brand-soft);
  --td-button-light-border-color: var(--brand-soft);
  --td-button-light-active-bg-color: var(--brand-soft-2);
  --td-button-light-active-border-color: var(--brand-soft-2);
}

.tip {
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-4);
}

.tip-warn {
  color: var(--warn-strong);
}

.hidden-canvas {
  position: absolute;
  left: -9999px;
  top: 0;
  width: 660px;
  height: 900px;
}
