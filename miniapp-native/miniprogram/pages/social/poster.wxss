.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading {
  text-align: center;
  color: var(--t3);
  font-size: 25rpx;
  padding: 60rpx 0;
}

.poster {
  width: 620rpx;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(59, 111, 245, 0.3);
}

.bar {
  width: 620rpx;
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 600;
  background: var(--brand-500);
  color: #fff;
}

.btn.off {
  opacity: 0.5;
}

.btn.ghost {
  background: var(--brand-50);
  color: var(--brand-500);
  border: none;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

.hidden-canvas {
  position: absolute;
  left: -9999rpx;
  top: 0;
  width: 660px;
  height: 900px;
}
