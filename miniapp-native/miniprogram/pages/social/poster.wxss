.wrap {
  max-width: 480px;
  margin: 0 auto;
  padding: var(--sp-12) var(--page-x) calc(var(--sp-40) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster {
  width: 100%;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-3);
}

.poster-skel {
  aspect-ratio: 660 / 900;
  overflow: hidden;
  background: var(--fill);
}

.actions {
  width: 100%;
  margin-top: var(--sp-16);
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
}

.tip {
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-4);
}

.tip-warn {
  color: var(--warn-strong);
}

.hidden-canvas {
  position: absolute;
  left: -9999px;
  top: 0;
  width: 660px;
  height: 900px;
}
