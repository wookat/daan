.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 60rpx;
}

.empty {
  text-align: center;
  color: var(--t3);
  font-size: 25rpx;
  padding: 30rpx 0;
}

.hero {
  background: var(--brand-grad);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-brand);
}

.hero-t {
  display: block;
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
}

.hero-s {
  display: block;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 10rpx;
}

.vs {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 32rpx 20rpx;
}

.p {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
  padding-top: 30rpx;
}

.crown {
  position: absolute;
  top: -6rpx;
  font-size: 34rpx;
}

.av {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand-50);
  color: var(--brand-500);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
}

.av.rival {
  background: var(--warning-bg);
  color: var(--warning);
}

.p.win .av {
  box-shadow: 0 0 0 6rpx #fbbf24;
}

.nm {
  font-size: 24rpx;
  color: var(--t1);
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sc {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--t1);
}

.p.win .sc {
  color: var(--brand-500);
}

.meta {
  font-size: 21rpx;
  color: var(--t3);
}

.mid {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0 12rpx;
}

.mid-vs {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--t4);
}

.mid-res {
  font-size: 21rpx;
  color: var(--t3);
  text-align: center;
  max-width: 140rpx;
}

.cta {
  padding: 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cta-t {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--t1);
}

.cta-s {
  font-size: 23rpx;
  color: var(--t3);
  margin: 10rpx 0 24rpx;
}

.act-btn {
  width: 100%;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.act-btn.main {
  background: var(--brand-500);
  color: #fff;
}

.act-btn.sub {
  background: var(--brand-50);
  color: var(--brand-500);
  margin-top: 16rpx;
}
