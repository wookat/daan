.wrap {
  padding: var(--sp-12) var(--page-x) calc(var(--sp-40) + env(safe-area-inset-bottom));
}

/* 分享者条 */
.from-bar {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  padding: var(--sp-12) var(--card-pad);
  border-radius: var(--r-md);
  background: var(--brand-soft);
  margin-bottom: var(--card-gap);
}

.from-av {
  width: 40px;
  height: 40px;
  border-radius: var(--r-full);
  background: var(--brand);
  color: var(--on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-h3);
  font-weight: 600;
  flex-shrink: 0;
}

.from-l {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.from-t {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--brand-text);
}

.from-s {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}

/* 题卡（只读作答） */
.qcard {
  display: block;
  margin-bottom: var(--card-gap);
}

.q-tags {
  display: flex;
  gap: var(--sp-8);
  margin-bottom: var(--sp-12);
}

.stem {
  display: block;
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--ink);
}

.opts {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
  margin-top: var(--sp-16);
}

.opt {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  min-height: var(--hit-min);
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  padding: var(--sp-8) var(--sp-12);
  background: var(--card);
  box-sizing: border-box;
}

.opt--hover {
  background: var(--fill);
}

.opt.pick {
  border-color: var(--brand);
  background: var(--brand-soft);
}

.opt.right {
  border-color: var(--ok);
  background: var(--ok-soft);
}

.opt.wrong {
  border-color: var(--bad);
  background: var(--bad-soft);
}

.okey {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  border-radius: var(--r-full);
  background: var(--fill);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink-2);
}

.opt.pick .okey {
  background: var(--brand);
  color: var(--on-brand);
}

.opt.right .okey {
  background: var(--ok);
  color: var(--on-brand);
}

.opt.wrong .okey {
  background: var(--bad);
  color: var(--on-brand);
}

.otext {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--ink);
  line-height: 1.6;
}

/* 判分横幅 */
.banner {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  padding: var(--sp-12) var(--card-pad);
  border-radius: var(--r-md);
  margin-bottom: var(--card-gap);
}

.banner.ok {
  background: var(--ok-soft);
}

.banner.bad {
  background: var(--bad-soft);
}

.banner-t {
  flex: 1;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink);
}

.beat-bar {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-8) var(--card-pad);
  border-radius: var(--r-sm);
  background: var(--warn-soft);
  color: var(--warn-strong);
  font-size: var(--fs-sub);
  margin-bottom: var(--card-gap);
}

/* 解析 / 作答列表 */
.exp-h {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: var(--sp-8);
}

.exp {
  display: block;
  font-size: var(--fs-sub);
  line-height: 1.7;
  color: var(--ink-2);
}

.ans-row {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  min-height: var(--hit-min);
}

.ans-row + .ans-row {
  border-top: 1px solid var(--line);
}

.ans-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-sub);
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ans-pick {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

/* 组队 CTA */
.team-cta {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  padding: var(--card-pad);
  border-radius: var(--r-lg);
  background: var(--brand-grad);
  color: var(--on-brand);
  margin-bottom: var(--card-gap);
}

.team-cta.joined {
  background: var(--ok-soft);
  color: var(--ink);
}

.tc-l {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.tc-t-row {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
}

.tc-t {
  font-size: var(--fs-body);
  font-weight: 600;
}

.tc-s {
  font-size: var(--fs-caption);
  margin-top: 2px;
  opacity: 0.85;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
  margin-top: var(--sp-8);
}

@media (min-width: 1024px) {
  .wrap {
    max-width: 760px;
    margin: 0 auto;
  }
}
