.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

/* 复习清零庆祝态 */
.cb-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cb-card {
  background: var(--surface);
  border-radius: var(--r-l);
  padding: 56rpx 44rpx 40rpx;
  margin: 0 60rpx;
  text-align: center;
  max-width: 560rpx;
  animation: cb-pop 0.35s ease-out;
}

.cb-emoji {
  font-size: 88rpx;
  line-height: 1;
  animation: cb-bounce 0.8s ease-out;
}

.cb-t {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--success);
  margin-top: 20rpx;
}

.cb-s {
  font-size: 24rpx;
  color: var(--t2);
  margin-top: 12rpx;
}

.cb-btn {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #5b8af8, var(--brand-500));
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
  border-radius: var(--r-full);
  padding: 20rpx 0;
}

@keyframes cb-pop {
  0% {
    transform: scale(0.7);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes cb-bounce {
  0% {
    transform: translateY(-30rpx);
  }
  50% {
    transform: translateY(8rpx);
  }
  100% {
    transform: translateY(0);
  }
}

.tabs {
  display: flex;
  flex-direction: row;
  margin-bottom: 20rpx;
}

.tab-chip {
  font-size: 26rpx;
  color: var(--t2);
  background: var(--fill);
  border-radius: var(--r-full);
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
}

.tab-chip.on {
  background: var(--brand-50);
  color: var(--brand-500);
  font-weight: 600;
}

.redo {
  margin-bottom: 24rpx;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 48rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  color: var(--t3);
  font-size: 26rpx;
}

.eico {
  width: 144rpx;
  height: 144rpx;
  border-radius: 48rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.m-h {
  display: flex;
  flex-direction: row;
  margin-bottom: 12rpx;
}

.m-h .tag {
  margin-right: 12rpx;
}

.m-q {
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--t1);
}

.m-detail {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--border);
  padding-top: 16rpx;
}

.m-ans {
  display: flex;
  flex-direction: row;
  margin-bottom: 12rpx;
}

.m-k {
  font-size: 24rpx;
  color: var(--t3);
  margin-right: 32rpx;
}

.okc {
  color: var(--success);
  font-weight: 700;
}

.badc {
  color: var(--error);
  font-weight: 700;
}

.m-exp {
  font-size: 25rpx;
  color: var(--t2);
  line-height: 1.7;
}

.m-ops {
  display: flex;
  flex-direction: row;
  margin-top: 16rpx;
}

.m-op {
  font-size: 24rpx;
  color: var(--brand-500);
  background: var(--brand-50);
  border-radius: var(--r-full);
  padding: 10rpx 28rpx;
}

.m-op + .m-op {
  margin-left: 16rpx;
}

.duecard {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #5b8af8, #3b6ff5);
  border-radius: var(--r-m);
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 111, 245, 0.25);
}

.duecard-l {
  display: flex;
  flex-direction: column;
}

.duecard-t {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.duecard-s {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4rpx;
}

.duecard-go {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-500);
  background: #fff;
  border-radius: var(--r-full);
  padding: 12rpx 28rpx;
}

.rhead {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.r-exit {
  font-size: 24rpx;
  color: var(--t3);
}

.r-opts {
  display: flex;
  flex-direction: row;
  margin-top: 20rpx;
}

.r-opt {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
  background: var(--fill);
  border-radius: var(--r-s);
  padding: 20rpx 0;
}

.r-opt + .r-opt {
  margin-left: 16rpx;
}

.r-opts-full {
  flex-direction: column;
}

.r-opt-full {
  text-align: left;
  font-weight: 400;
  font-size: 28rpx;
  padding: 20rpx 24rpx;
}

.r-opts-full .r-opt + .r-opt {
  margin-left: 0;
  margin-top: 14rpx;
}

.r-opt.rok {
  background: var(--success);
  color: #fff;
}

.r-opt.rbad {
  background: var(--error);
  color: #fff;
}

.r-opt.rsel {
  background: var(--brand-500);
  color: #fff;
}

.r-next.r-dis {
  opacity: 0.5;
}

.r-opt.rdim {
  opacity: 0.5;
}

.r-verdict {
  font-size: 25rpx;
  font-weight: 600;
  border-radius: var(--r-s);
  padding: 14rpx 20rpx;
  margin: 20rpx 0 16rpx;
}

.r-verdict.vok {
  background: var(--success-bg, #ecfdf5);
  color: var(--success);
}

.r-verdict.vbad {
  background: var(--error-bg, #fef2f2);
  color: var(--error);
}

.r-next {
  margin-top: 20rpx;
}

.r-sj-t {
  display: block;
  font-size: 25rpx;
  color: var(--t3);
  margin: 24rpx 0 16rpx;
}

.r-sj-row {
  display: flex;
  flex-direction: row;
}

.r-sj {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
  border-radius: var(--r-full);
  padding: 18rpx 0;
}

.r-sj + .r-sj {
  margin-left: 16rpx;
}

.r-sj.rsok {
  color: var(--success);
  border: 1rpx solid var(--success);
}

.r-sj.rsbad {
  color: var(--error);
  border: 1rpx solid var(--error);
}

.appended-tip {
  font-size: 23rpx;
  color: var(--brand-500);
  background: var(--brand-50);
  border-radius: 10rpx;
  padding: 10rpx 16rpx;
  margin-bottom: 12rpx;
}

.reasons {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.rz-t {
  font-size: 23rpx;
  color: var(--t2);
}

.rz {
  font-size: 23rpx;
  color: var(--t2);
  background: var(--fill);
  border-radius: var(--r-full);
  padding: 8rpx 20rpx;
}

.rz.rz-on {
  color: #fff;
  background: var(--brand-500);
}

.recap-h {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.recap-t {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--t1);
}

.recap-x {
  font-size: 23rpx;
  color: var(--brand-500);
}

.recap-sec {
  margin-top: 16rpx;
}

.recap-st {
  font-size: 22rpx;
  color: var(--t2);
}

.recap-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.recap-name {
  flex: 0 0 160rpx;
  font-size: 23rpx;
  color: var(--t1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recap-bar {
  flex: 1;
  height: 14rpx;
  background: var(--fill);
  border-radius: var(--r-full);
  overflow: hidden;
}

.recap-fill {
  height: 100%;
  background: var(--brand-500);
  border-radius: var(--r-full);
}

.recap-fill.warnfill {
  background: #f59e0b;
}

.recap-n {
  flex: 0 0 40rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--t2);
}

.recap-tip {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--t2);
}

/* 筛选按钮 */
.filterbtn {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--t2);
  padding: 8rpx 20rpx;
  border-radius: var(--r-full);
  background: var(--fill);
}

.filterbtn.fon {
  color: var(--brand-500);
  background: var(--brand-50);
}

/* 收藏夹 */
.folders-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.fold-chip {
  font-size: 24rpx;
  color: var(--t2);
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-full);
  padding: 10rpx 22rpx;
}

.fold-chip.on {
  color: var(--brand-500);
  border-color: var(--brand-500);
  background: var(--brand-50);
}

.fold-chip.fold-new {
  color: var(--brand-500);
  border-style: dashed;
}

.fold-tip {
  display: block;
  margin: 12rpx 0 4rpx;
  font-size: 21rpx;
  color: var(--t3);
}

.fav-note {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--t2);
  background: var(--fill);
  border-radius: var(--r-s);
  padding: 12rpx 16rpx;
}

/* 底部操作 sheet（筛选/纠错/笔记共用） */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 998;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--surface);
  border-radius: var(--r-l) var(--r-l) 0 0;
  padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  max-height: 75vh;
  overflow-y: auto;
}

.sheet-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-t {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--t1);
}

.sheet-x {
  font-size: 30rpx;
  color: var(--t3);
  padding: 8rpx;
}

.sheet-st {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--t2);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.chip {
  font-size: 24rpx;
  color: var(--t2);
  background: var(--fill);
  border-radius: var(--r-full);
  padding: 10rpx 24rpx;
}

.chip.on {
  color: #fff;
  background: var(--brand-500);
}

.sheet-ta {
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 25rpx;
  color: var(--t1);
  background: var(--fill);
  border-radius: var(--r-s);
}

.note-ta {
  min-height: 220rpx;
}

.sheet-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.sheet-btn {
  flex: 1;
  margin-top: 0;
  text-align: center;
  background: var(--brand-500);
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
  border-radius: var(--r-full);
  padding: 20rpx 0;
}

.sheet-mask > .sheet > .sheet-btn:last-child {
  margin-top: 28rpx;
}

.sheet-btn.ghost {
  background: var(--fill);
  color: var(--t2);
}

.sheet-btn.ghost.danger {
  color: var(--error);
}

.sheet-btn.dis {
  opacity: 0.5;
}
