.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.tabs {
  display: flex;
  flex-direction: row;
  margin-bottom: 20rpx;
}

.tab-chip {
  font-size: 26rpx;
  color: var(--t2);
  background: var(--fill);
  border-radius: var(--r-full);
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
}

.tab-chip.on {
  background: var(--brand-50);
  color: var(--brand-500);
  font-weight: 600;
}

.redo {
  margin-bottom: 24rpx;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 48rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  color: var(--t3);
  font-size: 26rpx;
}

.eico {
  width: 144rpx;
  height: 144rpx;
  border-radius: 48rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.m-h {
  display: flex;
  flex-direction: row;
  margin-bottom: 12rpx;
}

.m-h .tag {
  margin-right: 12rpx;
}

.m-q {
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--t1);
}

.m-detail {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--border);
  padding-top: 16rpx;
}

.m-ans {
  display: flex;
  flex-direction: row;
  margin-bottom: 12rpx;
}

.m-k {
  font-size: 24rpx;
  color: var(--t3);
  margin-right: 32rpx;
}

.okc {
  color: var(--success);
  font-weight: 700;
}

.badc {
  color: var(--error);
  font-weight: 700;
}

.m-exp {
  font-size: 25rpx;
  color: var(--t2);
  line-height: 1.7;
}

.m-ops {
  display: flex;
  flex-direction: row;
  margin-top: 16rpx;
}

.m-op {
  font-size: 24rpx;
  color: var(--brand-500);
  background: var(--brand-50);
  border-radius: var(--r-full);
  padding: 10rpx 28rpx;
}

.m-op + .m-op {
  margin-left: 16rpx;
}
