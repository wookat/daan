.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.tabs {
  display: flex;
  flex-direction: row;
  margin-bottom: 20rpx;
}

.tab-chip {
  font-size: 26rpx;
  color: var(--t2);
  background: var(--fill);
  border-radius: var(--r-full);
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
}

.tab-chip.on {
  background: var(--brand-50);
  color: var(--brand-500);
  font-weight: 600;
}

.redo {
  margin-bottom: 24rpx;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 48rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  color: var(--t3);
  font-size: 26rpx;
}

.eico {
  width: 144rpx;
  height: 144rpx;
  border-radius: 48rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.m-h {
  display: flex;
  flex-direction: row;
  margin-bottom: 12rpx;
}

.m-h .tag {
  margin-right: 12rpx;
}

.m-q {
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--t1);
}

.m-detail {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--border);
  padding-top: 16rpx;
}

.m-ans {
  display: flex;
  flex-direction: row;
  margin-bottom: 12rpx;
}

.m-k {
  font-size: 24rpx;
  color: var(--t3);
  margin-right: 32rpx;
}

.okc {
  color: var(--success);
  font-weight: 700;
}

.badc {
  color: var(--error);
  font-weight: 700;
}

.m-exp {
  font-size: 25rpx;
  color: var(--t2);
  line-height: 1.7;
}

.m-ops {
  display: flex;
  flex-direction: row;
  margin-top: 16rpx;
}

.m-op {
  font-size: 24rpx;
  color: var(--brand-500);
  background: var(--brand-50);
  border-radius: var(--r-full);
  padding: 10rpx 28rpx;
}

.m-brief {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.m-more {
  font-size: 22rpx;
  color: var(--brand-500);
}

.export-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--brand-500);
  color: var(--brand-500);
  border-radius: 999rpx;
  padding: 20rpx 0;
  font-size: 27rpx;
  font-weight: 500;
  margin: 16rpx 0 40rpx;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 18, 30, 0.5);
  z-index: 90;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  background: var(--surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}

.d-scroll {
  flex: 1;
  max-height: 55vh;
}

.d-q {
  display: block;
  font-size: 28rpx;
  color: var(--t1);
  line-height: 1.7;
  margin: 12rpx 0 16rpx;
}

.d-ansrow {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.d-exp {
  font-size: 24rpx;
  color: var(--t2);
  line-height: 1.7;
  background: var(--fill);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.d-btns {
  display: flex;
  flex-direction: row;
  margin-top: 24rpx;
}

.d-btn {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
  color: #fff;
  background: var(--brand-500);
  border-radius: 999rpx;
  padding: 20rpx 0;
  margin: 0 8rpx;
}

.d-btn.ghost {
  color: var(--t2);
  background: var(--fill);
}
