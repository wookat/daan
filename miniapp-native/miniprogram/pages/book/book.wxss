.wrap {
  padding: var(--sp-12) var(--page-x) calc(80px + env(safe-area-inset-bottom));
}

.review,
.recap,
.mrow {
  display: block;
  margin-bottom: var(--card-gap);
}

/* 复习清零庆祝态（t-popup center） */
.cb-card {
  width: 280px;
  background: var(--card);
  border-radius: var(--r-lg);
  padding: var(--sp-32) var(--sp-24) var(--sp-24);
  text-align: center;
  box-sizing: border-box;
}

.cb-ico {
  width: 64px;
  height: 64px;
  margin: 0 auto;
  border-radius: var(--r-full);
  background: var(--ok-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: cb-bounce 0.8s ease-out;
}

.cb-t {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ok-strong);
  margin-top: var(--sp-12);
}

.cb-s {
  font-size: var(--fs-sub);
  color: var(--ink-2);
  margin-top: var(--sp-8);
  line-height: 1.5;
}

.cb-btn {
  margin-top: var(--sp-20);
}

@keyframes cb-bounce {
  0% {
    transform: translateY(-16px);
  }
  50% {
    transform: translateY(4px);
  }
  100% {
    transform: translateY(0);
  }
}

/* 三态切换 + 筛选 */
.tabs {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  margin-bottom: var(--sp-12);
}

.tabs-seg {
  flex: 1;
  min-width: 0;
}

.filterbtn {
  width: 36px;
  height: 36px;
  border-radius: var(--r-sm);
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.filterbtn.fon {
  background: var(--brand-soft);
}

.filterbtn--hover,
.fold-chip--hover,
.r-exit--hover,
.duecard--hover {
  opacity: 0.75;
}

.redo {
  margin-bottom: var(--card-gap);
}

/* 错题卡 */
.m-h {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-8);
  margin-bottom: var(--sp-8);
}

.m-q {
  display: block;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--ink);
}

.m-q-clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.m-detail {
  margin-top: var(--sp-12);
  border-top: 1px solid var(--line);
  padding-top: var(--sp-12);
}

.m-opts {
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
  margin-bottom: var(--sp-12);
}

.m-opt {
  font-size: var(--fs-sub);
  line-height: 1.6;
  color: var(--ink-2);
}

.m-opt--ok {
  color: var(--ok-strong);
}

.m-opt--bad {
  color: var(--bad-strong);
}

.m-ans {
  display: flex;
  gap: var(--sp-16);
  margin-bottom: var(--sp-8);
}

.m-k {
  font-size: var(--fs-sub);
  color: var(--ink-3);
}

.okc {
  color: var(--ok-strong);
  font-weight: 600;
}

.badc {
  color: var(--bad-strong);
  font-weight: 600;
}

.m-exp {
  display: block;
  white-space: pre-wrap;
  font-size: var(--fs-sub);
  color: var(--ink-2);
  line-height: 1.7;
}

.m-ops {
  display: flex;
  gap: var(--sp-8);
  margin-top: var(--sp-12);
}

/* 今日待复习 hero 条 */
.duecard {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-12);
  background: var(--brand-grad);
  border-radius: var(--r-lg);
  padding: var(--card-pad);
  margin-bottom: var(--card-gap);
  box-shadow: var(--sh-2);
  position: relative;
  overflow: hidden;
}

.duecard-deco {
  position: absolute;
  right: -26px;
  top: -40px;
  width: 130px;
  height: 130px;
  border-radius: var(--r-full);
  background: var(--on-brand);
  opacity: 0.1;
}

.duecard-l {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

.duecard-t {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--on-brand);
}

.duecard-s {
  font-size: var(--fs-caption);
  color: var(--on-brand-2);
  margin-top: 2px;
}

/* 复习模式 */
.rhead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-12);
}

.r-exit {
  display: inline-flex;
  align-items: center;
  min-height: var(--hit-min);
  padding: 0 var(--sp-4);
  font-size: var(--fs-sub);
  color: var(--ink-3);
}

.r-opts {
  display: flex;
  gap: var(--sp-8);
  margin-top: var(--sp-12);
}

.r-opt {
  flex: 1;
  min-height: var(--hit-min);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-8);
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
  background: var(--fill);
  border: 1px solid transparent;
  border-radius: var(--r-sm);
  padding: var(--sp-8) var(--sp-12);
  box-sizing: border-box;
}

.r-opt--hover {
  border-color: var(--brand);
}

.r-opts-full {
  flex-direction: column;
}

.r-opt-full {
  justify-content: flex-start;
  font-weight: 400;
}

.r-opt-full .r-opt-k {
  width: 24px;
  height: 24px;
  border-radius: var(--r-full);
  background: var(--card);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sub);
  font-weight: 600;
  flex-shrink: 0;
}

.r-opt-t {
  flex: 1;
  min-width: 0;
  line-height: 1.5;
}

.r-opt.rok {
  background: var(--ok-soft);
  border-color: var(--ok);
  color: var(--ok-strong);
}

.r-opt.rbad {
  background: var(--bad-soft);
  border-color: var(--bad);
  color: var(--bad-strong);
}

.r-opt.rsel {
  background: var(--brand-soft);
  border-color: var(--brand);
  color: var(--brand-text);
}

.r-opt.rdim {
  opacity: 0.5;
}

.r-verdict {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  font-size: var(--fs-sub);
  font-weight: 600;
  border-radius: var(--r-sm);
  padding: var(--sp-8) var(--sp-12);
  margin: var(--sp-12) 0;
}

.r-verdict.vok {
  background: var(--ok-soft);
  color: var(--ok-strong);
}

.r-verdict.vbad {
  background: var(--bad-soft);
  color: var(--bad-strong);
}

.r-next {
  margin-top: var(--sp-12);
}

.r-sj-t {
  display: block;
  font-size: var(--fs-sub);
  color: var(--ink-3);
  margin: var(--sp-16) 0 var(--sp-8);
}

.r-sj-row {
  display: flex;
  gap: var(--sp-8);
}

.r-sj {
  flex: 1;
  height: var(--btn-h-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-4);
  font-size: var(--fs-body);
  font-weight: 600;
  border-radius: var(--r-full);
  border: 1px solid;
  box-sizing: border-box;
}

.r-sj--hover {
  opacity: 0.7;
}

.r-sj.rsok {
  color: var(--ok-strong);
  border-color: var(--ok);
  background: var(--ok-soft);
}

.r-sj.rsbad {
  color: var(--bad-strong);
  border-color: var(--bad);
  background: var(--bad-soft);
}

.appended-tip {
  font-size: var(--fs-caption);
  color: var(--brand-text);
  background: var(--brand-soft);
  border-radius: var(--r-xs);
  padding: var(--sp-4) var(--sp-8);
  margin-bottom: var(--sp-8);
}

.reasons {
  margin-bottom: var(--sp-8);
}

.rz-t {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-2);
  margin-bottom: var(--sp-4);
}

.reasons-row {
  margin: 0 calc(-1 * var(--card-pad));
}

/* 本月复盘 */
.recap-h {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 28px;
}

.recap-t {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.recap-x {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  font-size: var(--fs-caption);
  color: var(--brand-text);
}

.recap-sec {
  margin-top: var(--sp-12);
}

.recap-st {
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

.recap-row {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  margin-top: var(--sp-8);
}

.recap-name {
  flex: 0 0 80px;
  font-size: var(--fs-caption);
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recap-bar {
  flex: 1;
  height: 4px;
  background: var(--prog-track);
  border-radius: var(--r-full);
  overflow: hidden;
}

.recap-fill {
  height: 100%;
  background: var(--brand);
  border-radius: var(--r-full);
}

.recap-fill.warnfill {
  background: var(--warn);
}

.recap-n {
  flex: 0 0 24px;
  text-align: right;
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

.recap-tip {
  display: block;
  margin-top: var(--sp-8);
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

/* 收藏夹 */
.folders-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-8);
}

.fold-chip {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-4);
  height: var(--chip-h);
  padding: 0 var(--sp-12);
  font-size: var(--fs-sub);
  color: var(--ink-2);
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--r-full);
  box-sizing: border-box;
}

.fold-n {
  color: var(--ink-3);
  font-size: var(--fs-caption);
}

.fold-chip.on {
  color: var(--brand-text);
  border-color: var(--brand);
  background: var(--brand-soft);
}

.fold-chip.on .fold-n {
  color: var(--brand-text);
}

.fold-chip.fold-new {
  color: var(--brand-text);
  border-style: dashed;
}

.fold-tip {
  display: block;
  margin: var(--sp-8) 0 var(--sp-12);
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.fav-note {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-4);
  margin-top: var(--sp-8);
  font-size: var(--fs-caption);
  color: var(--ink-2);
  background: var(--fill);
  border-radius: var(--r-sm);
  padding: var(--sp-8) var(--sp-12);
}

.fav-note-t {
  flex: 1;
  min-width: 0;
  line-height: 1.5;
}

/* 底部 sheet（t-popup 内容区，筛选/纠错/笔记/更多共用） */
.sheet {
  background: var(--card);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: var(--sp-8) var(--page-x) calc(var(--sp-16) + env(safe-area-inset-bottom));
  max-height: 80vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.sheet-handle {
  width: 36px;
  height: 4px;
  border-radius: var(--r-full);
  background: var(--line-strong);
  margin: 0 auto var(--sp-8);
}

.sheet-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--hit-min);
}

.sheet-t {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.sheet-x {
  width: var(--hit-min);
  height: var(--hit-min);
  margin-right: calc(-1 * var(--sp-8));
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
}

.sheet-x--hover {
  background: var(--fill);
}

.sheet-st {
  display: block;
  margin-top: var(--sp-16);
  font-size: var(--fs-sub);
  color: var(--ink-2);
}

.sheet-chips {
  margin: var(--sp-8) calc(-1 * var(--page-x)) 0;
}

.sheet-ta {
  margin-top: var(--sp-12);
  background: var(--fill);
  border-radius: var(--r-sm);
  overflow: hidden;
}

.sheet-row {
  display: flex;
  gap: var(--sp-12);
  margin-top: var(--sp-16);
}

.sheet-row-grow {
  flex: 1;
  min-width: 0;
}

.sheet-acts {
  margin-top: var(--sp-16);
}
