<navbar title="错题本" />
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="wrap">
    <!-- 复习模式（kg-question-card / kg-option-group 小程序版未落地，页内按 T3 结构实现） -->
    <block wx:if="{{reviewing && rCur}}">
      <kg-card variant="raised" class="review">
        <view class="rhead">
          <kg-tag tone="brand">{{rCur.extra ? '加练同类' : '复习'}} {{rIdx + 1}}/{{rItems.length}}</kg-tag>
          <view class="r-exit" hover-class="r-exit--hover" bind:tap="exitReview">退出复习</view>
        </view>
        <text class="m-q q-text" user-select>{{rCur.question_text}}</text>
        <view wx:if="{{rLetter}}" class="r-opts {{rOpts[0].text ? 'r-opts-full' : ''}}">
          <view
            wx:for="{{rOpts}}"
            wx:key="k"
            class="r-opt {{rOpts[0].text ? 'r-opt-full' : ''}} {{!answered ? (rMulti && picked.indexOf(item.k) > -1 ? 'rsel' : '') : rLetter.indexOf(item.k) > -1 ? 'rok' : picked.indexOf(item.k) > -1 ? 'rbad' : 'rdim'}}"
            hover-class="{{answered ? 'none' : 'r-opt--hover'}}"
            data-opt="{{item.k}}"
            bind:tap="onReviewPick"
          >
            <text class="r-opt-k">{{item.k}}</text>
            <text wx:if="{{item.text}}" class="r-opt-t q-text">{{item.text}}</text>
          </view>
        </view>
        <block wx:if="{{answered}}">
          <view class="r-verdict {{wasCorrect ? 'vok' : 'vbad'}}">
            <l-icon name="{{wasCorrect ? 'circle-check' : 'circle-x'}}" size="16" tone="{{wasCorrect ? 'ok' : 'bad'}}" />
            <text wx:if="{{rCur.extra}}">{{wasCorrect ? '答对了，这个考法稳了' : '还没稳，仔细看解析'}}</text>
            <text wx:else>{{wasCorrect ? (rCur.requeued ? '这次答对了，本轮已纠正' : '答对了！连对 ' + rStreak + ' 次') : '又错了，看解析（稍后本轮会再出现）'}}（下次复习：{{nextDays}} 天后）</text>
          </view>
          <view wx:if="{{!wasCorrect && rCur.appended}}" class="appended-tip">已为你在本轮末尾加练 {{rCur.appended}} 道同类题</view>
          <view wx:if="{{!wasCorrect && !rCur.extra}}" class="reasons">
            <text class="rz-t">错因自评</text>
            <view class="reasons-row"><kg-chip-row size="sm" options="{{reasonOpts}}" value="{{rCur.error_reason || ''}}" bind:change="onReviewReason" /></view>
          </view>
          <text wx:if="{{rCur.explanation}}" class="m-exp q-text" user-select>{{rCur.explanation}}</text>
          <view class="r-next"><kg-button variant="primary" size="lg" block bind:click="onNextReview">{{rIdx + 1 < rItems.length ? '下一题' : '完成复习'}}</kg-button></view>
        </block>
        <block wx:elif="{{rMulti}}">
          <text class="r-sj-t">多选题：选完所有选项后确认</text>
          <kg-button variant="primary" size="lg" block disabled="{{!picked}}" bind:click="onConfirmMulti">确认答案{{picked ? '（已选 ' + picked + '）' : ''}}</kg-button>
        </block>
        <block wx:elif="{{!rLetter}}">
          <text class="r-sj-t">先自己做，然后：</text>
          <view class="r-sj-row">
            <view class="r-sj rsok" hover-class="r-sj--hover" data-ok="1" bind:tap="onSelfJudge"><l-icon name="circle-check" size="20" tone="ok" /><text>我做对了</text></view>
            <view class="r-sj rsbad" hover-class="r-sj--hover" data-ok="0" bind:tap="onSelfJudge"><l-icon name="circle-x" size="20" tone="bad" /><text>我做错了</text></view>
          </view>
        </block>
      </kg-card>
    </block>

    <block wx:if="{{!reviewing}}">
    <!-- 今日待复习 hero 条 -->
    <view wx:if="{{dueTotal > 0}}" class="duecard" hover-class="duecard--hover" bind:tap="onReviewFromCard">
      <view class="duecard-deco" />
      <view class="duecard-l">
        <text class="duecard-t">今日待复习 {{dueTotal}} 道</text>
        <text class="duecard-s">按遗忘曲线安排 · 趁热打铁巩固一遍</text>
      </view>
      <kg-button variant="primary" tone="inverse" size="md">开始复习</kg-button>
    </view>

    <!-- 本月复盘 -->
    <kg-card wx:if="{{recap.total}}" variant="raised" class="recap">
      <view class="recap-h" hover-class="r-exit--hover" bind:tap="onToggleRecap">
        <text class="recap-t">本月错题复盘 · 新增 {{recap.total}} 道</text>
        <view class="recap-x"><text>{{recapOpen ? '收起' : '展开'}}</text><l-icon name="{{recapOpen ? 'chevron-down' : 'chevron-right'}}" size="16" tone="brand-text" /></view>
      </view>
      <block wx:if="{{recapOpen}}">
        <view class="recap-sec">
          <text class="recap-st">按模块</text>
          <view wx:for="{{recap.byModule}}" wx:key="name" class="recap-row">
            <text class="recap-name">{{item.name}}</text>
            <view class="recap-bar"><view class="recap-fill" style="width: {{item.pct}}%" /></view>
            <text class="recap-n num">{{item.n}}</text>
          </view>
        </view>
        <view class="recap-sec">
          <text class="recap-st">按错因</text>
          <view wx:for="{{recap.byReason}}" wx:key="name" class="recap-row">
            <text class="recap-name">{{item.name}}</text>
            <view class="recap-bar"><view class="recap-fill warnfill" style="width: {{item.pct}}%" /></view>
            <text class="recap-n num">{{item.n}}</text>
          </view>
        </view>
        <text class="recap-tip">高频错因是提分洼地：优先复习对应模块的待掌握错题</text>
      </block>
    </kg-card>

    <!-- 三态切换（kg-stat-row 小程序版未落地，用 kg-segmented 承载计数） -->
    <view class="tabs">
      <view class="tabs-seg"><kg-segmented options="{{tabOpts}}" value="{{tab}}" bind:change="onTab" /></view>
      <view wx:if="{{tab !== 'fav'}}" class="filterbtn {{sortBy !== 'time' || filterMod || filterType ? 'fon' : ''}}" hover-class="filterbtn--hover" bind:tap="onFilterOpen">
        <l-icon name="sliders-horizontal" size="20" tone="{{sortBy !== 'time' || filterMod || filterType ? 'brand-text' : 'ink-2'}}" />
      </view>
    </view>

    <view wx:if="{{tab !== 'fav'}}" class="redo"><kg-button variant="primary" size="lg" block icon="shuffle" bind:click="onRedo">错题重练（抽 10 题）</kg-button></view>

    <!-- 加载态 -->
    <block wx:if="{{loading}}">
      <kg-card wx:for="{{[1, 2, 3]}}" wx:key="*this" variant="raised" class="mrow">
        <t-skeleton theme="paragraph" animation="gradient" />
      </kg-card>
    </block>

    <!-- 错题列表 -->
    <block wx:if="{{!loading && tab !== 'fav'}}">
      <kg-empty
        wx:if="{{!shown.length}}"
        icon="{{tab === 'todo' ? 'party-popper' : 'inbox'}}"
        title="{{tab === 'todo' ? '暂无待掌握错题' : '还没有已掌握的错题'}}"
        desc="{{tab === 'todo' ? (filterMod || filterType ? '换个筛选条件试试' : '继续刷题，答错的题会自动进入这里') : '在待掌握列表里点「标记已掌握」即可归档'}}"
        ctaText="{{tab === 'todo' && !filterMod && !filterType ? '去刷题' : ''}}"
        ctaTo="/pages/practice/practice"
      />
      <kg-card wx:for="{{shown}}" wx:key="id" variant="raised" clickable class="mrow" data-index="{{index}}" bind:click="onToggle">
        <view class="m-h">
          <kg-tag tone="module" module="{{item.module}}">{{item.modName}}</kg-tag>
          <kg-tag wx:if="{{item.tag3_name}}" tone="neutral">{{item.tag3_name}}</kg-tag>
          <kg-tag wx:if="{{item.error_reason}}" tone="warn">{{item.error_reason}}</kg-tag>
          <kg-tag wx:if="{{item.times > 1}}" tone="bad">错 {{item.times}} 次</kg-tag>
        </view>
        <text class="m-q q-text {{item.open ? '' : 'm-q-clamp'}}">{{item.question_text}}</text>
        <view wx:if="{{item.open}}" class="m-detail">
          <view class="m-ans">
            <text class="m-k">我的答案 <text class="badc">{{item.user_answer}}</text></text>
            <text class="m-k">正确答案 <text class="okc">{{item.correct_answer}}</text></text>
          </view>
          <text wx:if="{{item.explanation}}" class="m-exp q-text" user-select>{{item.explanation}}</text>
          <view class="m-ops" catch:tap="noop">
            <kg-button variant="secondary" size="sm" icon="{{item.mastered ? 'rotate-ccw' : 'check'}}" data-index="{{index}}" bind:click="onMaster">{{item.mastered ? '移回待掌握' : '标记已掌握'}}</kg-button>
            <kg-button wx:if="{{item.question_id}}" variant="ghost" size="sm" icon="ellipsis" data-kind="mistake" data-index="{{index}}" data-qid="{{item.question_id}}" bind:click="onOpsOpen">更多</kg-button>
          </view>
        </view>
      </kg-card>
    </block>

    <!-- 收藏 -->
    <block wx:if="{{!loading && tab === 'fav'}}">
      <view class="folders-row">
        <view class="fold-chip {{folderId === null ? 'on' : ''}}" hover-class="fold-chip--hover" data-fid="all" bind:tap="onPickFolder">全部</view>
        <view
          wx:for="{{folders}}"
          wx:key="id"
          class="fold-chip {{folderId === item.id ? 'on' : ''}}"
          hover-class="fold-chip--hover"
          data-fid="{{item.id}}"
          data-name="{{item.name}}"
          bind:tap="onPickFolder"
          bind:longpress="onFolderOps"
        >{{item.icon}} {{item.name}} <text class="fold-n num">{{item.n}}</text></view>
        <view class="fold-chip fold-new" hover-class="fold-chip--hover" bind:tap="onNewFolder"><l-icon name="plus" size="16" tone="brand-text" /><text>新建收藏夹</text></view>
      </view>
      <text class="fold-tip">长按自建收藏夹可重命名 / 删除</text>
      <kg-empty wx:if="{{!favs.length}}" icon="star" title="暂无收藏题目" desc="刷题时点「收藏」，好题就会收进这里" ctaText="去刷题" ctaTo="/pages/practice/practice" />
      <kg-card wx:for="{{favs}}" wx:key="id" variant="raised" class="mrow">
        <text class="m-q q-text">{{item.question || '题目 #' + item.id}}</text>
        <view wx:if="{{item.note}}" class="fav-note"><l-icon name="pen-line" size="16" tone="muted" /><text class="fav-note-t q-text">{{item.note}}</text></view>
        <view class="m-ops" catch:tap="noop">
          <kg-button variant="secondary" size="sm" icon="dumbbell" data-module="{{item.module}}" bind:click="onFavPractice">去练同模块</kg-button>
          <kg-button variant="ghost" size="sm" icon="ellipsis" data-kind="fav" data-index="{{index}}" data-qid="{{item.id}}" data-note="{{item.note ? 1 : 0}}" bind:click="onOpsOpen">更多</kg-button>
        </view>
      </kg-card>
    </block>
    </block>
  </view>
</scroll-view>

<!-- 复习清零庆祝态 -->
<t-popup visible="{{celebrate}}" placement="center" bind:visible-change="onCelebrateVisible">
  <view class="cb-card">
    <view class="cb-ico"><l-icon name="party-popper" size="32" tone="ok" /></view>
    <view class="cb-t">今日复习已清零！</view>
    <view class="cb-s">{{celebrateN}} 道到期错题全部复习完成，遗忘曲线稳住了</view>
    <view class="cb-btn"><kg-button variant="primary" size="lg" block bind:click="onCloseCelebrate">太棒了，继续</kg-button></view>
  </view>
</t-popup>

<!-- 错题卡「更多」分组菜单 -->
<t-popup visible="{{opsOpen}}" placement="bottom" bind:visible-change="onOpsVisible">
  <view class="sheet">
    <view class="sheet-handle" />
    <view class="sheet-h">
      <text class="sheet-t">更多操作</text>
      <view class="sheet-x" hover-class="sheet-x--hover" bind:tap="onOpsClose"><l-icon name="x" size="24" tone="muted" /></view>
    </view>
    <block wx:if="{{opsKind === 'mistake'}}">
      <t-cell-group title="学习" bordered>
        <t-cell title="笔记" description="记方法、记陷阱，随解析展示" hover arrow data-act="note" data-qid="{{opsQid}}" bind:click="onOpsPick"><l-icon slot="left-icon" name="pen-line" size="20" tone="brand" /></t-cell>
        <t-cell title="分享给队友" description="生成链接，答完可看大家选了啥" hover arrow data-act="share" data-index="{{opsIdx}}" bind:click="onOpsPick"><l-icon slot="left-icon" name="share-2" size="20" tone="brand" /></t-cell>
      </t-cell-group>
      <t-cell-group title="反馈" bordered>
        <t-cell title="题目纠错" description="答案 / 解析 / 错字 / 图片缺失" hover arrow data-act="report" data-index="{{opsIdx}}" bind:click="onOpsPick"><l-icon slot="left-icon" name="flag" size="20" tone="warn" /></t-cell>
      </t-cell-group>
    </block>
    <block wx:else>
      <t-cell-group title="学习" bordered>
        <t-cell title="{{opsHasNote ? '改笔记' : '写笔记'}}" hover arrow data-act="note" data-qid="{{opsQid}}" bind:click="onOpsPick"><l-icon slot="left-icon" name="pen-line" size="20" tone="brand" /></t-cell>
      </t-cell-group>
      <t-cell-group title="管理" bordered>
        <t-cell title="取消收藏" hover data-act="unfav" data-qid="{{opsQid}}" bind:click="onOpsPick"><l-icon slot="left-icon" name="trash-2" size="20" tone="bad" /></t-cell>
      </t-cell-group>
    </block>
  </view>
</t-popup>

<!-- 筛选与排序 -->
<t-popup visible="{{filterOpen}}" placement="bottom" bind:visible-change="onFilterVisible">
  <view class="sheet">
    <view class="sheet-handle" />
    <view class="sheet-h">
      <text class="sheet-t">筛选与排序</text>
      <view class="sheet-x" hover-class="sheet-x--hover" bind:tap="onFilterClose"><l-icon name="x" size="24" tone="muted" /></view>
    </view>
    <text class="sheet-st">排序</text>
    <view class="sheet-chips"><kg-chip-row options="{{sortOpts}}" value="{{sortBy}}" bind:change="onPickSort" /></view>
    <block wx:if="{{modOpts.length > 1}}">
      <text class="sheet-st">模块</text>
      <view class="sheet-chips"><kg-chip-row options="{{modOpts}}" value="{{filterMod}}" bind:change="onPickMod" /></view>
    </block>
    <block wx:if="{{typeOpts.length > 1}}">
      <text class="sheet-st">题型</text>
      <view class="sheet-chips"><kg-chip-row options="{{typeOpts}}" value="{{filterType}}" bind:change="onPickType" /></view>
    </block>
    <view class="sheet-row">
      <kg-button variant="ghost" size="lg" bind:click="onFilterReset">重置</kg-button>
      <view class="sheet-row-grow"><kg-button variant="primary" size="lg" block bind:click="onFilterClose">完成（{{shown.length}} 题）</kg-button></view>
    </view>
  </view>
</t-popup>

<!-- 题目纠错 -->
<t-popup visible="{{reportOpen}}" placement="bottom" bind:visible-change="onReportVisible">
  <view class="sheet">
    <view class="sheet-handle" />
    <view class="sheet-h">
      <text class="sheet-t">题目纠错</text>
      <view class="sheet-x" hover-class="sheet-x--hover" bind:tap="onReportClose"><l-icon name="x" size="24" tone="muted" /></view>
    </view>
    <text class="sheet-st">问题类型</text>
    <view class="sheet-chips"><kg-chip-row options="{{reportTypeOpts}}" value="{{reportType}}" bind:change="onPickReportType" /></view>
    <view class="sheet-ta">
      <t-textarea value="{{reportDetail}}" placeholder="补充说明（选填，500 字以内）" maxlength="{{500}}" indicator autosize="{{taSize}}" bordered="{{false}}" bind:change="onReportDetail" />
    </view>
    <view class="sheet-acts"><kg-button variant="primary" size="lg" block disabled="{{!reportType}}" loading="{{reportBusy}}" bind:click="onReportSubmit">提交纠错</kg-button></view>
  </view>
</t-popup>

<!-- 题目笔记 -->
<t-popup visible="{{noteOpen}}" placement="bottom" bind:visible-change="onNoteVisible">
  <view class="sheet">
    <view class="sheet-handle" />
    <view class="sheet-h">
      <text class="sheet-t">我的笔记</text>
      <view class="sheet-x" hover-class="sheet-x--hover" bind:tap="onNoteClose"><l-icon name="x" size="24" tone="muted" /></view>
    </view>
    <view class="sheet-ta note-ta">
      <t-textarea value="{{noteDraft}}" placeholder="记下这题的方法 / 陷阱，下次遇到随解析展示" maxlength="{{1000}}" indicator autosize="{{noteTaSize}}" bordered="{{false}}" bind:change="onNoteInput" />
    </view>
    <view class="sheet-row">
      <kg-button wx:if="{{noteHas}}" variant="ghost" tone="bad" size="lg" icon="trash-2" data-clear="1" bind:click="onNoteSave">删除笔记</kg-button>
      <view class="sheet-row-grow"><kg-button variant="primary" size="lg" block loading="{{noteBusy}}" bind:click="onNoteSave">保存</kg-button></view>
    </view>
  </view>
</t-popup>
