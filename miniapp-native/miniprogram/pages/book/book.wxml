<navbar title="错题本" />
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="wrap">
    <view class="tabs">
      <text class="tab-chip {{tab === 'todo' ? 'on' : ''}}" data-tab="todo" bind:tap="onTab">待掌握 {{todoCount}}</text>
      <text class="tab-chip {{tab === 'done' ? 'on' : ''}}" data-tab="done" bind:tap="onTab">已掌握 {{doneCount}}</text>
      <text class="tab-chip {{tab === 'fav' ? 'on' : ''}}" data-tab="fav" bind:tap="onTab">收藏 {{favs.length}}</text>
    </view>

    <view wx:if="{{tab !== 'fav'}}" class="btn-primary redo" bind:tap="onRedo">错题重练（抽 10 题）</view>

    <view wx:if="{{loading}}" class="card spin">加载中…</view>

    <block wx:if="{{!loading && tab !== 'fav'}}">
      <view wx:if="{{!shown.length}}" class="empty">
        <view class="eico">🎉</view>
        <text>{{tab === 'todo' ? '暂无待掌握错题，继续刷题吧' : '还没有已掌握的错题'}}</text>
      </view>
      <view wx:for="{{shown}}" wx:key="id" class="card mrow" data-index="{{index}}" bind:tap="onDetail">
        <view class="m-h">
          <text class="tag tag-brand">{{item.modName}}</text>
          <text wx:if="{{item.tag3_name}}" class="tag tag-gray">{{item.tag3_name}}</text>
        </view>
        <text class="m-q">{{item.question_text}}</text>
        <view class="m-brief">
          <text class="m-k">我的 <text class="badc">{{item.user_answer}}</text> · 正确 <text class="okc">{{item.correct_answer}}</text></text>
          <text class="m-more">详情 ›</text>
        </view>
      </view>

      <view wx:if="{{shown.length}}" class="export-btn" bind:tap="onExportOpen">{{exporting ? '正在生成 PDF…' : '导出当前列表为错题卷 PDF'}}</view>
    </block>

    <block wx:if="{{!loading && tab === 'fav'}}">
      <view wx:if="{{!favs.length}}" class="empty">
        <view class="eico">⭐</view>
        <text>暂无收藏题目</text>
      </view>
      <view wx:for="{{favs}}" wx:key="question_id" class="card">
        <text class="m-q">{{item.question || '题目 #' + item.question_id}}</text>
      </view>
    </block>
  </view>
</scroll-view>

<!-- 错题详情弹层 -->
<view wx:if="{{detail}}" class="mask" bind:tap="onCloseDetail">
  <view class="sheet" catch:tap="noop">
    <scroll-view scroll-y class="d-scroll" type="list">
      <view class="m-h">
        <text class="tag tag-brand">{{detail.modName}}</text>
        <text wx:if="{{detail.tag3_name}}" class="tag tag-gray">{{detail.tag3_name}}</text>
      </view>
      <text class="d-q" user-select>{{detail.question_text}}</text>
      <view class="d-ansrow">
        <text class="m-k">我的答案 <text class="badc">{{detail.user_answer}}</text></text>
        <text class="m-k">正确答案 <text class="okc">{{detail.correct_answer}}</text></text>
      </view>
      <view wx:if="{{detail.explanation}}" class="d-exp" user-select>{{detail.explanation}}</view>
    </scroll-view>
    <view class="d-btns">
      <view class="d-btn" bind:tap="onReinforce">同考点强化 5 题</view>
      <view class="d-btn ghost" bind:tap="onDetailMaster">{{detail.mastered ? '移回待掌握' : '标为已掌握'}}</view>
    </view>
  </view>
</view>

<export-confirm
  visible="{{exportVisible}}"
  scope="当前列表错题"
  count="{{shown.length > 100 ? 100 : shown.length}}"
  busy="{{exporting}}"
  bind:close="onExportClose"
  bind:confirm="onExportConfirm"
/>
