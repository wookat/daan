<navbar title="错题本" />
<!-- 复习清零庆祝态 -->
<view wx:if="{{celebrate}}" class="cb-mask" bind:tap="onCloseCelebrate">
  <view class="cb-card" catch:tap="noop">
    <view class="cb-emoji">🎉</view>
    <view class="cb-t">今日复习已清零！</view>
    <view class="cb-s">{{celebrateN}} 道到期错题全部复习完成，遗忘曲线稳住了</view>
    <view class="cb-btn" bind:tap="onCloseCelebrate">太棒了，继续 ›</view>
  </view>
</view>
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="wrap">
    <!-- 复习模式 -->
    <block wx:if="{{reviewing && rCur}}">
      <view class="card review">
        <view class="rhead">
          <text class="tag tag-brand">{{rCur.extra ? '加练同类' : '复习'}} {{rIdx + 1}}/{{rItems.length}}</text>
          <text class="r-exit" bind:tap="exitReview">退出复习</text>
        </view>
        <text class="m-q" user-select>{{rCur.question_text}}</text>
        <view wx:if="{{rLetter}}" class="r-opts {{rOpts[0].text ? 'r-opts-full' : ''}}">
          <view
            wx:for="{{rOpts}}"
            wx:key="k"
            class="r-opt {{rOpts[0].text ? 'r-opt-full' : ''}} {{!answered ? (rMulti && picked.indexOf(item.k) > -1 ? 'rsel' : '') : rLetter.indexOf(item.k) > -1 ? 'rok' : picked.indexOf(item.k) > -1 ? 'rbad' : 'rdim'}}"
            data-opt="{{item.k}}"
            bind:tap="onReviewPick"
          >{{item.k}}{{item.text ? '. ' + item.text : ''}}</view>
        </view>
        <block wx:if="{{answered}}">
          <view class="r-verdict {{wasCorrect ? 'vok' : 'vbad'}}">
            <block wx:if="{{rCur.extra}}">{{wasCorrect ? '答对了，这个考法稳了 ✓' : '还没稳，仔细看解析'}}</block>
            <block wx:else>{{wasCorrect ? (rCur.requeued ? '这次答对了，本轮已纠正 ✓' : '答对了！连对 ' + rStreak + ' 次') : '又错了，看解析（稍后本轮会再出现）'}}（下次复习：{{nextDays}} 天后）</block>
          </view>
          <view wx:if="{{!wasCorrect && rCur.appended}}" class="appended-tip">已为你在本轮末尾加练 {{rCur.appended}} 道同类题</view>
          <view wx:if="{{!wasCorrect && !rCur.extra}}" class="reasons">
            <text class="rz-t">错因自评：</text>
            <text
              wx:for="{{REASONS}}"
              wx:key="*this"
              class="rz {{rCur.error_reason === item ? 'rz-on' : ''}}"
              data-rz="{{item}}"
              bind:tap="onReviewReason"
            >{{item}}</text>
          </view>
          <text wx:if="{{rCur.explanation}}" class="m-exp" user-select>{{rCur.explanation}}</text>
          <view class="btn-primary r-next" bind:tap="onNextReview">{{rIdx + 1 < rItems.length ? '下一题' : '完成复习'}}</view>
        </block>
        <block wx:elif="{{rMulti}}">
          <text class="r-sj-t">多选题：选完所有选项后确认</text>
          <view class="btn-primary r-next {{picked ? '' : 'r-dis'}}" bind:tap="onConfirmMulti">确认答案{{picked ? '（已选 ' + picked + '）' : ''}}</view>
        </block>
        <block wx:elif="{{!rLetter}}">
          <text class="r-sj-t">先自己做，然后：</text>
          <view class="r-sj-row">
            <view class="r-sj rsok" data-ok="1" bind:tap="onSelfJudge">我做对了</view>
            <view class="r-sj rsbad" data-ok="0" bind:tap="onSelfJudge">我做错了</view>
          </view>
        </block>
      </view>
    </block>

    <block wx:if="{{!reviewing}}">
    <view wx:if="{{dueTotal > 0}}" class="duecard" bind:tap="onReviewFromCard">
      <view class="duecard-l">
        <text class="duecard-t">今日待复习 {{dueTotal}} 道</text>
        <text class="duecard-s">按遗忘曲线安排 · 趁热打铁巩固一遍</text>
      </view>
      <text class="duecard-go">开始复习</text>
    </view>
    <view wx:if="{{recap.total}}" class="card recap">
      <view class="recap-h" bind:tap="onToggleRecap">
        <text class="recap-t">本月错题复盘 · 新增 {{recap.total}} 道</text>
        <text class="recap-x">{{recapOpen ? '收起' : '展开'}}</text>
      </view>
      <block wx:if="{{recapOpen}}">
        <view class="recap-sec">
          <text class="recap-st">按模块</text>
          <view wx:for="{{recap.byModule}}" wx:key="name" class="recap-row">
            <text class="recap-name">{{item.name}}</text>
            <view class="recap-bar"><view class="recap-fill" style="width: {{item.pct}}%" /></view>
            <text class="recap-n">{{item.n}}</text>
          </view>
        </view>
        <view class="recap-sec">
          <text class="recap-st">按错因</text>
          <view wx:for="{{recap.byReason}}" wx:key="name" class="recap-row">
            <text class="recap-name">{{item.name}}</text>
            <view class="recap-bar"><view class="recap-fill warnfill" style="width: {{item.pct}}%" /></view>
            <text class="recap-n">{{item.n}}</text>
          </view>
        </view>
        <text class="recap-tip">高频错因是提分洼地：优先复习对应模块的待掌握错题</text>
      </block>
    </view>
    <view class="tabs">
      <text class="tab-chip {{tab === 'todo' ? 'on' : ''}}" data-tab="todo" bind:tap="onTab">待掌握 {{todoCount}}</text>
      <text class="tab-chip {{tab === 'done' ? 'on' : ''}}" data-tab="done" bind:tap="onTab">已掌握 {{doneCount}}</text>
      <text class="tab-chip {{tab === 'fav' ? 'on' : ''}}" data-tab="fav" bind:tap="onTab">收藏 {{favs.length}}</text>
    </view>

    <view wx:if="{{tab !== 'fav'}}" class="btn-primary redo" bind:tap="onRedo">错题重练（抽 10 题）</view>

    <view wx:if="{{loading}}" class="card spin">加载中…</view>

    <block wx:if="{{!loading && tab !== 'fav'}}">
      <view wx:if="{{!shown.length}}" class="empty">
        <view class="eico">🎉</view>
        <text>{{tab === 'todo' ? '暂无待掌握错题，继续刷题吧' : '还没有已掌握的错题'}}</text>
      </view>
      <view wx:for="{{shown}}" wx:key="id" class="card mrow" data-index="{{index}}" bind:tap="onToggle">
        <view class="m-h">
          <text class="tag tag-brand">{{item.modName}}</text>
          <text wx:if="{{item.tag3_name}}" class="tag tag-gray">{{item.tag3_name}}</text>
        </view>
        <text class="m-q">{{item.question_text}}</text>
        <view wx:if="{{item.open}}" class="m-detail">
          <view class="m-ans">
            <text class="m-k">我的答案 <text class="badc">{{item.user_answer}}</text></text>
            <text class="m-k">正确答案 <text class="okc">{{item.correct_answer}}</text></text>
          </view>
          <text wx:if="{{item.explanation}}" class="m-exp" user-select>{{item.explanation}}</text>
          <view class="m-ops">
            <view class="m-op" data-index="{{index}}" catch:tap="onMaster">{{item.mastered ? '移回待掌握' : '标记已掌握'}}</view>
            <view wx:if="{{item.question_id}}" class="m-op" data-index="{{index}}" catch:tap="onShareQ">分享给队友</view>
          </view>
        </view>
      </view>
    </block>

    <block wx:if="{{!loading && tab === 'fav'}}">
      <view wx:if="{{!favs.length}}" class="empty">
        <view class="eico">⭐</view>
        <text>暂无收藏题目</text>
      </view>
      <view wx:for="{{favs}}" wx:key="id" class="card">
        <text class="m-q">{{item.question || '题目 #' + item.id}}</text>
        <view class="m-ops">
          <view class="m-op" data-module="{{item.module}}" catch:tap="onFavPractice">去练同模块</view>
          <view class="m-op" data-qid="{{item.id}}" catch:tap="onUnfav">取消收藏</view>
        </view>
      </view>
    </block>
    </block>
  </view>
</scroll-view>
