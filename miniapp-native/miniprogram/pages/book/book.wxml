<navbar title="错题本" large />
<scroll-view class="page-scroll" scroll-y type="list" scroll-top="{{scrollTop}}">
  <view class="wrap {{batchMode ? 'is-batch' : ''}}">
    <!-- 复习模式（kg-question-card / kg-option-group 小程序版未落地，页内按 T3 结构实现） -->
    <block wx:if="{{reviewing && rCur}}">
      <view class="review">
        <view class="rhead">
          <kg-tag tone="brand">{{rCur.extra ? '加练同类' : '复习'}} {{rIdx + 1}}/{{rItems.length}}</kg-tag>
          <view class="r-exit" hover-class="r-exit--hover" bind:tap="exitReview">退出复习</view>
        </view>
        <text class="m-q q-text" user-select>{{rCur.question_text}}</text>
        <view wx:if="{{rLetter}}" class="r-opts {{rOpts[0].text ? 'r-opts-full' : ''}}">
          <view
            wx:for="{{rOpts}}"
            wx:key="k"
            class="r-opt {{rOpts[0].text ? 'r-opt-full' : ''}} {{item.state ? 'r' + item.state : ''}}"
            hover-class="{{answered ? 'none' : 'r-opt--hover'}}"
            data-opt="{{item.k}}"
            bind:tap="onReviewPick"
          >
            <text class="r-opt-k">{{item.k}}</text>
            <text wx:if="{{item.text}}" class="r-opt-t q-text">{{item.text}}</text>
          </view>
        </view>
        <block wx:if="{{answered}}">
          <view class="r-verdict {{wasCorrect ? 'vok' : 'vbad'}}">
            <l-icon name="{{wasCorrect ? 'circle-check' : 'circle-x'}}" size="16" tone="{{wasCorrect ? 'ok' : 'bad'}}" />
            <text>{{rVerdict}}</text>
          </view>
          <view wx:if="{{!wasCorrect && rCur.appended}}" class="appended-tip">已为你在本轮末尾加练 {{rCur.appended}} 道同类题</view>
          <view wx:if="{{!wasCorrect && !rCur.extra}}" class="reasons">
            <text class="rz-t">错因自评</text>
            <view class="reasons-row"><kg-chip-row size="sm" options="{{reasonOpts}}" value="{{rCur.error_reason || ''}}" toggle bind:change="onReviewReason" /></view>
          </view>
          <text wx:if="{{rCur.explanation}}" class="m-exp q-text" user-select>{{rCur.explanation}}</text>
          <view class="r-next"><kg-button variant="primary" size="lg" block bind:click="onNextReview">{{rIdx + 1 < rItems.length ? '下一题' : '完成复习'}}</kg-button></view>
        </block>
        <block wx:elif="{{rMulti}}">
          <text class="r-sj-t">多选题：选完所有选项后确认</text>
          <kg-button variant="primary" size="lg" block disabled="{{!picked}}" bind:click="onConfirmMulti">确认答案{{picked ? '（已选 ' + picked + '）' : ''}}</kg-button>
        </block>
        <block wx:elif="{{!rLetter}}">
          <text class="r-sj-t">先自己做，然后：</text>
          <view class="r-sj-row">
            <view class="r-sj rsok" hover-class="r-sj--hover" data-ok="1" bind:tap="onSelfJudge"><l-icon name="circle-check" size="20" tone="ok" /><text>我做对了</text></view>
            <view class="r-sj rsbad" hover-class="r-sj--hover" data-ok="0" bind:tap="onSelfJudge"><l-icon name="circle-x" size="20" tone="bad" /><text>我做错了</text></view>
          </view>
        </block>
      </view>
    </block>

    <block wx:if="{{!reviewing}}">
    <!-- 焦点：今日待复习 / 断点续做，一屏一个主按钮 -->
    <view wx:if="{{resumeInfo}}" class="focus">
      <text class="focus-t">上次复习中断在第 {{resumeInfo.rIdx + 1}}/{{resumeInfo.items.length}} 题</text>
      <text class="focus-s">进度已保留，可原位继续</text>
      <view class="focus-acts">
        <kg-button variant="primary" size="lg" block bind:click="onResumeReview">继续复习</kg-button>
        <kg-button variant="text" size="md" bind:click="onDiscardResume">放弃</kg-button>
      </view>
    </view>
    <view wx:elif="{{dueTotal > 0}}" class="focus">
      <text class="focus-t">今日待复习 {{dueTotal}} 道</text>
      <text class="focus-s">按遗忘曲线安排，趁热打铁巩固一遍</text>
      <view class="focus-acts"><kg-button variant="primary" size="lg" block bind:click="onReviewFromCard">开始复习</kg-button></view>
    </view>

    <!-- 工具：重练 / AI 分析 / 录入 / 本月复盘，4 格一组 -->
    <kg-group wx:if="{{tab !== 'fav' && !batchMode && (todoCount || doneCount)}}">
      <kg-grid4 items="{{toolItems}}" bind:click="onTool" />
    </kg-group>

    <!-- 本月复盘（展开态） -->
    <kg-group wx:if="{{recap.total && recapOpen}}" title="本月错题复盘　新增 {{recap.total}} 道" more="收起" bind:more="onToggleRecap" padded>
      <view class="recap-sec">
        <text class="recap-st">按模块</text>
        <view wx:for="{{recap.byModule}}" wx:key="name" class="recap-row">
          <text class="recap-name">{{item.name}}</text>
          <view class="recap-bar"><view class="recap-fill" style="width: {{item.pct}}%" /></view>
          <text class="recap-n num">{{item.n}}</text>
        </view>
      </view>
      <view class="recap-sec">
        <text class="recap-st">按错因</text>
        <view wx:for="{{recap.byReason}}" wx:key="name" class="recap-row">
          <text class="recap-name">{{item.name}}</text>
          <view class="recap-bar"><view class="recap-fill warnfill" style="width: {{item.pct}}%" /></view>
          <text class="recap-n num">{{item.n}}</text>
        </view>
      </view>
      <text class="recap-tip">高频错因是提分洼地：优先复习对应模块的待掌握错题</text>
    </kg-group>

    <!-- 三态切换 + 筛选 + 批量 -->
    <view class="tabs">
      <view class="tabs-seg"><kg-segmented options="{{tabOpts}}" value="{{tab}}" bind:change="onTab" /></view>
      <view wx:if="{{tab !== 'fav'}}" class="textbtn {{sortBy !== 'time' || filterMod || filterType ? 'on' : ''}}" hover-class="filterbtn--hover" role="button" aria-label="筛选与排序" bind:tap="onFilterOpen">筛选</view>
      <view wx:if="{{tab !== 'fav' && shown.length}}" class="textbtn {{batchMode ? 'on' : ''}}" hover-class="filterbtn--hover" role="button" bind:tap="onToggleBatch">{{batchMode ? '完成' : '批量'}}</view>
    </view>

    <!-- 加载态 -->
    <view wx:if="{{loading}}" class="mlist">
      <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="mrow"><t-skeleton theme="paragraph" animation="gradient" /></view>
    </view>

    <!-- 错题列表：一题一行，组内分隔线 -->
    <block wx:if="{{!loading && tab !== 'fav'}}">
      <kg-empty
        wx:if="{{!shown.length}}"
        icon="{{tab === 'todo' ? 'party-popper' : 'inbox'}}"
        title="{{tab === 'todo' ? '暂无待掌握错题' : '还没有已掌握的错题'}}"
        desc="{{tab === 'todo' ? (filterMod || filterType ? '换个筛选条件试试' : '继续刷题，答错的题会自动进入这里') : '在待掌握列表里点「标记已掌握」即可归档'}}"
        ctaText="{{tab === 'todo' && !filterMod && !filterType ? '去刷题' : ''}}"
        ctaTo="/pages/practice/practice"
      />
      <view wx:if="{{shown.length}}" class="mlist">
        <view wx:for="{{shown}}" wx:key="id" class="mrow {{item.open ? 'is-open' : ''}} {{batchMode && selIds[item.id] ? 'is-sel' : ''}}" hover-class="mrow--hover" hover-stay-time="60" data-index="{{index}}" bind:tap="onToggle">
          <view class="m-line">
            <view wx:if="{{batchMode}}" class="bchk {{selIds[item.id] ? 'on' : ''}}"><l-icon wx:if="{{selIds[item.id]}}" name="check" size="16" tone="on-brand" /></view>
            <view class="m-main">
              <text class="m-q q-text {{item.open ? '' : 'm-q-clamp'}}">{{item.question_text}}</text>
              <view class="m-meta">
                <text>{{item.modName}}</text>
                <text wx:if="{{item.tag3_name}}">{{item.tag3_name}}</text>
                <text wx:elif="{{item.typeName && item.typeName !== item.modName}}">{{item.typeName}}</text>
                <text wx:if="{{item.source === 'manual'}}">手录</text>
                <text wx:if="{{item.error_reason}}" class="m-meta-warn">{{item.error_reason}}</text>
                <text wx:if="{{item.times > 1}}" class="m-meta-bad">错 {{item.times}} 次</text>
                <text wx:if="{{item.streakText}}" class="m-meta-ok">{{item.streakText}}</text>
              </view>
            </view>
            <l-icon wx:if="{{!batchMode}}" class="m-chev" name="{{item.open ? 'chevron-up' : 'chevron-down'}}" size="16" tone="faint" />
          </view>
          <view wx:if="{{item.open}}" class="m-detail">
            <view wx:if="{{item.optList.length}}" class="m-opts">
              <text
                wx:for="{{item.optList}}"
                wx:for-item="o"
                wx:key="k"
                class="m-opt q-text {{o.ok ? 'm-opt--ok' : ''}} {{o.bad ? 'm-opt--bad' : ''}}"
              >{{o.k}}. {{o.v}}</text>
            </view>
            <view class="m-ans">
              <text class="m-k">我的答案 <text class="badc">{{item.user_answer}}</text></text>
              <text class="m-k">正确答案 <text class="okc">{{item.correct_answer}}</text></text>
            </view>
            <text wx:if="{{item.explanation}}" class="m-exp q-text" user-select>{{item.explanation}}</text>
            <view wx:if="{{item.attempts && item.attempts.length}}" class="m-att">
              <text class="m-att-t">作答记录</text>
              <text wx:for="{{item.attempts}}" wx:for-item="a" wx:key="*this" class="m-att-row">{{a}}</text>
            </view>
            <view class="m-ops" catch:tap="noop">
              <kg-button variant="secondary" size="sm" icon="{{item.mastered ? 'rotate-ccw' : 'check'}}" data-index="{{index}}" bind:click="onMaster">{{item.mastered ? '移回待掌握' : '标记已掌握'}}</kg-button>
              <kg-button wx:if="{{item.question_id}}" variant="ghost" size="sm" icon="ellipsis" data-kind="mistake" data-index="{{index}}" data-qid="{{item.question_id}}" bind:click="onOpsOpen">更多</kg-button>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 收藏 -->
    <block wx:if="{{!loading && tab === 'fav'}}">
      <view class="folders-row">
        <view class="fold-chip {{folderId === null ? 'on' : ''}}" hover-class="fold-chip--hover" data-fid="all" bind:tap="onPickFolder">全部</view>
        <view
          wx:for="{{folders}}"
          wx:key="id"
          class="fold-chip {{folderId === item.id ? 'on' : ''}}"
          hover-class="fold-chip--hover"
          data-fid="{{item.id}}"
          data-name="{{item.name}}"
          bind:tap="onPickFolder"
          bind:longpress="onFolderOps"
        >{{item.icon}} {{item.name}} <text class="fold-n num">{{item.n}}</text></view>
        <view class="fold-chip fold-new" hover-class="fold-chip--hover" bind:tap="onNewFolder"><l-icon name="plus" size="16" tone="brand-text" /><text>新建收藏夹</text></view>
      </view>
      <text class="fold-tip">长按自建收藏夹可重命名 / 删除</text>
      <kg-empty wx:if="{{!favs.length}}" icon="star" title="暂无收藏题目" desc="刷题时点「收藏」，好题就会收进这里" ctaText="去刷题" ctaTo="/pages/practice/practice" />
      <view wx:if="{{favs.length}}" class="mlist">
        <view wx:for="{{favs}}" wx:key="id" class="mrow">
          <text class="m-q q-text">{{item.question || '题目 #' + item.id}}</text>
          <view wx:if="{{item.note}}" class="fav-note"><l-icon name="pen-line" size="16" tone="muted" /><text class="fav-note-t q-text">{{item.note}}</text></view>
          <view class="m-ops" catch:tap="noop">
            <kg-button variant="secondary" size="sm" icon="dumbbell" data-module="{{item.module}}" bind:click="onFavPractice">去练同模块</kg-button>
            <kg-button variant="ghost" size="sm" icon="ellipsis" data-kind="fav" data-index="{{index}}" data-qid="{{item.id}}" data-note="{{item.note ? 1 : 0}}" bind:click="onOpsOpen">更多</kg-button>
          </view>
        </view>
      </view>
    </block>
    </block>
  </view>
</scroll-view>

<!-- 批量操作条（H5 batchbar） -->
<view wx:if="{{batchMode && tab !== 'fav' && !reviewing}}" class="batchbar">
  <kg-button variant="text" size="md" bind:click="onSelAll">{{selCount === shown.length ? '取消全选' : '全选'}}</kg-button>
  <text class="batch-n">已选 {{selCount}}</text>
  <view class="batch-grow" />
  <kg-button wx:if="{{tab === 'todo'}}" variant="secondary" size="lg" disabled="{{!selCount || batchBusy}}" data-on="1" bind:click="onBatchMaster">标已掌握</kg-button>
  <kg-button wx:else variant="secondary" size="lg" disabled="{{!selCount || batchBusy}}" data-on="0" bind:click="onBatchMaster">恢复复习</kg-button>
  <kg-button variant="secondary" size="lg" tone="bad" disabled="{{!selCount || batchBusy}}" bind:click="onBatchDel">删除</kg-button>
</view>

<!-- AI 错题分析 -->
<kg-sheet visible="{{aiOpen}}" title="AI 错题分析" bind:close="onAiClose">
  <view wx:if="{{aiLoading}}" class="ai-loading">
    <t-skeleton theme="paragraph" animation="gradient" />
    <text class="side-s">正在分析你的错题与作答数据，约需 30-60 秒…</text>
  </view>
  <rich-text wx:else nodes="{{aiHtml}}" class="md" />
  <view slot="footer" class="sheet-acts"><kg-button wx:if="{{!aiLoading}}" variant="ghost" size="md" block icon="rotate-ccw" bind:click="onAiRetry">重新分析</kg-button></view>
</kg-sheet>

<!-- 手动录入答案（按卷） -->
<!-- 手录错题（免 AI，不对回题库；question_id=NULL 走复习/PDF 路径，不参与重练） -->
<kg-sheet visible="{{entryOpen}}" title="手录错题" bind:close="onEntryClose">
  <text class="sheet-k">模块</text>
  <view class="sheet-chips"><kg-chip-row size="sm" options="{{manualModOpts}}" value="{{entry.module}}" bind:change="onEntryModule" /></view>
  <text class="sheet-k">题干（可连选项一起粘贴，选项一行一个如「A. …」）</text>
  <view class="sheet-ta">
    <t-textarea value="{{entry.question}}" placeholder="例：下列节气中，白昼最长的是： A. 春分 B. 夏至 C. 秋分 D. 冬至" maxlength="{{2000}}" indicator autosize="{{entryTaSize}}" bordered="{{false}}" bind:change="onEntryQuestion" />
  </view>
  <view class="entry-ans">
    <view class="entry-ans-col">
      <text class="sheet-k">正确答案 *</text>
      <view class="manual-row entry-row"><text wx:for="{{entryCorrectRow}}" wx:key="L" class="manual-opt num {{item.on ? 'on' : ''}}" data-l="{{item.L}}" bind:tap="onEntryCorrect">{{item.L}}</text></view>
    </view>
    <view class="entry-ans-col">
      <text class="sheet-k">我的答案（选填）</text>
      <view class="manual-row entry-row"><text wx:for="{{entryPickedRow}}" wx:key="L" class="manual-opt num bad {{item.on ? 'on' : ''}}" data-l="{{item.L}}" bind:tap="onEntryPicked">{{item.L}}</text></view>
    </view>
  </view>
  <text class="sheet-k">错因（选填）</text>
  <view class="sheet-chips"><kg-chip-row size="sm" options="{{reasonOpts}}" value="{{entry.reason}}" bind:change="onEntryReason" /></view>
  <text class="sheet-k">解析 / 笔记（选填）</text>
  <view class="sheet-ta">
    <t-textarea value="{{entry.explanation}}" placeholder="复习时会显示在答案下方" maxlength="{{2000}}" autosize="{{taSize}}" bordered="{{false}}" bind:change="onEntryExplanation" />
  </view>
  <text wx:if="{{entryErr}}" class="entry-err">{{entryErr}}</text>
  <view slot="footer" class="sheet-acts">
    <kg-button variant="primary" size="lg" block loading="{{entrySaving}}" bind:click="onEntrySubmit">{{entrySaving ? '保存中…' : '加入错题本'}}</kg-button>
    <text class="entry-hint">不用 AI、不消耗额度；手录题参与复习计划与 PDF 导出，不参与「错题重练」</text>
    <kg-button variant="text" size="md" block bind:click="onEntryToPaper">有纸质试卷？按卷码录入答题卡 ›</kg-button>
  </view>
</kg-sheet>

<kg-sheet visible="{{manualOpen}}" title="按卷码录入答案" bind:close="onManualClose">
  <block wx:if="{{!manualPaper}}">
    <text class="sheet-k">输入卷面上的卷码</text>
    <view class="codebar">
      <t-input value="{{manualCode}}" placeholder="如 A1B2C3D4（封面/答题卡顶部）" borderless confirm-type="done" bind:change="onManualCode" bind:enter="onManualLookup" />
    </view>
  </block>
  <block wx:else>
    <text class="scan-sum">{{manualPaper.title || '试卷'}} · 卷码 {{manualPaper.code}} · 共 {{manualPaper.n}} 题 · 已选 {{manualPickedCount}}</text>
    <view class="scan-list">
      <view wx:for="{{manualRows}}" wx:key="no" class="manual-row">
        <text class="scan-no num">{{item.no}}</text>
        <text wx:for="{{item.opts}}" wx:for-item="o" wx:key="L" class="manual-opt num {{o.on ? 'on' : ''}}" data-no="{{item.no}}" data-l="{{o.L}}" bind:tap="onManualPick">{{o.L}}</text>
      </view>
    </view>
  </block>
  <view slot="footer" class="sheet-acts">
    <kg-button wx:if="{{!manualPaper}}" variant="primary" size="lg" block loading="{{manualLoading}}" bind:click="onManualLookup">{{manualLoading ? '查找中…' : '查找试卷'}}</kg-button>
    <block wx:else>
      <kg-button variant="primary" size="lg" block disabled="{{!manualPickedCount}}" loading="{{manualSubmitting}}" bind:click="onManualSubmit">{{manualSubmitting ? '判分中…' : '交卷判分（' + manualPickedCount + ' 题）'}}</kg-button>
      <kg-button variant="text" size="md" block bind:click="onManualBack">‹ 换一份试卷</kg-button>
    </block>
  </view>
</kg-sheet>

<!-- 对答案结果 -->
<kg-sheet visible="{{scanOpen && scanResult !== null}}" title="对答案结果 · {{scanResult.title || '试卷'}}" bind:close="onScanClose">
  <block wx:if="{{scanResult}}">
    <text class="scan-sum">卷码 {{scanResult.code}} · 已作答 {{scanResult.answered}}/{{scanResult.total}} · 答对 <text class="scan-good num">{{scanResult.correct}}</text> 题{{scanResult.saved ? ' · 已记入做题记录' : ''}}</text>
    <view class="scan-list">
      <view wx:for="{{scanRows}}" wx:key="no" class="scan-row">
        <text class="scan-no num">{{item.no}}</text>
        <text class="scan-pick {{item.cls}}">{{item.pickText}}</text>
        <text class="scan-ans">答案 {{item.answer}}</text>
        <text class="scan-mark">{{item.mark}}</text>
      </view>
    </view>
  </block>
  <view slot="footer" class="sheet-acts"><kg-button variant="primary" size="lg" block bind:click="onScanDone">完成</kg-button></view>
</kg-sheet>

<!-- 复习清零庆祝态；同考点强化建议随小结一屏展示，「回错题本」始终直接回列表 -->
<t-popup visible="{{celebrate}}" placement="center" bind:visible-change="onCelebrateVisible">
  <view class="cb-card">
    <view class="cb-ico"><l-icon name="party-popper" size="32" tone="ok" /></view>
    <view class="cb-t">{{celebrateCopy.title}}</view>
    <view class="cb-s {{celebrateCopy.cleared ? '' : 'cb-left'}}">{{celebrateCopy.line}}</view>
    <view wx:if="{{celebrateMastered}}" class="cb-s">达成掌握 {{celebrateMastered}} 道 · 已移到「已掌握」，不再安排复习</view>
    <view wx:if="{{celebrateNext}}" class="cb-s cb-next">{{celebrateNext}}</view>
    <view wx:if="{{reinforce}}" class="rf rf-inline">
      <text class="rf-k">趁热打铁：今天错得最多的考点</text>
      <text class="rf-name">{{reinforce.tag3_name || reinforce.submodule}}</text>
      <text class="rf-meta">{{reinforceMeta}}</text>
    </view>
    <view class="cb-btn">
      <block wx:if="{{!celebrateCopy.cleared}}">
        <kg-button variant="primary" size="lg" block bind:click="onContinueReview">{{celebrateCopy.cta}}</kg-button>
        <view class="rf-row2">
          <kg-button wx:if="{{reinforce}}" variant="text" size="md" bind:click="onStartReinforce">强化 5 道新题</kg-button>
          <kg-button variant="text" size="md" bind:click="onCloseCelebrate">回错题本</kg-button>
        </view>
      </block>
      <block wx:elif="{{reinforce}}">
        <kg-button variant="primary" size="lg" block bind:click="onStartReinforce">强化 5 道新题（未做过）›</kg-button>
        <view class="rf-row2">
          <kg-button wx:if="{{reinforceItems.length > 1}}" variant="text" size="md" bind:click="onSwapReinforce">换个考点</kg-button>
          <kg-button variant="text" size="md" bind:click="onCloseCelebrate">回错题本</kg-button>
        </view>
      </block>
      <kg-button wx:else variant="primary" size="lg" block bind:click="onCloseCelebrate">回错题本</kg-button>
    </view>
  </view>
</t-popup>

<!-- 错题卡「更多」分组菜单 -->
<t-popup visible="{{opsOpen}}" placement="bottom" bind:visible-change="onOpsVisible">
  <view class="sheet">
    <view class="sheet-handle" />
    <view class="sheet-h">
      <text class="sheet-t">更多操作</text>
      <view class="sheet-x" hover-class="sheet-x--hover" bind:tap="onOpsClose"><l-icon name="x" size="24" tone="muted" /></view>
    </view>
    <block wx:if="{{opsKind === 'mistake'}}">
      <t-cell-group title="学习" bordered>
        <t-cell title="笔记" description="记方法、记陷阱，随解析展示" hover arrow data-act="note" data-qid="{{opsQid}}" bind:click="onOpsPick"><l-icon slot="left-icon" name="pen-line" size="20" tone="brand" /></t-cell>
        <t-cell title="分享给队友" description="生成链接，答完可看大家选了啥" hover arrow data-act="share" data-index="{{opsIdx}}" bind:click="onOpsPick"><l-icon slot="left-icon" name="share-2" size="20" tone="brand" /></t-cell>
      </t-cell-group>
      <t-cell-group title="反馈" bordered>
        <t-cell title="题目纠错" description="答案 / 解析 / 错字 / 图片缺失" hover arrow data-act="report" data-index="{{opsIdx}}" bind:click="onOpsPick"><l-icon slot="left-icon" name="flag" size="20" tone="warn" /></t-cell>
      </t-cell-group>
    </block>
    <block wx:else>
      <t-cell-group title="学习" bordered>
        <t-cell title="{{opsHasNote ? '改笔记' : '写笔记'}}" hover arrow data-act="note" data-qid="{{opsQid}}" bind:click="onOpsPick"><l-icon slot="left-icon" name="pen-line" size="20" tone="brand" /></t-cell>
      </t-cell-group>
      <t-cell-group title="管理" bordered>
        <t-cell title="取消收藏" hover data-act="unfav" data-qid="{{opsQid}}" bind:click="onOpsPick"><l-icon slot="left-icon" name="trash-2" size="20" tone="bad" /></t-cell>
      </t-cell-group>
    </block>
  </view>
</t-popup>

<!-- 筛选与排序 -->
<t-popup visible="{{filterOpen}}" placement="bottom" bind:visible-change="onFilterVisible">
  <view class="sheet">
    <view class="sheet-handle" />
    <view class="sheet-h">
      <text class="sheet-t">筛选与排序</text>
      <view class="sheet-x" hover-class="sheet-x--hover" bind:tap="onFilterClose"><l-icon name="x" size="24" tone="muted" /></view>
    </view>
    <text class="sheet-st">排序</text>
    <view class="sheet-chips"><kg-chip-row options="{{sortOpts}}" value="{{sortBy}}" bind:change="onPickSort" /></view>
    <block wx:if="{{modOpts.length > 1}}">
      <text class="sheet-st">模块</text>
      <view class="sheet-chips"><kg-chip-row options="{{modOpts}}" value="{{filterMod}}" bind:change="onPickMod" /></view>
    </block>
    <block wx:if="{{typeOpts.length > 1}}">
      <text class="sheet-st">题型</text>
      <view class="sheet-chips"><kg-chip-row options="{{typeOpts}}" value="{{filterType}}" bind:change="onPickType" /></view>
    </block>
    <view class="sheet-row">
      <kg-button variant="ghost" size="lg" bind:click="onFilterReset">重置</kg-button>
      <view class="sheet-row-grow"><kg-button variant="primary" size="lg" block bind:click="onFilterClose">完成（{{shown.length}} 题）</kg-button></view>
    </view>
  </view>
</t-popup>

<!-- 题目纠错 -->
<t-popup visible="{{reportOpen}}" placement="bottom" bind:visible-change="onReportVisible">
  <view class="sheet">
    <view class="sheet-handle" />
    <view class="sheet-h">
      <text class="sheet-t">题目纠错</text>
      <view class="sheet-x" hover-class="sheet-x--hover" bind:tap="onReportClose"><l-icon name="x" size="24" tone="muted" /></view>
    </view>
    <text class="sheet-st">问题类型</text>
    <view class="sheet-chips"><kg-chip-row options="{{reportTypeOpts}}" value="{{reportType}}" bind:change="onPickReportType" /></view>
    <view class="sheet-ta">
      <t-textarea value="{{reportDetail}}" placeholder="补充说明（选填，500 字以内）" maxlength="{{500}}" indicator autosize="{{taSize}}" bordered="{{false}}" bind:change="onReportDetail" />
    </view>
    <view class="sheet-acts"><kg-button variant="primary" size="lg" block disabled="{{!reportType}}" loading="{{reportBusy}}" bind:click="onReportSubmit">提交纠错</kg-button></view>
  </view>
</t-popup>

<!-- 题目笔记 -->
<t-popup visible="{{noteOpen}}" placement="bottom" bind:visible-change="onNoteVisible">
  <view class="sheet">
    <view class="sheet-handle" />
    <view class="sheet-h">
      <text class="sheet-t">我的笔记</text>
      <view class="sheet-x" hover-class="sheet-x--hover" bind:tap="onNoteClose"><l-icon name="x" size="24" tone="muted" /></view>
    </view>
    <view class="sheet-ta note-ta">
      <t-textarea value="{{noteDraft}}" placeholder="记下这题的方法 / 陷阱，下次遇到随解析展示" maxlength="{{1000}}" indicator autosize="{{noteTaSize}}" bordered="{{false}}" bind:change="onNoteInput" />
    </view>
    <view class="sheet-row">
      <kg-button wx:if="{{noteHas}}" variant="ghost" tone="bad" size="lg" icon="trash-2" data-clear="1" bind:click="onNoteSave">删除笔记</kg-button>
      <view class="sheet-row-grow"><kg-button variant="primary" size="lg" block loading="{{noteBusy}}" bind:click="onNoteSave">保存</kg-button></view>
    </view>
  </view>
</t-popup>
