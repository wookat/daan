.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 32rpx 0;
  font-size: 24rpx;
}

.hero {
  display: flex;
  flex-direction: column;
}

.hero-t {
  font-size: 34rpx;
  font-weight: 800;
}

.hero-s {
  font-size: 23rpx;
  color: var(--t3);
  margin: 10rpx 0 20rpx;
}

.st-l {
  font-size: 24rpx;
  color: var(--t3);
  margin-bottom: 12rpx;
}

.chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.set-chip {
  font-size: 24rpx;
  color: var(--t2);
  background: var(--fill);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  margin: 0 14rpx 14rpx 0;
}

.set-chip.on {
  background: var(--brand-500);
  color: #fff;
}

.gap {
  margin-top: 16rpx;
}

.dis {
  opacity: 0.6;
}

.join-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.join-input {
  flex: 1;
  background: var(--fill);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  color: var(--t1);
}

.join-btn {
  margin-left: 16rpx;
  background: var(--brand-500);
  color: #fff;
  border-radius: 999rpx;
  padding: 16rpx 40rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.lb-h {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.lb-t {
  font-size: 28rpx;
  font-weight: 700;
}

.lb-mine {
  font-size: 22rpx;
  color: var(--t3);
}

.lb-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 0;
}

.lb-rank {
  width: 56rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--t3);
}

.lb-rank.top {
  color: var(--warning);
}

.lb-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--t1);
}

.lb-wins {
  font-size: 24rpx;
  color: var(--brand-500);
  font-weight: 600;
}

.mine-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.m-result {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--fill);
  color: var(--t3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 20rpx;
}

.m-result.win {
  background: var(--success-bg);
  color: var(--success);
}

.m-result.lose {
  background: var(--error-bg);
  color: var(--error);
}

.m-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.m-t {
  font-size: 26rpx;
  font-weight: 600;
}

.m-s {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 4rpx;
}

.m-go {
  color: var(--t4);
  font-size: 28rpx;
}

/* 对战 */
.q-top {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.countdown {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--brand-500);
}

.countdown.urgent {
  color: var(--error);
}

.progress {
  height: 10rpx;
  background: var(--fill);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.pfill {
  height: 100%;
  background: var(--brand-500);
  border-radius: 999rpx;
}

.q-text {
  display: block;
  font-size: 29rpx;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.opt {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--fill);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 14rpx;
}

.okey {
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--brand-500);
  margin-right: 20rpx;
}

.otext {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 结果 */
.result {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.res-t {
  font-size: 40rpx;
  font-weight: 800;
  margin: 12rpx 0 28rpx;
}

.vs-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.vs-side {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.vs-name {
  font-size: 24rpx;
  color: var(--t2);
}

.vs-score {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--brand-500);
}

.vs-sub {
  font-size: 22rpx;
  color: var(--t3);
}

.vs-x {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--t4);
}

.wait-tip {
  font-size: 23rpx;
  color: var(--t3);
  margin-bottom: 16rpx;
}

.code-box {
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  background: var(--brand-50);
  color: var(--brand-600);
  border-radius: 16rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.share-btn {
  width: 100%;
  background: var(--success);
  color: #fff;
  border-radius: 999rpx;
  font-size: 27rpx;
  padding: 18rpx 0;
}

.share-btn::after {
  border: none;
}

.gap {
  width: 100%;
  box-sizing: border-box;
}
