.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 96rpx 0;
}

.cold {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.eico {
  width: 144rpx;
  height: 144rpx;
  border-radius: 48rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 24rpx;
}

.cold-t {
  font-size: 30rpx;
  font-weight: 700;
}

.cold-s {
  font-size: 23rpx;
  color: var(--t3);
  margin: 12rpx 0 28rpx;
}

.cold .btn-primary {
  width: 100%;
}

.cover {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.cover-l {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.cover-n {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--brand-500);
  margin-right: 12rpx;
}

.cover-t {
  font-size: 24rpx;
  color: var(--t2);
}

.cover-s {
  font-size: 22rpx;
  color: var(--t3);
}

.fscroll {
  width: 100%;
  margin-bottom: 16rpx;
}

.frow {
  display: flex;
  flex-direction: row;
}

.fchip {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 64rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: var(--t2);
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  padding: 0 26rpx;
  margin-right: 12rpx;
}

.fchip.on {
  color: #fff;
  background: var(--brand-500);
  border-color: var(--brand-500);
  font-weight: 600;
}

.legend {
  display: flex;
  flex-direction: row;
  margin-bottom: 16rpx;
}

.lg {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 21rpx;
  color: var(--t3);
  margin-right: 24rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}

.lv-strong {
  background: var(--success-bg);
  border: 1rpx solid var(--success);
}

.lv-ok {
  background: var(--brand-50);
  border: 1rpx solid var(--brand-300);
}

.lv-weak {
  background: var(--error-bg);
  border: 1rpx solid var(--error);
}

.lv-new {
  background: var(--fill);
  border: 1rpx solid var(--border);
}

.sub-h {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.sub-t {
  font-size: 28rpx;
  font-weight: 600;
}

.sub-s {
  font-size: 21rpx;
  color: var(--t3);
}

.tiles {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.tile {
  box-sizing: border-box;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin: 0 12rpx 12rpx 0;
  display: flex;
  flex-direction: column;
}

.tile-t {
  font-size: 23rpx;
  color: var(--t1);
}

.tile-due {
  font-size: 19rpx;
  color: var(--error);
  margin-top: 4rpx;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 18, 30, 0.5);
  z-index: 90;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  background: var(--surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
}

.d-t {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.d-s {
  display: block;
  font-size: 23rpx;
  color: var(--t3);
  margin: 12rpx 0;
}

.d-due {
  display: block;
  font-size: 22rpx;
  color: var(--error);
  margin-bottom: 12rpx;
}

.sheet .btn-primary {
  margin-top: 16rpx;
}
