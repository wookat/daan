.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 96rpx 0;
}

.cold {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.eico {
  width: 144rpx;
  height: 144rpx;
  border-radius: 48rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 24rpx;
}

.cold-t {
  font-size: 30rpx;
  font-weight: 700;
}

.cold-s {
  font-size: 23rpx;
  color: var(--t3);
  margin: 12rpx 0 28rpx;
  text-align: center;
}

.cold .btn-primary {
  width: 100%;
}

.hero {
  background: linear-gradient(135deg, var(--brand-500), #6c9bff);
  border: none;
}

.hero-range {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  margin-bottom: 20rpx;
}

.hero-nums {
  display: flex;
  flex-direction: row;
}

.hn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hn-n {
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
}

.hn-l {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}

.h {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.badge {
  display: flex;
  flex-direction: column;
  background: var(--warning-bg);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.badge-t {
  font-size: 25rpx;
  font-weight: 600;
}

.badge-s {
  font-size: 21rpx;
  color: var(--t3);
  margin-top: 4rpx;
}

.chg {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  min-height: 64rpx;
  font-size: 24rpx;
}

.chg.up {
  color: var(--success);
}

.chg.down {
  color: var(--error);
}

.chg-v {
  font-size: 22rpx;
}

.reason {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  min-height: 64rpx;
  font-size: 24rpx;
  color: var(--t2);
}

.reason-n {
  font-size: 22rpx;
  color: var(--t3);
}

.mockcard {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.e-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.e-t {
  font-size: 28rpx;
  font-weight: 600;
}

.e-s {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

.e-go {
  font-size: 32rpx;
  color: var(--t4);
}

.action {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  min-height: 80rpx;
  border-bottom: 1rpx solid var(--border);
}

.action:last-child {
  border-bottom: none;
}

.action-t {
  flex: 1;
  font-size: 25rpx;
  color: var(--t1);
}

.action-go {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--brand-500);
  font-weight: 600;
}

.prev-link {
  text-align: center;
  font-size: 24rpx;
  color: var(--brand-500);
  padding: 16rpx 0 32rpx;
}
