.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 200rpx;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 48rpx;
}

.rhead {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.cnt-ok {
  font-size: 22rpx;
  color: var(--success);
  background: var(--success-bg);
  border-radius: var(--r-full);
  padding: 2rpx 16rpx;
  font-weight: 600;
}

.progress {
  height: 6rpx;
  background: var(--fill);
  border-radius: var(--r-full);
  overflow: hidden;
  margin-bottom: 22rpx;
}

.pfill {
  height: 100%;
  background: linear-gradient(90deg, #6c9bff, var(--brand-500));
  border-radius: var(--r-full);
}

.real-tag {
  margin-bottom: 12rpx;
}

.q {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--t1);
  margin-bottom: 24rpx;
}

.opt {
  display: flex;
  flex-direction: row;
  align-items: center;
  border: 1rpx solid var(--border);
  border-radius: var(--r-m);
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  background: var(--surface);
}

.opt.right {
  border-color: var(--success);
  background: var(--success-bg);
}

.opt.wrong {
  border-color: var(--error);
  background: var(--error-bg);
}

.opt.dim {
  opacity: 0.55;
}

.okey {
  font-weight: 700;
  color: var(--brand-500);
  margin-right: 16rpx;
}

.otext {
  flex: 1;
  font-size: 28rpx;
  color: var(--t1);
  line-height: 1.6;
}

.omark {
  font-weight: 700;
  margin-left: 12rpx;
}

.omark.good {
  color: var(--success);
}

.omark.badm {
  color: var(--error);
}

.after {
  margin-top: 8rpx;
  border-top: 1rpx solid var(--border);
  padding-top: 20rpx;
}

.exp-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12rpx;
}

.exp-col {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.exp-k {
  font-size: 22rpx;
  color: var(--t3);
  margin-right: 16rpx;
  margin-bottom: 8rpx;
}

.exp-k.hs {
  color: var(--brand-500);
  font-weight: 600;
}

.exp-k.xp {
  color: var(--warning);
  font-weight: 600;
}

.exp-ans {
  font-size: 32rpx;
  font-weight: 700;
}

.exp-ans.okc {
  color: var(--success);
}

.exp-ans.badc {
  color: var(--error);
}

.exp {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--t2);
}

.exp.hsx {
  background: var(--brand-50);
  border-radius: var(--r-s);
  padding: 16rpx 20rpx;
}

.exp-v {
  font-size: 24rpx;
  color: var(--t2);
}

.banner {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-radius: var(--r-m);
  padding: 22rpx 28rpx;
  box-shadow: var(--sh-2);
}

.banner.bok {
  background: var(--success-bg);
  border: 1rpx solid var(--success);
}

.banner.bbad {
  background: var(--error-bg);
  border: 1rpx solid var(--error);
}

.btitle {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--t1);
}

.bnext {
  border-radius: var(--r-full);
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

.bnext.nok {
  background: var(--success);
}

.bnext.nbad {
  background: var(--error);
}

.done {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}

.done-pct {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--brand-500);
}

.done-t {
  font-size: 34rpx;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.done-sub {
  font-size: 24rpx;
  color: var(--t3);
  margin-bottom: 12rpx;
}

.done-beat {
  font-size: 24rpx;
  color: var(--brand-500);
  margin-bottom: 20rpx;
}

.done .btn-primary,
.done .btn-ghost {
  align-self: stretch;
}

.done-quit {
  margin-top: 16rpx;
}

.rhead-r {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.sz-fav {
  font-size: 36rpx;
  color: var(--t4);
  margin-right: 16rpx;
}

.sz-fav.on {
  color: var(--warning);
}

.link-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 20rpx;
}

.link-item {
  font-size: 23rpx;
  color: var(--brand-500);
}

.link-item.report {
  color: var(--t3);
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 18, 30, 0.5);
  z-index: 90;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  background: var(--surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
}

.sheet-t {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.rp-types {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.rp-chip {
  font-size: 24rpx;
  color: var(--t2);
  background: var(--fill);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  margin: 0 14rpx 14rpx 0;
}

.rp-chip.on {
  background: var(--brand-500);
  color: #fff;
}

.rp-detail {
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  background: var(--fill);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 25rpx;
  color: var(--t1);
  margin-bottom: 20rpx;
}

.rp-dis {
  opacity: 0.5;
}
