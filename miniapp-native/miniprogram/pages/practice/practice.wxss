.wrap {
  padding: var(--sp-12) var(--page-x) calc(var(--bar-h) + var(--sp-24) + env(safe-area-inset-bottom));
}

/* 顶栏：idx / 计时 / ✓✗ / 字号 */
.p-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-8);
  min-height: 32px;
  margin-bottom: var(--sp-8);
}

.p-idx {
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink-3);
}

.p-idx-b {
  font-size: var(--fs-h2);
  color: var(--ink);
}

.p-cnt {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
}

.p-timer,
.cnt {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink-2);
}

.cnt-ok {
  color: var(--ok-strong);
}

.cnt-bad {
  color: var(--bad-strong);
}

.font-btn {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  min-width: var(--hit-min);
  height: 32px;
  padding: 0 var(--sp-8);
  border-radius: var(--r-full);
  background: var(--fill);
  color: var(--ink-2);
  font-size: var(--fs-caption);
  font-weight: 600;
  box-sizing: border-box;
  justify-content: center;
}

.font-btn--hover {
  background: var(--line);
}

.progress {
  margin-bottom: var(--sp-12);
}

/* 题卡 */
.qcard {
  display: block;
  margin-bottom: var(--card-gap);
}

.tagrow {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-8);
  margin-bottom: var(--sp-12);
}

.tagrow:empty {
  display: none;
}

.q {
  display: block;
  line-height: 1.7;
  color: var(--ink);
}

.q-meta {
  display: block;
  margin-top: var(--sp-8);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  line-height: 1.5;
}

.qimg {
  display: block;
  width: 100%;
  max-width: 100%;
  margin-top: var(--sp-12);
  border-radius: var(--r-sm);
  background: var(--fill);
}

.qimg-credit {
  display: block;
  margin-top: var(--sp-4);
  font-size: var(--fs-caption);
  color: var(--ink-4);
}

.opts {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
  margin-top: var(--sp-16);
}

.opt {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  min-height: var(--hit-min);
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  padding: var(--sp-8) var(--sp-12);
  background: var(--card);
  box-sizing: border-box;
}

.opt--hover {
  background: var(--fill);
}

.opt.right {
  border-color: var(--ok);
  background: var(--ok-soft);
}

.opt.wrong {
  border-color: var(--bad);
  background: var(--bad-soft);
}

.opt.dim {
  opacity: 0.55;
}

.okey {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  border-radius: var(--r-full);
  background: var(--fill);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink-2);
}

.opt.right .okey {
  background: var(--ok);
  color: var(--on-brand);
}

.opt.wrong .okey {
  background: var(--bad);
  color: var(--on-brand);
}

.otext {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  line-height: 1.6;
}

/* 判分横幅 */
.banner {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  padding: var(--sp-12) var(--card-pad);
  border-radius: var(--r-md);
  margin-bottom: var(--card-gap);
}

.banner.bok {
  background: var(--ok-soft);
}

.banner.bbad {
  background: var(--bad-soft);
}

.b-l {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.btitle {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.bok .btitle {
  color: var(--ok-strong);
}

.bbad .btitle {
  color: var(--bad-strong);
}

.bsub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}

/* 解析卡 */
.exp-card {
  display: block;
  margin-bottom: var(--card-gap);
}

.exp-row {
  display: flex;
  align-items: baseline;
  gap: var(--sp-8);
  padding: var(--sp-4) 0;
  font-size: var(--fs-sub);
  line-height: 1.6;
}

.exp-row + .exp-row {
  border-top: 1px solid var(--line);
  padding-top: var(--sp-8);
  margin-top: var(--sp-4);
}

.exp-k {
  flex-shrink: 0;
  width: 60px;
  color: var(--ink-3);
}

.exp-v {
  flex: 1;
  min-width: 0;
  color: var(--ink-2);
}

.exp-v.badc {
  color: var(--bad-strong);
}

.exp-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--sp-8);
  margin-top: var(--sp-16);
  padding-top: var(--sp-12);
  border-top: 1px solid var(--line);
}

.exp-block:first-child {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}

.exp-lab {
  font-size: var(--fs-sub);
  font-weight: 500;
  color: var(--ink-3);
}

.exp-lab.is-brand {
  color: var(--brand-text);
}

.exp-text {
  display: block;
  color: var(--ink-2);
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 结算 */
.done {
  display: block;
}

.done-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--sp-8) 0;
}

.done-t {
  margin-top: var(--sp-16);
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink);
}

.done-sub {
  margin-top: var(--sp-4);
  font-size: var(--fs-sub);
  color: var(--ink-3);
}

.done-beat {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-4);
  margin-top: var(--sp-12);
  padding: var(--sp-4) var(--sp-12);
  border-radius: var(--r-full);
  background: var(--brand-soft);
  color: var(--brand-text);
  font-size: var(--fs-caption);
  font-weight: 600;
}

.duenudge {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  width: 100%;
  margin-top: var(--sp-20);
  padding: var(--sp-12) var(--card-pad);
  border-radius: var(--r-md);
  background: var(--streak-soft);
  text-align: left;
  box-sizing: border-box;
}

.duenudge--hover {
  opacity: 0.8;
}

.duenudge-l {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.duenudge-t {
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink);
}

.duenudge-s {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}

.duenudge-go {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  min-height: var(--hit-min);
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--brand-text);
}

/* 底栏按钮（slot 内容归页面样式） */
.abar-btn {
  display: block;
  flex: 1;
  min-width: 0;
}

.abar-main {
  flex: 1.6;
}

/* ---- W6 Learn 对齐：公告条 / 模式 chip / 排除法 / 错因 / 讲解区操作 / 底栏工具 / sheet 内容 ---- */
.ann {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  padding: var(--sp-8) var(--sp-12);
  margin-bottom: var(--card-gap);
  border-radius: var(--r-md);
  background: var(--info-soft);
  color: var(--info-strong);
}

.ann-t {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-caption);
  line-height: 1.5;
}

.ann-x {
  flex: none;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: calc(-1 * var(--sp-8));
}

.pskel-hint {
  display: block;
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-12);
}

.modechips {
  display: flex;
  gap: var(--sp-4);
  flex-wrap: wrap;
}

.p-timer.overtime {
  color: var(--bad-strong);
}

.opt.excl {
  opacity: 0.45;
}

.opt.excl .otext {
  text-decoration: line-through;
}

.opt-hint {
  display: block;
  margin-top: var(--sp-8);
  font-size: var(--fs-caption);
  color: var(--ink-4);
}

.b-l {
  flex: 1;
}

.reasons,
.rp-types {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--sp-8);
  margin-bottom: var(--card-gap);
}

.rp-types {
  margin-top: var(--sp-12);
}

/* 解析卡内的错因自评：与 exp-block 同一套分隔，不再带卡间距 */
.exp-card .reasons {
  margin: var(--sp-16) 0 0;
  padding-top: var(--sp-12);
  border-top: 1px solid var(--line);
}

.rz-t {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.rz {
  min-height: 32px;
  padding: 0 var(--sp-12);
  display: inline-flex;
  align-items: center;
  border-radius: var(--r-full);
  border: 1px solid var(--line);
  background: var(--card);
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

.rz.on {
  border-color: var(--brand);
  background: var(--brand-soft);
  color: var(--brand-text);
}

.hs-rate {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  margin-top: var(--sp-8);
}

.hs-rate-t,
.hs-rate-done {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.exp-acts {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
  margin-top: var(--sp-12);
  padding-top: var(--sp-12);
  border-top: 1px solid var(--line);
}

/* 讨论/笔记/纠错：等宽三格，375 宽不折行 */
.exp-acts-row {
  display: flex;
  gap: var(--sp-8);
}

.exp-act {
  flex: 1;
  min-width: 0;
}

.abar-tools {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  flex: none;
}

.kg-tool {
  width: var(--hit-min);
  height: var(--hit-min);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
}

.kg-tool--hover {
  background: var(--fill);
}

.acard-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: var(--sp-8);
  padding: var(--sp-12) 0;
}

.acard-n {
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-sm);
  border: 1px solid var(--line);
  background: var(--card);
  font-size: var(--fs-sub);
  color: var(--ink-2);
}

.acard-n.ok {
  background: var(--ok-soft);
  border-color: var(--ok);
  color: var(--ok-strong);
}

.acard-n.bad {
  background: var(--bad-soft);
  border-color: var(--bad);
  color: var(--bad-strong);
}

.acard-n.seen {
  background: var(--fill);
}

.acard-n.cur {
  border-color: var(--brand);
  color: var(--brand-text);
  font-weight: 600;
}

.acard-foot {
  display: block;
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  padding-bottom: var(--sp-8);
}

.tool-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-12);
  min-height: var(--hit-min);
  padding: var(--sp-8) 0;
  border-bottom: 1px solid var(--line);
}

.tool-name {
  font-size: var(--fs-body);
  color: var(--ink);
}

.tool-val {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.tool-val.on {
  color: var(--brand-text);
  font-weight: 600;
}

.rp-field {
  margin-top: var(--sp-12);
  background: var(--fill);
  border-radius: var(--r-sm);
  overflow: hidden;
}

.sheet-acts {
  padding-top: var(--sp-16);
}

/* 桌面：题目列 ≤760 居中（T3 辅栏答题卡为 H5 专有，小程序桌面端仅收窄） */
@media (min-width: 1024px) {
  .wrap {
    max-width: 760px;
    margin: 0 auto;
  }
}

/* 结算：错题重练效果 / 曾错题复习推进（practice.vue redoReport / fixReport 同口径） */
.rr {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin-top: var(--sp-16);
  padding: var(--sp-12) var(--card-pad);
  border-radius: var(--r-md);
  background: var(--bg);
  box-sizing: border-box;
}

.rr-t {
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink);
}

.rr-row {
  display: flex;
  width: 100%;
  margin-top: var(--sp-8);
}

.rr-it {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rr-v {
  font-size: var(--fs-h2);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--ink);
}

.rr-v.ok {
  color: var(--ok-strong);
}

.rr-v.bad {
  color: var(--bad-strong);
}

.rr-v.brand {
  color: var(--brand-text);
}

.rr-l {
  margin-top: 2px;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.rr-tip {
  margin-top: var(--sp-8);
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.fr {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  width: 100%;
  min-height: 44px;
  margin-top: var(--sp-16);
  padding: var(--sp-12) var(--card-pad);
  border-radius: var(--r-md);
  background: var(--ok-soft);
  text-align: left;
  box-sizing: border-box;
}

.fr-t {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink);
}
