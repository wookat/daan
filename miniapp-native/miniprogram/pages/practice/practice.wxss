.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: var(--sp-12) var(--page-x) calc(var(--bar-h) + var(--sp-24) + env(safe-area-inset-bottom));
}

/* 顶栏：idx / 计时 / ✓✗ / 字号 */
.p-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-8);
  min-height: 32px;
  margin-bottom: var(--sp-8);
}

.p-idx {
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink-3);
}

.p-idx-b {
  font-size: var(--fs-h2);
  color: var(--ink);
}

.p-cnt {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
}

.p-timer,
.cnt {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink-2);
}

.cnt-ok {
  color: var(--ok-strong);
}

.cnt-bad {
  color: var(--bad-strong);
}

.font-btn {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  min-width: var(--hit-min);
  height: 32px;
  padding: 0 var(--sp-8);
  border-radius: var(--r-full);
  background: var(--fill);
  color: var(--ink-2);
  font-size: var(--fs-caption);
  font-weight: 600;
  box-sizing: border-box;
  justify-content: center;
}

.font-btn--hover {
  background: var(--line);
}

.progress {
  margin-bottom: var(--sp-12);
}

/* 题卡 */
.qcard {
  display: block;
  margin-bottom: var(--card-gap);
}

.tagrow {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-8);
  margin-bottom: var(--sp-12);
}

.tagrow:empty {
  display: none;
}

.q {
  display: block;
  line-height: 1.7;
  color: var(--ink);
}

.q-meta {
  display: block;
  margin-top: var(--sp-8);
  font-size: var(--fs-caption);
  color: var(--ink-3);
  line-height: 1.5;
}

.qimg {
  display: block;
  width: 100%;
  max-width: 100%;
  margin-top: var(--sp-12);
  border-radius: var(--r-sm);
  background: var(--fill);
}

.qimg-credit {
  display: block;
  margin-top: var(--sp-4);
  font-size: var(--fs-caption);
  color: var(--ink-4);
}

.opts {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
  margin-top: var(--sp-16);
}

.opt {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  min-height: var(--hit-min);
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  padding: var(--sp-8) var(--sp-12);
  background: var(--card);
  box-sizing: border-box;
}

.opt--hover {
  background: var(--fill);
}

.opt.right {
  border-color: var(--ok);
  background: var(--ok-soft);
}

.opt.wrong {
  border-color: var(--bad);
  background: var(--bad-soft);
}

.opt.dim {
  opacity: 0.55;
}

.okey {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  border-radius: var(--r-full);
  background: var(--fill);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink-2);
}

.opt.right .okey {
  background: var(--ok);
  color: var(--on-brand);
}

.opt.wrong .okey {
  background: var(--bad);
  color: var(--on-brand);
}

.otext {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  line-height: 1.6;
}

/* 判分横幅 */
.banner {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  padding: var(--sp-12) var(--card-pad);
  border-radius: var(--r-md);
  margin-bottom: var(--card-gap);
}

.banner.bok {
  background: var(--ok-soft);
}

.banner.bbad {
  background: var(--bad-soft);
}

.b-l {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.btitle {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.bok .btitle {
  color: var(--ok-strong);
}

.bbad .btitle {
  color: var(--bad-strong);
}

.bsub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}

/* 解析卡 */
.exp-card {
  display: block;
  margin-bottom: var(--card-gap);
}

.exp-row {
  display: flex;
  align-items: baseline;
  gap: var(--sp-8);
  padding: var(--sp-4) 0;
  font-size: var(--fs-sub);
  line-height: 1.6;
}

.exp-row + .exp-row {
  border-top: 1px solid var(--line);
  padding-top: var(--sp-8);
  margin-top: var(--sp-4);
}

.exp-k {
  flex-shrink: 0;
  width: 60px;
  color: var(--ink-3);
}

.exp-v {
  flex: 1;
  min-width: 0;
  color: var(--ink-2);
}

.exp-ans {
  font-size: var(--fs-h2);
  font-weight: 600;
}

.exp-ans.okc {
  color: var(--ok-strong);
}

.exp-ans.badc {
  color: var(--bad-strong);
}

.exp-mine {
  color: var(--ink-3);
}

.exp-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--sp-8);
  margin-top: var(--sp-16);
  padding-top: var(--sp-12);
  border-top: 1px solid var(--line);
}

.exp-text {
  display: block;
  color: var(--ink-2);
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 结算 */
.done {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding-top: var(--sp-24);
  padding-bottom: var(--sp-24);
}

.done-t {
  margin-top: var(--sp-16);
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink);
}

.done-sub {
  margin-top: var(--sp-4);
  font-size: var(--fs-sub);
  color: var(--ink-3);
}

.done-beat {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-4);
  margin-top: var(--sp-12);
  padding: var(--sp-4) var(--sp-12);
  border-radius: var(--r-full);
  background: var(--brand-soft);
  color: var(--brand-text);
  font-size: var(--fs-caption);
  font-weight: 600;
}

.duenudge {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  width: 100%;
  margin-top: var(--sp-20);
  padding: var(--sp-12) var(--card-pad);
  border-radius: var(--r-md);
  background: var(--streak-soft);
  text-align: left;
  box-sizing: border-box;
}

.duenudge--hover {
  opacity: 0.8;
}

.duenudge-l {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.duenudge-t {
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink);
}

.duenudge-s {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}

.duenudge-go {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  min-height: var(--hit-min);
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--brand-text);
}

/* 底栏按钮（slot 内容归页面样式） */
.abar-btn {
  display: block;
  flex: 1;
  min-width: 0;
}

.abar-main {
  flex: 1.6;
}

/* 桌面：题目列 ≤760 居中（T3 辅栏答题卡为 H5 专有，小程序桌面端仅收窄） */
@media (min-width: 1024px) {
  .wrap {
    max-width: 760px;
    margin: 0 auto;
  }
}
