.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 200rpx;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 48rpx;
}

.p-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.p-idx {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--t3);
  font-variant-numeric: tabular-nums;
}

.p-idx-b {
  font-size: 28rpx;
  color: var(--brand-500);
}

.p-cnt {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.p-timer {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--t2);
  font-variant-numeric: tabular-nums;
  background: var(--fill);
  border-radius: var(--r-full);
  padding: 4rpx 16rpx;
  margin-right: 20rpx;
}

.font-btn {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-left: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--r-full);
  background: var(--fill);
  color: var(--t2);
  font-size: 26rpx;
  font-weight: 800;
}

.font-btn-lv {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--brand-500);
  margin-left: 4rpx;
}

.cnt-ok {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--success-deep);
}

.cnt-bad {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--error-deep);
  margin-left: 20rpx;
}

.progress {
  height: 12rpx;
  background: var(--fill);
  border-radius: var(--r-full);
  overflow: hidden;
  margin-bottom: 28rpx;
}

.tagrow {
  display: flex;
  flex-direction: row;
  margin-bottom: 16rpx;
}

.tagrow .tag {
  margin-right: 12rpx;
}

.pfill {
  height: 100%;
  background: var(--brand-grad-btn);
  border-radius: var(--r-full);
}

.real-tag {
  margin-bottom: 12rpx;
}

.q {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.72;
  color: var(--t1);
  margin: 8rpx 0 28rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.qimg {
  width: 100%;
  border-radius: 12rpx;
  margin: 0 0 8rpx;
  background: var(--fill);
}

.qimg-credit {
  display: block;
  font-size: 20rpx;
  color: var(--t3);
  margin-bottom: 16rpx;
}

.opt {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  border: 3rpx solid var(--border);
  border-radius: var(--r-m);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  background: var(--surface);
}

.opt.right {
  border-color: var(--success);
  background: var(--success-bg);
}

.opt.wrong {
  border-color: var(--error);
  background: var(--error-bg);
}

.opt.dim {
  opacity: 0.5;
}

.okey {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--fill);
  color: var(--t2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.opt.right .okey {
  background: var(--success);
  color: #fff;
}

.opt.wrong .okey {
  background: var(--error);
  color: #fff;
}

.otext {
  flex: 1;
  font-size: 30rpx;
  color: var(--t1);
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-all;
}

.omark {
  font-weight: 800;
  font-size: 32rpx;
  margin-left: 12rpx;
}

.omark.good {
  color: var(--success-deep);
}

.omark.badm {
  color: var(--error-deep);
}

.exp-card {
  margin-top: 8rpx;
}

.exp-ans-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.exp-ans-k {
  font-size: 26rpx;
  color: var(--t3);
  margin-right: 24rpx;
}

.exp-ans {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--success-deep);
  font-variant-numeric: tabular-nums;
}

.exp-mine {
  font-size: 26rpx;
  color: var(--error-deep);
  font-weight: 700;
  margin-left: auto;
}

.exp-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 28rpx;
}

.exp-title {
  font-size: 26rpx;
  font-weight: 800;
  padding: 8rpx 20rpx;
  border-radius: var(--r-full);
}

.exp-title.hs {
  background: var(--accent-bg);
  color: var(--accent-600);
}

.exp-title.xp {
  background: var(--mod-panduan-bg);
  color: var(--mod-panduan);
}

.exp-title.pl {
  background: var(--fill);
  color: var(--t2);
}

.exp-text {
  align-self: stretch;
  width: 100%;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--t2);
  margin-top: 16rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.exp-src {
  display: block;
  font-size: 22rpx;
  color: var(--t4);
  margin-top: 24rpx;
}

.banner {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 900;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-radius: var(--r-l);
  padding: 24rpx 32rpx;
  box-shadow: var(--sh-2);
}

.banner.bok {
  background: linear-gradient(120deg, #34d399, var(--success-deep));
}

.banner.bbad {
  background: linear-gradient(120deg, #ff6b81, var(--error-deep));
}

.b-l {
  display: flex;
  flex-direction: column;
}

.btitle {
  font-size: 30rpx;
  font-weight: 800;
  color: #fff;
}

.bsub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 2rpx;
}

.bnext {
  background: #fff;
  border-radius: var(--r-full);
  padding: 18rpx 40rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.bnext.nok {
  color: var(--success-deep);
}

.bnext.nbad {
  color: var(--error-deep);
}

.done {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}

.done-pct {
  font-size: 80rpx;
  font-weight: 800;
  color: var(--brand-500);
  font-variant-numeric: tabular-nums;
}

.done-t {
  font-size: 34rpx;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.done-sub {
  font-size: 24rpx;
  color: var(--t3);
  margin-bottom: 12rpx;
}

.done-beat {
  font-size: 24rpx;
  color: var(--brand-500);
  margin-bottom: 20rpx;
}

.done .btn-primary,
.done .btn-ghost {
  align-self: stretch;
}

.done-quit {
  margin-top: 16rpx;
}

.share-op {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--brand-500);
  font-weight: 600;
}

.duenudge {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  align-self: stretch;
  background: var(--brand-grad-btn);
  border-radius: var(--r-l);
  padding: 22rpx 28rpx;
  margin-bottom: 20rpx;
}

.duenudge-l {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.duenudge-t {
  font-size: 27rpx;
  font-weight: 600;
  color: #fff;
}

.duenudge-s {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4rpx;
}

.duenudge-go {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--brand-500);
  background: #fff;
  border-radius: var(--r-full);
  padding: 10rpx 24rpx;
}
