<navbar title="{{moduleName}} · 专项练习" back="{{true}}" />
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="wrap">
    <view wx:if="{{loading}}" class="card spin">出题中…</view>

    <!-- 答题 -->
    <block wx:if="{{!loading && cur}}">
      <view class="p-head">
        <text class="p-idx"><text class="p-idx-b">{{idx + 1}}</text>/{{items.length}}</text>
        <view class="p-cnt">
          <text class="p-timer">{{timerText}}</text>
          <text class="cnt-ok">✓ {{right}}</text>
          <text class="cnt-bad">✗ {{wrongCount}}</text>
          <view class="font-btn" bind:tap="onCycleFont">A<text class="font-btn-lv">{{fontLabel}}</text></view>
        </view>
      </view>
      <view class="progress"><view class="pfill" style="width: {{(idx / items.length) * 100}}%" /></view>

      <view class="card">
        <view class="tagrow">
          <view wx:if="{{cur.is_real}}" class="tag tag-warn">真题{{cur.exam_year ? ' · ' + cur.exam_year : ''}}{{cur.exam_region ? ' · ' + cur.exam_region : ''}}</view>
          <view wx:if="{{cur.submodule}}" class="tag tag-brand">{{cur.submodule}}</view>
        </view>
        <text class="q" style="font-size: {{qFs}}rpx" user-select>{{cur.question}}</text>
        <view
          wx:for="{{cur.optList}}"
          wx:key="k"
          class="opt {{!picked ? '' : item.k === cur.answer ? 'right' : item.k === picked ? 'wrong' : 'dim'}}"
          data-key="{{item.k}}"
          bind:tap="onPick"
        >
          <text class="okey">{{item.k}}</text>
          <text class="otext" style="font-size: {{optFs}}rpx">{{item.v}}</text>
          <text wx:if="{{picked && item.k === cur.answer}}" class="omark good">✓</text>
          <text wx:elif="{{picked && item.k === picked}}" class="omark badm">✗</text>
        </view>
      </view>

      <!-- 解析卡 -->
      <view wx:if="{{picked}}" class="card exp-card">
        <view class="exp-ans-row">
          <text class="exp-ans-k">正确答案</text>
          <text class="exp-ans">{{cur.answer}}</text>
          <text wx:if="{{picked !== cur.answer}}" class="exp-mine">我的答案 {{picked}}</text>
        </view>
        <view wx:if="{{cur.hs_explanation}}" class="exp-block">
          <text class="exp-title hs">🥜 花生十三方法解析</text>
          <text class="exp-text" style="font-size: {{expFs}}rpx" user-select>{{cur.hs_explanation}}</text>
        </view>
        <view wx:if="{{cur.xp_explanation}}" class="exp-block">
          <text class="exp-title xp">👓 {{cur.xp_school || '第二名师视角'}}</text>
          <text class="exp-text" style="font-size: {{expFs}}rpx" user-select>{{cur.xp_explanation}}</text>
        </view>
        <view wx:if="{{cur.explanation}}" class="exp-block">
          <text class="exp-title pl">解析</text>
          <text class="exp-text" style="font-size: {{expFs}}rpx" user-select>{{cur.explanation}}</text>
        </view>
        <text wx:if="{{cur.source}}" class="exp-src">来源：{{cur.source}}</text>
        <view wx:if="{{cur.id}}" class="share-op" bind:tap="onShareQ">分享给队友，看 TA 能不能做对 ›</view>
      </view>

      <!-- 判分横幅 -->
      <view wx:if="{{picked}}" class="banner {{picked === cur.answer ? 'bok' : 'bbad'}}">
        <view class="b-l">
          <text class="btitle">{{picked === cur.answer ? '✓ 回答正确' : '✗ 回答错误'}}</text>
          <text class="bsub">{{picked === cur.answer ? '再接再厉，保持节奏' : '已自动加入错题本'}}</text>
        </view>
        <view class="bnext {{picked === cur.answer ? 'nok' : 'nbad'}}" bind:tap="onNext">
          {{idx + 1 < items.length ? '下一题' : '完成'}}
        </view>
      </view>
    </block>

    <!-- 结算 -->
    <view wx:if="{{finished}}" class="card done">
      <text class="done-pct">{{pct}}%</text>
      <text class="done-t">本组完成</text>
      <text class="done-sub">答对 {{right}}/{{items.length}} · 错题 {{wrongCount}} · 用时 {{totalSecs}}s</text>
      <text wx:if="{{percentile !== null}}" class="done-beat">本组正确率击败了 {{percentile}}% 的刷题记录</text>
      <view wx:if="{{dueReview > 0}}" class="duenudge" bind:tap="onGoReview">
        <view class="duenudge-l">
          <text class="duenudge-t">今日还有 {{dueReview}} 题到期待复习</text>
          <text class="duenudge-s">趁热打铁，按遗忘曲线巩固一遍</text>
        </view>
        <text class="duenudge-go">去复习 ›</text>
      </view>
      <view class="btn-primary" bind:tap="onRetry">再来一组</view>
      <view class="btn-ghost done-quit" bind:tap="onQuit">返回首页</view>
    </view>
  </view>
</scroll-view>
