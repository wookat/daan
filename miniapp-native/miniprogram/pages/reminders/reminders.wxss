.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 0;
}

.row.line {
  border-top: 1rpx solid var(--border);
  margin-top: 20rpx;
  padding-top: 24rpx;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.r-t {
  font-size: 28rpx;
  font-weight: 600;
}

.r-s {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

.time-v {
  font-size: 28rpx;
  color: var(--brand-500);
  font-weight: 700;
}

.preview {
  display: flex;
  flex-direction: column;
}

.pv-l {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--t3);
  margin-bottom: 14rpx;
}

.pv-box {
  background: var(--fill);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.pv-t {
  font-size: 26rpx;
  font-weight: 700;
}

.pv-b {
  font-size: 23rpx;
  color: var(--t3);
  margin-top: 8rpx;
  line-height: 1.6;
}

.sub-btn {
  background: var(--brand-500);
  color: #fff;
  border-radius: 999rpx;
  padding: 14rpx 36rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.sub-btn.dis {
  background: var(--fill);
  color: var(--t4);
}

.foot-tip {
  display: block;
  font-size: 22rpx;
  color: var(--t4);
  line-height: 1.7;
  padding: 8rpx 8rpx 0;
}
