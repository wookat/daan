.wrap {
  padding: var(--sp-12) var(--page-x) calc(var(--sp-40) + env(safe-area-inset-bottom));
}

/* 队伍 hero */
.hero {
  padding: var(--card-pad);
  border-radius: var(--r-lg);
  background: var(--brand-grad);
  color: var(--on-brand);
  margin-bottom: var(--card-gap);
  display: flex;
  flex-direction: column;
}

.hero-t {
  font-size: var(--fs-h1);
  font-weight: 600;
}

.hero-s {
  font-size: var(--fs-caption);
  color: var(--on-brand-2);
  margin-top: var(--sp-4);
}

.hero-btns {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-8);
  margin-top: var(--sp-12);
}


/* 排行 */
.rank-card {
  display: block;
  margin-bottom: var(--card-gap);
}

.rank-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-8);
}

.rank-t {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.rank-row {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  min-height: var(--hit-min);
}

.rank-row + .rank-row {
  border-top: 1px solid var(--line);
}

.rank-no {
  width: 22px;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink-3);
  text-align: center;
  flex-shrink: 0;
}

.rank-no.no1 {
  color: var(--streak);
}

.rank-no.no2 {
  color: var(--ink-2);
}

.rank-no.no3 {
  color: var(--warn-strong);
}

.rank-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-n {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  flex-shrink: 0;
}

/* 周视图表头 */
.week-head {
  display: flex;
  align-items: center;
  padding: 0 var(--card-pad);
  margin-bottom: var(--sp-8);
}

.wh-name {
  width: 44px;
  flex-shrink: 0;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.wh-days {
  flex: 1;
  display: flex;
  gap: var(--sp-4);
}

.wh-d {
  flex: 1;
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.wh-d.today {
  color: var(--brand-text);
  font-weight: 600;
}

/* 成员卡 */
.mem {
  display: block;
  margin-bottom: var(--card-gap);
}

.mem-top {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
}

.mem-av {
  width: 36px;
  height: 36px;
  border-radius: var(--r-full);
  background: var(--brand-soft);
  color: var(--brand-text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 600;
  flex-shrink: 0;
}

.mem-av.me {
  background: var(--brand);
  color: var(--on-brand);
}

.mem-l {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.mem-name-row {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  min-width: 0;
}

.mem-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mem-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}

.mem-week {
  display: flex;
  gap: var(--sp-4);
  margin-top: var(--sp-8);
  margin-left: 44px;
}

.wk-cell {
  flex: 1;
  height: 26px;
  border-radius: var(--r-xs);
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.wk-cell.done {
  background: var(--brand-soft);
}

.wk-cell.hot {
  background: var(--brand);
}

.wk-cell.hot .wk-n {
  color: var(--on-brand);
}

.wk-cell.today-empty {
  border: 1px dashed var(--brand);
}

.wk-cell.future {
  background: transparent;
  border: 1px dashed var(--line);
}

.wk-n {
  font-size: var(--fs-caption);
  color: var(--brand-text);
  font-weight: 600;
}

@media (min-width: 1024px) {
  .wrap {
    max-width: 760px;
    margin: 0 auto;
  }
}
