.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: var(--sp-12) var(--page-x) calc(var(--sp-40) + env(safe-area-inset-bottom));
}

.hero {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  padding: var(--card-pad);
  border-radius: var(--r-lg);
  background: var(--brand-grad);
  color: var(--on-brand);
  margin-bottom: var(--card-gap);
}

.hero-ico {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  border-radius: var(--r-md);
  background: var(--brand-press);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-txt {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.hero-t {
  font-size: var(--fs-h2);
  font-weight: 600;
}

.hero-s {
  font-size: var(--fs-caption);
  color: var(--on-brand-2);
  margin-top: 2px;
}

.t-row {
  display: block;
  margin-bottom: var(--card-gap);
}

.t-l {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.t-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.t-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}

.join {
  display: block;
  margin-top: var(--card-gap);
}

.join-t {
  display: block;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: var(--sp-8);
}

.join-row {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
}

.join-input {
  flex: 1;
  min-width: 0;
  border-radius: var(--r-sm);
  background: var(--fill);
  --td-input-vertical-padding: var(--sp-8);
  --td-input-bg-color: var(--fill);
}

/* 创建小队 sheet */
.sheet {
  background: var(--card);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: var(--sp-8) var(--page-x) calc(var(--sp-16) + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: var(--sp-12);
  box-sizing: border-box;
}

.sheet-handle {
  width: 36px;
  height: 4px;
  border-radius: var(--r-full);
  background: var(--line-strong);
  margin: 0 auto;
}

.sheet-t {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  text-align: center;
}

.sheet-input {
  border-radius: var(--r-sm);
  background: var(--fill);
  --td-input-bg-color: var(--fill);
}

@media (min-width: 1024px) {
  .wrap {
    max-width: 640px;
    margin: 0 auto;
  }
}
