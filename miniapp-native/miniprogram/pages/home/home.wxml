<navbar title="刷题" />
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="wrap">
    <!-- 全局搜索入口 -->
    <view class="searchbar" bind:tap="onSearch">
      <text class="s-ico">🔍</text>
      <text class="s-ph">搜题目 / 知识点 / 试卷</text>
    </view>

    <!-- 今日目标 hero -->
    <view class="hero">
      <view class="hero-top">
        <text class="hero-t">今日已练 <text class="hero-n">{{today}}</text>/{{goal}} 题</text>
        <text class="hero-streak" wx:if="{{streak > 0}}">🔥 连续刷题 {{streak}} 天</text>
      </view>
      <view class="hero-bar"><view class="hero-fill" style="width: {{goalPct}}%" /></view>
      <view class="hero-btns">
        <view class="hero-go" bind:tap="onContinueGoal">继续目标 ›</view>
        <view class="hero-chips">
          <text
            wx:for="{{goalChips}}"
            wx:key="*this"
            class="hero-chip {{goal === item ? 'on' : ''}}"
            data-goal="{{item}}"
            bind:tap="onSetGoal"
          >{{item}}题</text>
        </view>
      </view>
    </view>

    <!-- 学习计划卡 -->
    <view class="card" wx:if="{{hasProfile && planTasks.length}}">
      <view class="plan-h">
        <text class="plan-t">今日学习计划</text>
        <view class="plan-h-r">
          <text class="plan-days" wx:if="{{daysLeft !== null}}">距考试 {{daysLeft}} 天</text>
          <text class="plan-edit" bind:tap="onOpenSetup">调整 ›</text>
        </view>
      </view>
      <view class="plan-prog">
        <view class="plan-bar"><view class="plan-fill" style="width: {{planPct}}%" /></view>
        <text class="plan-pct">{{planPct}}%</text>
      </view>
      <view
        wx:for="{{planTasks}}"
        wx:key="index"
        class="plan-row"
        data-index="{{index}}"
        bind:tap="onPlanTask"
      >
        <view class="task-ck {{item.done ? 'on' : ''}}">{{item.done ? '✓' : ''}}</view>
        <text class="plan-txt {{item.done ? 'tdone' : ''}}">{{item.title || '练习任务'}}</text>
        <text class="plan-go" wx:if="{{!item.done}}">去完成 ›</text>
      </view>
    </view>

    <!-- 未设置计划时的引导卡 -->
    <view class="card plan-empty" wx:if="{{profileLoaded && !hasProfile}}" bind:tap="onOpenSetup">
      <view class="pe-main">
        <text class="pe-t">📋 定制你的学习计划</text>
        <text class="pe-s">3 步设置考试信息，每天生成专属任务</text>
      </view>
      <view class="pe-btn">去设置</view>
    </view>

    <!-- 时政每日一练 -->
    <view class="card sz-card">
      <view class="sz-main" bind:tap="onShizheng">
        <text class="sz-t">📰 时政每日一练</text>
        <text class="sz-s">{{szDone ? '今日已完成 · 答对 ' + szRight + ' 题，点击回顾' : '每天 10 题新鲜时政，常识提分利器'}}</text>
      </view>
      <view class="sz-btns">
        <text class="sz-go" bind:tap="onShizheng">{{szDone ? '回顾 ›' : '去练 ›'}}</text>
        <text class="sz-fav-link" bind:tap="onSzFavs">⭐ 收藏</text>
      </view>
    </view>

    <!-- AI 与对战 -->
    <view class="sec-h"><text class="sec-t">AI 与对战</text></view>
    <view class="feat-grid">
      <view class="fcard" data-url="/pages/ask/ask" bind:tap="onFeature">
        <text class="f-ico">🤖</text>
        <text class="f-name">AI 问答</text>
        <text class="f-sub">拍题秒讲</text>
      </view>
      <view class="fcard" data-url="/pages/interview/interview" bind:tap="onFeature">
        <text class="f-ico">🎤</text>
        <text class="f-name">AI 面试</text>
        <text class="f-sub">五维打分</text>
      </view>
      <view class="fcard" data-url="/pages/pk/pk" bind:tap="onFeature">
        <text class="f-ico">⚔️</text>
        <text class="f-name">答题 PK</text>
        <text class="f-sub">限时对战</text>
      </view>
      <view class="fcard" data-url="/pages/shenlun/shenlun" bind:tap="onFeature">
        <text class="f-ico">✍️</text>
        <text class="f-name">申论</text>
        <text class="f-sub">AI 批改</text>
      </view>
    </view>

    <!-- 专项练习入口 -->
    <view class="sec-h"><text class="sec-t">专项练习</text></view>
    <view class="grid">
      <view
        wx:for="{{mods}}"
        wx:key="key"
        class="mcard"
        data-mod="{{item.key}}"
        bind:tap="onStartModule"
      >
        <view class="mico" style="background: {{item.bg}}; color: {{item.color}}">{{item.name[0]}}</view>
        <text class="mname">{{item.name}}</text>
      </view>
    </view>
  </view>
</scroll-view>

<!-- 学习计划三步设置弹层 -->
<view wx:if="{{setupVisible}}" class="mask" bind:tap="onCloseSetup">
  <view class="sheet" catch:tap="noop">
    <view class="st-h">
      <text class="st-t">学习计划设置</text>
      <text class="st-step">{{setupStep + 1}}/3</text>
    </view>
    <view class="st-dots">
      <view class="st-dot {{setupStep >= 0 ? 'on' : ''}}" />
      <view class="st-dot {{setupStep >= 1 ? 'on' : ''}}" />
      <view class="st-dot {{setupStep >= 2 ? 'on' : ''}}" />
    </view>

    <block wx:if="{{setupStep === 0}}">
      <view class="st-l">考试类型</view>
      <view class="chips">
        <text wx:for="{{examTypes}}" wx:key="*this" class="set-chip {{pf.exam_type === item ? 'on' : ''}}" data-v="{{item}}" bind:tap="onPickExamType">{{item}}</text>
      </view>
      <view class="st-l">报考地区（选填）</view>
      <input class="st-input" value="{{pf.target_region}}" placeholder="如：山东、广东" bind:input="onRegionInput" />
      <view class="st-l">考试日期</view>
      <picker mode="date" start="{{todayStr}}" value="{{pf.exam_date}}" bind:change="onPickDate">
        <view class="st-date {{pf.exam_date ? '' : 'empty'}}">{{pf.exam_date || '选择日期 ›'}}</view>
      </picker>
    </block>

    <block wx:elif="{{setupStep === 1}}">
      <view class="st-l">目标分数</view>
      <view class="chips">
        <text wx:for="{{scores}}" wx:key="*this" class="set-chip {{pf.target_score === item ? 'on' : ''}}" data-v="{{item}}" bind:tap="onPickScore">{{item}}+</text>
      </view>
      <view class="st-l">当前基础</view>
      <view class="chips">
        <text wx:for="{{levels}}" wx:key="*this" class="set-chip {{pf.base_level === item ? 'on' : ''}}" data-v="{{item}}" bind:tap="onPickLevel">{{item}}</text>
      </view>
    </block>

    <block wx:else>
      <view class="st-l">每天学习时长</view>
      <view class="chips">
        <text wx:for="{{minutes}}" wx:key="*this" class="set-chip {{pf.daily_minutes === item ? 'on' : ''}}" data-v="{{item}}" bind:tap="onPickMinutes">{{item}} 分钟</text>
      </view>
      <view class="st-sum">{{pf.exam_type}}{{pf.target_region ? ' · ' + pf.target_region : ''}} · {{pf.exam_date}} · 目标 {{pf.target_score}}+ · {{pf.base_level}} · 每天 {{pf.daily_minutes}} 分钟</view>
    </block>

    <view class="st-btns">
      <view wx:if="{{setupStep > 0}}" class="st-btn ghost" bind:tap="onSetupPrev">上一步</view>
      <view class="st-btn primary {{saving ? 'dis' : ''}}" bind:tap="onSetupNext">{{setupStep < 2 ? '下一步' : (saving ? '生成中…' : '生成计划')}}</view>
    </view>
  </view>
</view>
