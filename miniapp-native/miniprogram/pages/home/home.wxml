<navbar class="{{tc}}" title="刷题" large>
  <view class="nav-icon-btn" hover-class="nav-icon-btn--hover" role="button" aria-label="搜索题目、考点、试卷" bind:tap="onSearch">
    <l-icon name="search" size="24" tone="ink" />
  </view>
</navbar>
<scroll-view class="{{tc}} page-scroll" scroll-y type="list">
  <view class="wrap">
    <!-- 焦点：一句话 + 格点进度（每格 1 题）+ 唯一主按钮 -->
    <view class="focus">
      <text class="focus-t">{{today >= goal ? '今日目标已完成' : today > 0 ? '还差 ' + (goal - today) + ' 题完成今日目标' : '今天从 ' + goal + ' 题开始'}}</text>
      <view class="focus-dots"><kg-dots value="{{today}}" max="{{goal}}" aria-label="今日目标进度" /></view>
      <view class="focus-meta">
        <text class="num">{{today}}/{{goal}} 题</text>
        <text wx:if="{{badgeStreak || streak}}" class="focus-sep">连续 {{badgeStreak || streak}} 天</text>
        <text class="focus-goal" hover-class="focus-goal--hover" role="button" aria-label="修改每日目标" bind:tap="onPickGoal">目标 {{goal}} 题</text>
      </view>
      <kg-button variant="primary" size="lg" block bind:click="onContinueGoal">{{today >= goal ? '再练一组' : '继续练习'}}</kg-button>
    </view>

    <!-- 公告：一行灰字，可关 -->
    <view wx:if="{{announce}}" class="notice">
      <text class="notice-t">{{announce.title}}{{announce.body ? '：' + announce.body : ''}}</text>
      <view class="notice-x" role="button" aria-label="关闭公告" hover-class="notice-x--hover" bind:tap="onDismissAnn"><l-icon name="x" size="16" tone="muted" /></view>
    </view>

    <!-- 未完成：有则显示，作为「今日」组的前置组 -->
    <kg-group wx:if="{{examResume || practiceResume || reviewResume}}" title="未完成">
      <kg-row wx:if="{{examResume}}" title="{{examResume.title}}" desc="{{'模考 已答 ' + examResume.answered + '/' + examResume.total + ' 题　剩余 ' + examResume.leftText}}" value="继续" value-tone="brand" chevron="{{false}}" last="{{!practiceResume && !reviewResume}}" bind:click="onErContinue">
        <view class="rs-x" role="button" aria-label="放弃未交卷进度" hover-class="rs-x--hover" catch:tap="onErDrop"><l-icon name="x" size="16" tone="faint" /></view>
      </kg-row>
      <kg-row wx:if="{{practiceResume}}" title="{{practiceResume.name}}" desc="{{'练习 已做 ' + practiceResume.done + '/' + practiceResume.total + ' 题'}}" value="继续" value-tone="brand" chevron="{{false}}" last="{{!reviewResume}}" bind:click="onPrContinue">
        <view class="rs-x" role="button" aria-label="放弃未完成练习" hover-class="rs-x--hover" catch:tap="onPrDrop"><l-icon name="x" size="16" tone="faint" /></view>
      </kg-row>
      <kg-row wx:if="{{reviewResume}}" title="错题复习" desc="{{'中断在第 ' + (reviewResume.rIdx + 1) + '/' + reviewResume.items.length + ' 题'}}" value="继续" value-tone="brand" chevron="{{false}}" last bind:click="onRvContinue">
        <view class="rs-x" role="button" aria-label="放弃未完成复习" hover-class="rs-x--hover" catch:tap="onRvDrop"><l-icon name="x" size="16" tone="faint" /></view>
      </kg-row>
    </kg-group>

    <!-- 今日：复习 / 打卡 / 计划 / 时政，四行一组 -->
    <kg-group title="今日">
      <kg-row icon="rotate-ccw" title="错题复习" desc="{{dueReview ? '今日到期 ' + dueReview + ' 题' : !dueLoaded ? '按遗忘曲线安排' : clearedToday ? '今日已清零' : '暂无到期错题'}}" value="{{dueReview ? '去复习' : ''}}" value-tone="brand" bind:click="onReviewEntry" />
      <kg-row icon="flame" title="每日打卡" desc="{{nextMilestone ? '再打卡 ' + nextMilestone.left + ' 天解锁「' + nextMilestone.days + ' 天」徽章' : '已解锁全部打卡徽章'}}" value="{{today > 0 ? '已打卡' : ''}}" value-tone="ok" bind:click="onCalendar" />
      <kg-row wx:if="{{hasProfile}}" icon="calendar-check" title="学习计划" desc="{{(daysText ? daysText + '　' : '') + '今日 ' + planDone + '/' + planTotal}}" value="{{planTasks.length && planDone < planTotal ? '去完成' : ''}}" value-tone="brand" bind:click="onGoPlan" />
      <kg-row wx:elif="{{planLoaded && !guideHide}}" icon="calendar-check" title="学习计划" desc="按考试日期倒排每日任务" value="去制定" value-tone="brand" bind:click="onOpenSetup" />
      <kg-row icon="newspaper" title="时政每日一练" desc="每日 10 题　全站同题" value="{{szTodayDone ? '已完成' : '今日更新'}}" value-tone="{{szTodayDone ? 'ok' : 'warn'}}" last bind:click="onShizheng" />
    </kg-group>

    <!-- 练习方式：4 格入口，只放去处 -->
    <kg-group title="练习">
      <kg-grid4 items="{{quick}}" bind:click="onQuick" />
    </kg-group>

    <!-- 专项：一模块一行 -->
    <kg-group title="专项练习" more="筛选" to="/pkgLearn/setup/setup">
      <kg-row wx:for="{{mods}}" wx:key="key" icon="{{item.icon}}" title="{{item.name}}" value="{{item.count}}" last="{{index === mods.length - 1}}" data-mod="{{item.key}}" bind:click="onStartModule" />
    </kg-group>
  </view>
</scroll-view>

<!-- 学习计划 sheet：今日任务 + 今日主攻，从首屏收进浮层 -->
<t-popup class="{{tc}}" visible="{{planOpen}}" placement="bottom" bind:visible-change="onPlanVisible">
  <view class="sheet">
    <view class="sheet-handle" />
    <view class="sheet-h">
      <text class="sheet-t">学习计划{{daysTitle ? '　' + daysTitle : ''}}</text>
      <view class="sheet-x" hover-class="sheet-x--hover" bind:tap="onClosePlan"><l-icon name="x" size="24" tone="muted" /></view>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <text class="sheet-st">今日任务　{{planDone}}/{{planTotal}}{{phaseName ? '　' + phaseName : ''}}</text>
      <view class="plan-list">
        <kg-row wx:for="{{planTasks}}" wx:key="key" icon="{{item.icon}}" tone="{{item.done ? 'ok' : 'ink-2'}}" title="{{item.title}}" desc="{{item.subText}}" value="{{item.goText}}" value-tone="{{item.done ? 'muted' : 'brand'}}" chevron="{{false}}" last="{{index === planTasks.length - 1}}" data-index="{{index}}" bind:click="onPlanTask" />
      </view>
      <text class="sheet-st">今天主攻</text>
      <view class="sheet-chips"><kg-chip-row size="sm" options="{{focusOpts}}" value="{{focus}}" scroll-to-selected="{{false}}" bind:change="onFocus" /></view>
    </scroll-view>
    <view class="sheet-acts">
      <kg-button variant="text" size="md" block bind:click="onPlanEdit">编辑计划</kg-button>
    </view>
  </view>
</t-popup>

<!-- 制定学习计划 sheet -->
<t-popup class="{{tc}}" visible="{{setupOpen}}" placement="bottom" bind:visible-change="onSetupVisible">
  <view class="sheet">
    <view class="sheet-handle" />
    <view class="sheet-h">
      <text class="sheet-t">制定学习计划 · {{setupStep === 1 ? '考试信息' : setupStep === 2 ? '目标' : '每日时长'}}（{{setupStep}}/3）</text>
      <view class="sheet-x" hover-class="sheet-x--hover" bind:tap="onCloseSetup"><l-icon name="x" size="24" tone="muted" /></view>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <block wx:if="{{setupStep === 1}}">
        <text class="sheet-st">考试类型</text>
        <view class="sheet-chips"><kg-chip-row options="{{examTypeOpts}}" value="{{pf.exam_type}}" data-key="exam_type" bind:change="onPfChip" /></view>
        <text class="sheet-st">目标地区</text>
        <view class="pf-field">
          <t-input borderless value="{{pf.target_region}}" placeholder="如 广东 / 全国（选填）" maxlength="{{20}}" bind:change="onPfRegion" />
        </view>
        <text class="sheet-st">考试日期</text>
        <picker mode="date" value="{{pf.exam_date}}" start="{{dateStart}}" end="{{dateEnd}}" bind:change="onPfDate">
          <view class="pf-date {{pf.exam_date ? '' : 'empty'}} {{pfDatePast ? 'past' : ''}}">
            <text>{{pfDateText}}</text>
            <l-icon name="chevron-right" size="20" tone="faint" />
          </view>
        </picker>
      </block>
      <block wx:elif="{{setupStep === 2}}">
        <text class="sheet-st">目标分</text>
        <view class="sheet-chips"><kg-chip-row options="{{scoreOpts}}" value="{{pf.target_score}}" data-key="target_score" bind:change="onPfChip" /></view>
        <text class="sheet-st">基础自评</text>
        <view class="sheet-chips"><kg-chip-row options="{{baseLevelOpts}}" value="{{pf.base_level}}" data-key="base_level" bind:change="onPfChip" /></view>
      </block>
      <block wx:else>
        <text class="sheet-st">每日可用时长（决定每日任务量）</text>
        <view class="sheet-chips"><kg-chip-row options="{{minuteOpts}}" value="{{pf.daily_minutes}}" data-key="daily_minutes" bind:change="onPfChip" /></view>
        <view class="pf-summary">{{pf.exam_type}}{{pf.target_region ? ' · ' + pf.target_region : ''}} · {{pf.exam_date}} · 目标 {{pf.target_score}}+ · {{pf.base_level}} · 每天 {{pf.daily_minutes}} 分钟</view>
      </block>
    </scroll-view>
    <view class="sheet-acts">
      <kg-button variant="primary" size="lg" block loading="{{setupBusy}}" bind:click="onSetupNext">{{setupStep < 3 ? '下一步' : '生成我的学习计划'}}</kg-button>
      <kg-button wx:if="{{setupStep > 1}}" variant="text" size="md" block bind:click="onSetupBack">上一步</kg-button>
    </view>
  </view>
</t-popup>
