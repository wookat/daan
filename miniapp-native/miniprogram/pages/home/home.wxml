<view class="hero-bleed"><view class="bleed-c1" /><view class="bleed-c2" /></view>
<navbar title="刷题" brand />
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="wrap">
    <!-- 全局搜索入口（H5 toprow） -->
    <view class="searchbar" hover-class="searchbar--hover" aria-role="button" bind:tap="onSearch">
      <l-icon name="search" size="16" tone="on-brand" />
      <text class="searchbar-t">搜题目 / 考点 / 试卷</text>
    </view>
    <!-- 今日目标 hero（kg-hero-card 小程序版未落地，页内按 COMPONENTS §2.5 结构实现） -->
    <view class="hero">
      <view class="hero-deco" />
      <view class="hero-top">
        <text class="hero-label">今日已练</text>
        <view class="hero-streak" wx:if="{{badgeStreak || streak}}">
          <l-icon name="flame" size="16" tone="on-brand" />
          <text>连续刷题 {{badgeStreak || streak}} 天</text>
        </view>
      </view>
      <view class="hero-num-row">
        <text class="hero-n num">{{today}}</text>
        <text class="hero-goal">/ {{goal}} 题</text>
      </view>
      <view class="hero-prog"><kg-progress value="{{today}}" max="{{goal}}" thickness="{{4}}" inverse aria-label="今日目标进度" /></view>
      <view class="hero-btns">
        <kg-button variant="primary" tone="inverse" size="md" icon="chevron-right" bind:click="onContinueGoal">继续目标</kg-button>
        <view class="hero-chips">
          <view
            wx:for="{{goalChips}}"
            wx:key="*this"
            class="hero-chip {{goal === item ? 'on' : ''}}"
            data-goal="{{item}}"
            hover-class="hero-chip--hover"
            bind:tap="onSetGoal"
          >{{item}}题</view>
        </view>
      </view>
    </view>

    <!-- 续做卡（H5 resumes） -->
    <view wx:if="{{examResume || practiceResume || reviewResume}}" class="resumes">
      <kg-card wx:if="{{examResume}}" variant="raised" padding="{{12}}">
        <view class="rs-row">
          <view class="rs-main">
            <text class="rs-t">有一场未交卷的模考</text>
            <text class="rs-s">{{examResume.title}} · 已答 {{examResume.answered}}/{{examResume.total}} 题 · 剩余 <text class="num">{{examResume.leftText}}</text></text>
          </view>
          <kg-button variant="text" size="sm" aria-label="继续未交卷的模考" bind:click="onErContinue">去继续 ›</kg-button>
          <view class="rs-x" aria-role="button" aria-label="放弃未交卷进度" hover-class="rs-x--hover" bind:tap="onErDrop"><l-icon name="x" size="16" tone="muted" /></view>
        </view>
      </kg-card>
      <kg-card wx:if="{{practiceResume}}" variant="raised" padding="{{12}}">
        <view class="rs-row">
          <view class="rs-main">
            <text class="rs-t">有一组未做完的练习</text>
            <text class="rs-s">{{practiceResume.name}} · 已做 {{practiceResume.done}}/{{practiceResume.total}} 题</text>
          </view>
          <kg-button variant="text" size="sm" bind:click="onPrContinue">去继续 ›</kg-button>
          <view class="rs-x" aria-role="button" aria-label="放弃未完成练习" hover-class="rs-x--hover" bind:tap="onPrDrop"><l-icon name="x" size="16" tone="muted" /></view>
        </view>
      </kg-card>
      <kg-card wx:if="{{reviewResume}}" variant="raised" padding="{{12}}">
        <view class="rs-row">
          <view class="rs-main">
            <text class="rs-t">有一次未完成的错题复习</text>
            <text class="rs-s">中断在第 {{reviewResume.rIdx + 1}}/{{reviewResume.items.length}} 题</text>
          </view>
          <kg-button variant="text" size="sm" bind:click="onRvContinue">去继续 ›</kg-button>
          <view class="rs-x" aria-role="button" aria-label="放弃未完成复习" hover-class="rs-x--hover" bind:tap="onRvDrop"><l-icon name="x" size="16" tone="muted" /></view>
        </view>
      </kg-card>
    </view>

    <!-- 今日任务三件套 -->
    <kg-card variant="raised" class="taskcard">
      <view class="tk-h">
        <text class="tk-t">今日任务</text>
        <kg-progress shape="ring" size="{{48}}" value="{{taskDoneN}}" max="{{3}}" label="{{taskDoneN}}/3" aria-label="今日任务完成数" />
      </view>
      <view class="tk-row" data-kind="practice" hover-class="tk-row--hover" bind:tap="onTaskGo">
        <view class="tk-ck {{today >= goal ? 'on' : ''}}"><l-icon wx:if="{{today >= goal}}" name="check" size="16" tone="on-brand" /></view>
        <view class="tk-main">
          <text class="tk-name {{today >= goal ? 'tdone' : ''}}">刷题目标</text>
          <text class="tk-sub">已练 {{today}}/{{goal}} 题</text>
        </view>
        <text class="tk-go">{{today >= goal ? '再练一组' : '去刷题'}}</text>
      </view>
      <view class="tk-row" data-kind="review" hover-class="tk-row--hover" bind:tap="onTaskGo">
        <view class="tk-ck {{dueLoaded && !dueReview ? 'on' : ''}}"><l-icon wx:if="{{dueLoaded && !dueReview}}" name="check" size="16" tone="on-brand" /></view>
        <view class="tk-main">
          <text class="tk-name {{dueLoaded && !dueReview ? 'tdone' : ''}}">错题复习</text>
          <text class="tk-sub">{{dueReview ? '今日到期 ' + dueReview + ' 题' : !dueLoaded ? '按遗忘曲线安排' : clearedToday ? '今日已清零' : '暂无到期错题'}}</text>
        </view>
        <text class="tk-go">{{dueReview ? '去复习' : '错题本'}}</text>
      </view>
      <view class="tk-row" data-kind="checkin" hover-class="tk-row--hover" bind:tap="onTaskGo">
        <view class="tk-ck {{today > 0 ? 'on' : ''}}"><l-icon wx:if="{{today > 0}}" name="check" size="16" tone="on-brand" /></view>
        <view class="tk-main">
          <view class="tk-name-row">
            <text class="tk-name {{today > 0 ? 'tdone' : ''}}">每日打卡</text>
            <view wx:if="{{badgeStreak || streak}}" class="tk-streak">
              <l-icon name="flame" size="16" tone="streak" />
              <text>连续 {{badgeStreak || streak}} 天</text>
            </view>
          </view>
          <block wx:if="{{nextMilestone}}">
            <view class="tk-bar"><kg-progress value="{{nextMilestone.pct}}" max="{{100}}" thickness="{{4}}" aria-label="下一徽章进度" /></view>
            <text class="tk-sub">再打卡 {{nextMilestone.left}} 天解锁「{{nextMilestone.days}} 天」徽章</text>
          </block>
          <text wx:else class="tk-sub">已解锁全部打卡徽章，太强了！</text>
        </view>
        <text class="tk-go">徽章</text>
      </view>
    </kg-card>

    <!-- 今日到期复习卡 -->
    <view wx:if="{{dueReview > 0}}" class="duebar" hover-class="duebar--hover" bind:tap="onReviewEntry">
      <view class="duebar-ico"><l-icon name="alarm-clock" size="20" tone="streak" /></view>
      <view class="duebar-l">
        <text class="duebar-t">今日到期复习 {{dueReview}} 题</text>
        <text class="duebar-s">按遗忘曲线安排 · 越拖越忘</text>
      </view>
      <kg-button variant="primary" size="sm" bind:click="onReviewEntry">去复习</kg-button>
    </view>
    <view wx:elif="{{dueLoaded && clearedToday}}" class="duebar donebar">
      <view class="duebar-ico ok"><l-icon name="circle-check" size="20" tone="ok" /></view>
      <view class="duebar-l">
        <text class="duebar-t">今日复习已清零</text>
        <text class="duebar-s">到期错题已全部复习完，继续刷新题吧</text>
      </view>
    </view>

    <!-- 制定学习计划引导卡 -->
    <view wx:if="{{planLoaded && !hasProfile && !guideHide}}" class="guide" hover-class="guide--hover" bind:tap="onOpenSetup">
      <view class="guide-l">
        <text class="guide-t">制定我的学习计划</text>
        <text class="guide-s">按考试日期倒排每日任务：专项练习 + 错题复习 + 每周模考</text>
      </view>
      <kg-button variant="primary" size="sm" bind:click="onOpenSetup">去制定</kg-button>
      <view class="guide-x" catch:tap="onSkipGuide">跳过</view>
    </view>

    <!-- 学习计划卡 -->
    <kg-card variant="raised" class="plancard" wx:if="{{hasProfile && planTasks.length}}">
      <view class="plan-h">
        <text class="plan-t">今日学习计划</text>
        <kg-tag wx:if="{{daysLeft !== null}}" tone="bad">距考试 {{daysLeft}} 天</kg-tag>
      </view>
      <view class="plan-prog">
        <view class="plan-bar"><kg-progress value="{{planPct}}" max="{{100}}" thickness="{{4}}" aria-label="今日计划完成度" /></view>
        <text class="plan-pct num">{{planPct}}%</text>
      </view>
      <view
        wx:for="{{planTasks}}"
        wx:key="index"
        class="plan-row"
        data-index="{{index}}"
        hover-class="tk-row--hover"
        bind:tap="onPlanTask"
      >
        <view class="tk-ck {{item.done ? 'on' : ''}}"><l-icon wx:if="{{item.done}}" name="check" size="16" tone="on-brand" /></view>
        <text class="plan-txt {{item.done ? 'tdone' : ''}}">{{item.title || '练习任务'}}</text>
        <text class="plan-go" wx:if="{{!item.done}}">去完成</text>
      </view>
    </kg-card>

    <!-- 专项练习入口（kg-module-card 小程序版未落地，页内按 §2.2 一行式实现） -->
    <kg-section-header title="专项练习" more="题型/真题筛选" to="/pkgLearn/setup/setup" />
    <view class="grid">
      <view
        wx:for="{{mods}}"
        wx:key="key"
        class="mcard"
        data-mod="{{item.key}}"
        hover-class="mcard--hover"
        bind:tap="onStartModule"
      >
        <view class="mico" style="background: {{item.soft}}; color: {{item.color}}"><l-icon name="{{item.icon}}" size="24" tone="inherit" /></view>
        <view class="m-main">
          <text class="mname">{{item.name}}</text>
          <text class="mcount">{{item.count}}</text>
        </view>
        <l-icon class="m-arrow" name="chevron-right" size="20" tone="faint" />
      </view>
    </view>
    <!-- 更多练习（对齐 H5 首页 more-grid：模考 / 申论 / 错题重练 / 拍题讲解） -->
    <kg-section-header title="更多练习" />
    <view class="more-grid">
      <kg-card variant="raised" clickable class="more-c" bind:click="onGoExamList">
        <view class="more-ico"><l-icon name="timer" size="24" tone="brand" /></view>
        <text class="more-t">模考</text>
        <text class="more-s">迷你 / 全真 · 成绩报告</text>
      </kg-card>
      <kg-card variant="raised" clickable class="more-c" bind:click="onGoShenlun">
        <view class="more-ico"><l-icon name="pen-line" size="24" tone="brand" /></view>
        <text class="more-t">申论</text>
        <text class="more-s">真题 + AI 采分点批改</text>
      </kg-card>
      <kg-card variant="raised" clickable class="more-c" bind:click="onGoBook">
        <view class="more-ico"><l-icon name="rotate-ccw" size="24" tone="brand" /></view>
        <text class="more-t">错题重练</text>
        <text class="more-s">遗忘曲线 · 今日复习</text>
      </kg-card>
      <kg-card variant="raised" clickable class="more-c" bind:click="onAsk">
        <view class="more-ico"><l-icon name="camera" size="24" tone="brand" /></view>
        <text class="more-t">拍题讲解</text>
        <text class="more-s">花生十三方法体系</text>
      </kg-card>
    </view>
  </view>
</scroll-view>

<!-- 制定学习计划 sheet -->
<t-popup visible="{{setupOpen}}" placement="bottom" bind:visible-change="onSetupVisible">
  <view class="sheet">
    <view class="sheet-handle" />
    <view class="sheet-h">
      <text class="sheet-t">制定学习计划 · {{setupStep === 1 ? '考试信息' : setupStep === 2 ? '目标' : '每日时长'}}（{{setupStep}}/3）</text>
      <view class="sheet-x" hover-class="sheet-x--hover" bind:tap="onCloseSetup"><l-icon name="x" size="24" tone="muted" /></view>
    </view>
    <scroll-view class="sheet-body" scroll-y>
      <block wx:if="{{setupStep === 1}}">
        <text class="sheet-st">考试类型</text>
        <view class="sheet-chips"><kg-chip-row options="{{examTypeOpts}}" value="{{pf.exam_type}}" data-key="exam_type" bind:change="onPfChip" /></view>
        <text class="sheet-st">目标地区</text>
        <view class="pf-field">
          <t-input borderless value="{{pf.target_region}}" placeholder="如 广东 / 全国（选填）" maxlength="{{20}}" bind:change="onPfRegion" />
        </view>
        <text class="sheet-st">考试日期</text>
        <picker mode="date" value="{{pf.exam_date}}" start="{{dateStart}}" end="{{dateEnd}}" bind:change="onPfDate">
          <view class="pf-date {{pf.exam_date ? '' : 'empty'}}">
            <text>{{pf.exam_date || '选择日期'}}</text>
            <l-icon name="chevron-right" size="20" tone="faint" />
          </view>
        </picker>
      </block>
      <block wx:elif="{{setupStep === 2}}">
        <text class="sheet-st">目标分</text>
        <view class="sheet-chips"><kg-chip-row options="{{scoreOpts}}" value="{{pf.target_score}}" data-key="target_score" bind:change="onPfChip" /></view>
        <text class="sheet-st">基础自评</text>
        <view class="sheet-chips"><kg-chip-row options="{{baseLevelOpts}}" value="{{pf.base_level}}" data-key="base_level" bind:change="onPfChip" /></view>
      </block>
      <block wx:else>
        <text class="sheet-st">每日可用时长（决定每日任务量）</text>
        <view class="sheet-chips"><kg-chip-row options="{{minuteOpts}}" value="{{pf.daily_minutes}}" data-key="daily_minutes" bind:change="onPfChip" /></view>
        <view class="pf-summary">{{pf.exam_type}}{{pf.target_region ? ' · ' + pf.target_region : ''}} · {{pf.exam_date}} · 目标 {{pf.target_score}}+ · {{pf.base_level}} · 每天 {{pf.daily_minutes}} 分钟</view>
      </block>
    </scroll-view>
    <view class="sheet-acts">
      <kg-button variant="primary" size="lg" block loading="{{setupBusy}}" bind:click="onSetupNext">{{setupStep < 3 ? '下一步' : '生成我的学习计划'}}</kg-button>
      <kg-button wx:if="{{setupStep > 1}}" variant="text" size="md" block bind:click="onSetupBack">上一步</kg-button>
    </view>
  </view>
</t-popup>
