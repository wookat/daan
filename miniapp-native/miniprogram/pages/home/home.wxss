/* 首页 v3 贴皮：白头大标题 + 焦点句 + 三组。页面级不写阴影/渐变，分区靠留白与灰字标题。 */
.wrap {
  padding: var(--sp-8) var(--page-x) calc(var(--tab-h) + var(--sp-24) + env(safe-area-inset-bottom));
}

/* 焦点：一句话 + 格点进度 + 唯一主按钮 */
.focus {
  padding: var(--sp-8) var(--sp-4) var(--sp-4);
}

.focus-t {
  display: block;
  font-size: var(--fs-h2);
  font-weight: 600;
  line-height: 1.35;
  color: var(--ink);
  letter-spacing: 0;
}

.focus-dots {
  margin: var(--sp-16) 0 var(--sp-12);
}

.focus-meta {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
  font-size: var(--fs-sub);
  color: var(--ink-3);
  margin-bottom: var(--sp-16);
}

.focus-goal {
  margin-left: auto;
  color: var(--brand-text);
  padding: var(--sp-8) 0;
  margin-top: calc(-1 * var(--sp-8));
  margin-bottom: calc(-1 * var(--sp-8));
}

.focus-goal--hover {
  opacity: 0.6;
}

/* 公告：一行灰字 */
.notice {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  margin-top: var(--sp-16);
  padding: 0 var(--sp-4);
  font-size: var(--fs-sub);
  color: var(--ink-3);
}

.notice-t {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-x {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
}

.notice-x--hover {
  background: var(--fill);
}

/* 未完成行的放弃按钮 */
.rs-x {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
  margin-right: calc(-1 * var(--sp-8));
}

.rs-x--hover {
  background: var(--fill);
}

/* 计划 sheet 内的任务列表 */
.plan-list {
  --card: var(--bg);
  border-radius: var(--r-sm);
  overflow: hidden;
  margin-bottom: var(--sp-8);
}

.sheet {
  display: flex;
  flex-direction: column;
  background: var(--card);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: var(--sp-8) var(--page-x) calc(var(--sp-16) + env(safe-area-inset-bottom));
  max-height: 80vh;
  box-sizing: border-box;
}

.sheet-handle {
  width: 36px;
  height: 4px;
  border-radius: var(--r-full);
  background: var(--line-strong);
  margin: 0 auto var(--sp-8);
}

.sheet-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--hit-min);
}

.sheet-t {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.sheet-x {
  width: var(--hit-min);
  height: var(--hit-min);
  margin-right: calc(-1 * var(--sp-8));
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
}

.sheet-x--hover {
  background: var(--fill);
}

.sheet-body {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
}

.sheet-st {
  display: block;
  margin-top: var(--sp-16);
  font-size: var(--fs-sub);
  color: var(--ink-2);
}

.sheet-chips {
  margin: var(--sp-8) calc(-1 * var(--page-x)) 0;
}

.pf-field {
  margin-top: var(--sp-8);
  background: var(--fill);
  border-radius: var(--r-sm);
  overflow: hidden;
}

.pf-date {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-8);
  min-height: var(--input-h);
  padding: 0 var(--sp-12);
  font-size: var(--fs-body);
  color: var(--ink);
  background: var(--fill);
  border-radius: var(--r-sm);
  box-sizing: border-box;
}

.pf-date.empty {
  color: var(--ink-3);
}

.pf-summary {
  margin-top: var(--sp-16);
  padding: var(--sp-8) var(--sp-12);
  font-size: var(--fs-caption);
  color: var(--ink-2);
  background: var(--fill);
  border-radius: var(--r-sm);
  line-height: 1.6;
}

.sheet-acts {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
  margin-top: var(--sp-16);
}
