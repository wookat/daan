.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.hero {
  background: linear-gradient(135deg, #5b8af8, #3b6ff5);
  border-radius: var(--r-l);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(59, 111, 245, 0.3);
}

.hero-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.hero-t {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-n {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.hero-streak {
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  border-radius: var(--r-s);
  padding: 4rpx 16rpx;
}

.hero-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: var(--r-full);
  overflow: hidden;
  margin: 16rpx 0 24rpx;
}

.hero-fill {
  height: 100%;
  background: #fff;
  border-radius: var(--r-full);
}

.hero-btns {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.hero-go {
  background: #fff;
  color: var(--brand-500);
  border-radius: var(--r-full);
  padding: 16rpx 36rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.hero-chips {
  display: flex;
  flex-direction: row;
}

.hero-chip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: var(--r-full);
  padding: 6rpx 18rpx;
  margin-left: 12rpx;
}

.hero-chip.on {
  background: #fff;
  color: var(--brand-500);
  font-weight: 600;
}

.plan-h {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.plan-t {
  font-size: 30rpx;
  font-weight: 600;
}

.plan-days {
  font-size: 22rpx;
  color: var(--brand-500);
  background: var(--brand-50);
  border-radius: var(--r-full);
  padding: 4rpx 16rpx;
}

.plan-prog {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
}

.plan-bar {
  flex: 1;
  height: 10rpx;
  background: var(--fill);
  border-radius: var(--r-full);
  overflow: hidden;
}

.plan-fill {
  height: 100%;
  background: var(--brand-500);
  border-radius: var(--r-full);
}

.plan-pct {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--t3);
}

.plan-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 88rpx;
  border-top: 1rpx solid var(--border);
}

.plan-row:first-of-type {
  border-top: none;
}

.task-ck {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--r-full);
  border: 2rpx solid var(--t4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  margin-right: 16rpx;
}

.task-ck.on {
  background: var(--success);
  border-color: var(--success);
}

.plan-txt {
  flex: 1;
  font-size: 26rpx;
  color: var(--t1);
}

.plan-txt.tdone {
  color: var(--t3);
  text-decoration: line-through;
}

.plan-go {
  font-size: 24rpx;
  color: var(--brand-500);
}

.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.mcard {
  width: 48%;
  box-sizing: border-box;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-m);
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.mico {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--r-s);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.mname {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--t1);
}
