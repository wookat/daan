/* 沉浸式品牌头部：延伸到状态栏后面 */
.hero-bleed {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280px;
  background: var(--brand-grad);
  overflow: hidden;
  z-index: 0;
}

.bleed-c1,
.bleed-c2,
.hero-deco {
  position: absolute;
  border-radius: var(--r-full);
  background: var(--on-brand);
  opacity: 0.08;
}

.bleed-c1 {
  right: -60px;
  top: -40px;
  width: 220px;
  height: 220px;
}

.bleed-c2 {
  left: -40px;
  bottom: -30px;
  width: 160px;
  height: 160px;
  opacity: 0.06;
}

.wrap {
  padding: var(--sp-12) var(--page-x) calc(80px + env(safe-area-inset-bottom));
}

/* hero */
.hero {
  background: var(--brand-grad);
  border-radius: var(--r-lg);
  padding: var(--sp-20) var(--card-pad) var(--card-pad);
  margin-bottom: var(--card-gap);
  box-shadow: var(--sh-2);
  position: relative;
  overflow: hidden;
}

.hero-deco {
  right: -30px;
  top: -46px;
  width: 150px;
  height: 150px;
  opacity: 0.1;
}

.hero-top,
.hero-num-row,
.hero-prog,
.hero-btns {
  position: relative;
  z-index: 1;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-label {
  font-size: var(--fs-sub);
  font-weight: 500;
  color: var(--on-brand-2);
}

.hero-num-row {
  display: flex;
  align-items: baseline;
  margin-top: var(--sp-4);
}

.hero-n {
  font-size: var(--fs-display);
  line-height: 1.1;
  font-weight: 600;
  color: var(--on-brand);
}

.hero-goal {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--on-brand-2);
  margin-left: var(--sp-4);
}

.hero-streak {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-4);
  height: var(--tag-h);
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--on-brand);
  background: var(--brand-press);
  border-radius: var(--r-full);
  padding: 0 var(--sp-12);
}

.hero-prog {
  margin: var(--sp-16) 0 var(--sp-12);
}

.hero-btns {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-8);
}

.hero-chips {
  display: flex;
  gap: var(--sp-8);
}

.hero-chip {
  display: inline-flex;
  align-items: center;
  height: var(--chip-h);
  padding: 0 var(--sp-12);
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--on-brand);
  background: var(--brand-press);
  border-radius: var(--r-full);
}

.hero-chip--hover {
  opacity: 0.8;
}

.hero-chip.on {
  background: var(--on-brand);
  color: var(--brand-text);
}

/* 今日任务三件套 */
.taskcard,
.plancard {
  display: block;
  margin-bottom: var(--card-gap);
}

.tk-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-4);
}

.tk-t,
.plan-t {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.tk-row,
.plan-row {
  display: flex;
  align-items: center;
  min-height: var(--cell-h);
  padding: var(--sp-8) 0;
  border-top: 1px solid var(--line);
}

.tk-h + .tk-row,
.plan-prog + .plan-row {
  border-top: none;
}

.tk-row--hover {
  opacity: 0.7;
}

.tk-ck {
  width: 20px;
  height: 20px;
  border-radius: var(--r-full);
  border: 2px solid var(--ink-4);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.tk-ck.on {
  background: var(--ok);
  border-color: var(--ok);
}

.tk-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin: 0 var(--sp-12);
}

.tk-name-row {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
}

.tk-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.tk-name.tdone,
.plan-txt.tdone {
  color: var(--ink-3);
  text-decoration: line-through;
  font-weight: 500;
}

.tk-streak {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  font-size: var(--fs-caption);
  font-weight: 500;
  color: var(--streak);
}

.tk-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}

.tk-bar {
  margin-top: var(--sp-8);
}

.tk-go,
.plan-go {
  display: inline-flex;
  align-items: center;
  min-height: var(--hit-min);
  padding: 0 var(--sp-4);
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--brand-text);
  flex-shrink: 0;
}

/* 到期复习条 */
.duebar {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  background: var(--streak-soft);
  border-radius: var(--r-md);
  padding: var(--sp-12) var(--card-pad);
  margin-bottom: var(--card-gap);
}

.duebar--hover {
  opacity: 0.85;
}

.duebar.donebar {
  background: var(--card);
  box-shadow: var(--sh-1);
}

.duebar-ico {
  width: 36px;
  height: 36px;
  border-radius: var(--r-full);
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.duebar-ico.ok {
  background: var(--ok-soft);
}

.duebar-l {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.duebar-t {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--streak);
}

.donebar .duebar-t {
  color: var(--ok-strong);
}

.duebar-s {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}

/* 制定学习计划引导卡 */
.guide {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  background: var(--brand-soft);
  border-radius: var(--r-md);
  padding: var(--sp-12) var(--card-pad);
  margin-bottom: var(--card-gap);
}

.guide--hover {
  opacity: 0.85;
}

.guide-l {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.guide-t {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--brand-text);
}

.guide-s {
  font-size: var(--fs-caption);
  color: var(--ink-2);
  margin-top: 2px;
}

.guide-x {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  min-height: var(--hit-min);
  padding: 0 var(--sp-4);
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

/* 学习计划卡 */
.plan-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-8);
}

.plan-prog {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  margin-bottom: var(--sp-4);
}

.plan-bar {
  flex: 1;
  min-width: 0;
}

.plan-pct {
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--brand-text);
}

.plan-txt {
  flex: 1;
  min-width: 0;
  margin-left: var(--sp-12);
  font-size: var(--fs-body);
  color: var(--ink);
}

/* 专项练习 2 列 */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: var(--card-gap) 0;
}

.mcard {
  width: calc(50% - var(--sp-4) - 2px);
  box-sizing: border-box;
  background: var(--card);
  border-radius: var(--r-md);
  box-shadow: var(--sh-1);
  padding: var(--sp-12);
  min-height: var(--hit-min);
  display: flex;
  align-items: center;
  gap: var(--sp-12);
}

.mcard--hover {
  opacity: 0.85;
}

.mico {
  width: 40px;
  height: 40px;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.m-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.mname {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mcount {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}

.m-arrow {
  flex-shrink: 0;
}

/* 制定学习计划 sheet（t-popup 内容区） */
.sheet {
  display: flex;
  flex-direction: column;
  background: var(--card);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: var(--sp-8) var(--page-x) calc(var(--sp-16) + env(safe-area-inset-bottom));
  max-height: 80vh;
  box-sizing: border-box;
}

.sheet-handle {
  width: 36px;
  height: 4px;
  border-radius: var(--r-full);
  background: var(--line-strong);
  margin: 0 auto var(--sp-8);
}

.sheet-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--hit-min);
}

.sheet-t {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.sheet-x {
  width: var(--hit-min);
  height: var(--hit-min);
  margin-right: calc(-1 * var(--sp-8));
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
}

.sheet-x--hover {
  background: var(--fill);
}

.sheet-body {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
}

.sheet-st {
  display: block;
  margin-top: var(--sp-16);
  font-size: var(--fs-sub);
  color: var(--ink-2);
}

.sheet-chips {
  margin: var(--sp-8) calc(-1 * var(--page-x)) 0;
}

.pf-field {
  margin-top: var(--sp-8);
  background: var(--fill);
  border-radius: var(--r-sm);
  overflow: hidden;
}

.pf-date {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-8);
  min-height: var(--input-h);
  padding: 0 var(--sp-12);
  font-size: var(--fs-body);
  color: var(--ink);
  background: var(--fill);
  border-radius: var(--r-sm);
  box-sizing: border-box;
}

.pf-date.empty {
  color: var(--ink-3);
}

.pf-summary {
  margin-top: var(--sp-16);
  padding: var(--sp-8) var(--sp-12);
  font-size: var(--fs-caption);
  color: var(--ink-2);
  background: var(--fill);
  border-radius: var(--r-sm);
  line-height: 1.6;
}

.sheet-acts {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
  margin-top: var(--sp-16);
}

/* hero 每日一练入口 */
.hero-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-8);
  margin: var(--sp-8) 0 var(--sp-4);
}

.hero-ds {
  font-size: var(--fs-caption);
  color: var(--on-brand-2);
  flex: 1;
  min-width: 0;
}

.hero-lnk {
  font-size: var(--fs-caption);
  color: var(--on-brand);
  font-weight: 600;
  flex-shrink: 0;
}

/* 续练/续考/续复习 */
.resumes {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
  margin-bottom: var(--card-gap);
}

.rs-row {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
}

.rs-main {
  flex: 1;
  min-width: 0;
}

.rs-t {
  display: block;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.rs-s {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  line-height: var(--lh-caption);
  margin-top: 2px;
}

.rs-x {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
  flex-shrink: 0;
}

.rs-x--hover {
  background: var(--fill);
}

.strip {
  margin-bottom: var(--card-gap);
}

/* 学习计划任务卡 */
.plan-s {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin: -4px 0 var(--sp-8);
}

.plan-y {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.task {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  min-height: var(--hit-min);
  padding: var(--sp-8) 0;
  border-top: 1px solid var(--line);
}

.task.is-done {
  opacity: 0.55;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-t {
  display: block;
  font-size: var(--fs-body);
  color: var(--ink);
}

.task-s {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}

.task-go {
  font-size: var(--fs-caption);
  color: var(--brand-text);
  font-weight: 600;
  flex-shrink: 0;
}

.focus {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  padding-top: var(--sp-8);
  border-top: 1px solid var(--line);
}

.focus-k {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  flex-shrink: 0;
}

.focus-row {
  flex: 1;
  min-width: 0;
}

/* 入口行 */
.entries {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
  margin: var(--sp-8) 0 var(--card-gap);
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: var(--r-full);
  background: var(--bad);
}

/* 更多练习 2×2 */
.more-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-8);
  margin-bottom: var(--card-gap);
}

.more-c {
  width: calc(50% - var(--sp-4));
  box-sizing: border-box;
  background: var(--card);
  border-radius: var(--r-md);
  box-shadow: var(--sh-1);
  padding: var(--sp-12);
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}

.more-ico {
  width: 40px;
  height: 40px;
  border-radius: var(--r-sm);
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--sp-4);
}

.more-t {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.more-s {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  line-height: var(--lh-caption);
}
