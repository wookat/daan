.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
}

.hero {
  background: var(--brand-grad);
  border-radius: var(--r-xl);
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-brand);
}

.hero-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.hero-t {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-n {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.hero-streak {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--r-full);
  padding: 6rpx 18rpx;
}

.hero-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: var(--r-full);
  overflow: hidden;
  margin: 16rpx 0 24rpx;
}

.hero-fill {
  height: 100%;
  background: #fff;
  border-radius: var(--r-full);
}

.hero-btns {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.hero-go {
  background: #fff;
  color: var(--brand-600);
  border-radius: var(--r-full);
  padding: 18rpx 40rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.hero-chips {
  display: flex;
  flex-direction: row;
}

.hero-chip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: var(--r-full);
  padding: 6rpx 18rpx;
  margin-left: 12rpx;
}

.hero-chip.on {
  background: #fff;
  color: var(--brand-500);
  font-weight: 600;
}

.duebar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: var(--brand-grad-btn);
  border-radius: var(--r-l);
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-brand);
}

.duebar.donebar {
  background: var(--surface);
  border: 1rpx solid var(--border);
  box-shadow: none;
}

.duebar-l {
  display: flex;
  flex-direction: column;
}

.duebar-t {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.duebar-s {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4rpx;
}

.donebar .duebar-t {
  color: var(--success);
}

.donebar .duebar-s {
  color: var(--t3);
}

.duebar-go {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-500);
  background: #fff;
  border-radius: var(--r-full);
  padding: 12rpx 28rpx;
}

.plan-h {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.plan-t {
  font-size: 30rpx;
  font-weight: 700;
}

.plan-days {
  font-size: 22rpx;
  color: var(--brand-500);
  background: var(--brand-50);
  border-radius: var(--r-full);
  padding: 4rpx 16rpx;
}

.plan-prog {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
}

.plan-bar {
  flex: 1;
  height: 10rpx;
  background: var(--fill);
  border-radius: var(--r-full);
  overflow: hidden;
}

.plan-fill {
  height: 100%;
  background: var(--brand-grad-btn);
  border-radius: var(--r-full);
}

.plan-pct {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--t3);
}

.plan-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 88rpx;
  border-top: 1rpx solid var(--border);
}

.plan-row:first-of-type {
  border-top: none;
}

.task-ck {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--r-full);
  border: 2rpx solid var(--t4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  margin-right: 16rpx;
}

.task-ck.on {
  background: var(--success);
  border-color: var(--success);
}

.plan-txt {
  flex: 1;
  font-size: 26rpx;
  color: var(--t1);
}

.plan-txt.tdone {
  color: var(--t3);
  text-decoration: line-through;
}

.plan-go {
  font-size: 24rpx;
  color: var(--brand-500);
}

.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.mcard {
  width: 48%;
  box-sizing: border-box;
  background: var(--surface);
  border-radius: var(--r-l);
  box-shadow: var(--sh-1);
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.mico {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-m);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.mname {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--t1);
}

/* 今日任务三件套 */
.taskcard {
  margin-bottom: 24rpx;
}

.tk-h {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.tk-t {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--t1);
}

.tk-n {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand-500);
}

.tk-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--border);
}

.tk-h + .tk-row {
  border-top: none;
}

.tk-ck {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--r-full);
  border: 2rpx solid var(--t4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
}

.tk-ck.on {
  background: var(--success);
  border-color: var(--success);
}

.tk-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin: 0 20rpx;
}

.tk-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--t1);
}

.tk-name.tdone {
  color: var(--t3);
}

.tk-streak {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--warning);
  margin-left: 8rpx;
}

.tk-sub {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 4rpx;
}

.tk-bar {
  height: 10rpx;
  background: var(--fill);
  border-radius: var(--r-full);
  overflow: hidden;
  margin-top: 10rpx;
}

.tk-fill {
  height: 100%;
  background: var(--streak-grad);
  border-radius: var(--r-full);
}

.tk-go {
  font-size: 24rpx;
  color: var(--brand-500);
  flex-shrink: 0;
}

/* 制定学习计划引导卡 */
.guide {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--brand-50);
  padding: 24rpx 26rpx;
}

.guide-l {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.guide-t {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-500);
}

.guide-s {
  font-size: 22rpx;
  color: var(--t2);
  margin-top: 6rpx;
}

.guide-btn {
  flex-shrink: 0;
  background: var(--brand-grad-btn);
  color: #fff;
  border-radius: var(--r-full);
  padding: 14rpx 26rpx;
  font-size: 24rpx;
}

.guide-x {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--t3);
  padding: 14rpx 8rpx;
}

/* 制定学习计划 sheet */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 998;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--surface);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  max-height: 75vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.sheet-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-t {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--t1);
}

.sheet-x {
  font-size: 30rpx;
  color: var(--t3);
  padding: 8rpx;
}

.sheet-st {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--t2);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.chip {
  font-size: 24rpx;
  color: var(--t2);
  background: var(--fill);
  border-radius: var(--r-full);
  padding: 10rpx 24rpx;
}

.chip.on {
  color: #fff;
  background: var(--brand-grad-btn);
  font-weight: 600;
}

.pf-input {
  width: 100%;
  box-sizing: border-box;
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: var(--t1);
  background: var(--fill);
  border-radius: var(--r-s);
}

.pf-date {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: var(--t1);
  background: var(--fill);
  border-radius: var(--r-s);
}

.pf-date.empty {
  color: var(--t3);
}

.pf-summary {
  margin-top: 26rpx;
  padding: 16rpx 20rpx;
  font-size: 23rpx;
  color: var(--t2);
  background: var(--fill);
  border-radius: var(--r-s);
  line-height: 1.6;
}

.sheet-btn {
  margin-top: 28rpx;
  text-align: center;
  background: var(--brand-grad-btn);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: var(--r-full);
  padding: 24rpx 0;
  box-shadow: var(--sh-brand);
}

.sheet-btn.dis {
  opacity: 0.5;
}

.pf-back {
  margin-top: 18rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--t3);
  padding: 8rpx 0;
}
