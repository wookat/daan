.spin {
  text-align: center;
  color: var(--t3);
  padding: 96rpx 32rpx;
}

.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: var(--surface);
  border-bottom: 1rpx solid var(--border);
}

.tb-no {
  font-size: 26rpx;
  color: var(--t2);
  font-weight: 600;
}

.tb-clock {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--t1);
}

.tb-clock.warn {
  color: var(--error);
}

.tb-mark {
  font-size: 24rpx;
  color: var(--t3);
}

.tb-mark.on {
  color: var(--warning);
  font-weight: 600;
}

.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.q-mod {
  display: block;
  font-size: 22rpx;
  color: var(--brand-500);
  margin-bottom: 12rpx;
}

.q-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.opt {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: var(--surface);
}

.opt.sel {
  border-color: var(--brand-500);
  background: var(--brand-50);
}

.opt-k {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--t2);
  margin-right: 16rpx;
}

.opt.sel .opt-k {
  background: var(--brand-500);
  color: #fff;
}

.opt-v {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.6;
}

.footbar {
  display: flex;
  flex-direction: row;
  padding: 16rpx 24rpx 8rpx;
  background: var(--surface);
  border-top: 1rpx solid var(--border);
}

.fbtn {
  flex: 1;
  min-height: 76rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--t2);
  margin-right: 12rpx;
}

.fbtn:last-child {
  margin-right: 0;
}

.fbtn.main {
  background: var(--brand-500);
  border-color: var(--brand-500);
  color: #fff;
  font-weight: 600;
}

.fbtn.dim {
  opacity: 0.6;
}

.quitline {
  text-align: center;
  font-size: 22rpx;
  color: var(--t3);
  padding: 8rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  background: var(--surface);
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 18, 30, 0.5);
  z-index: 90;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  background: var(--surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.sheet-h {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.sheet-t {
  font-size: 30rpx;
  font-weight: 700;
}

.sheet-x {
  font-size: 28rpx;
  color: var(--t2);
  padding: 8rpx 16rpx;
}

.legend {
  display: flex;
  flex-direction: row;
  margin-bottom: 16rpx;
}

.lg {
  font-size: 21rpx;
  color: var(--t3);
  margin-right: 24rpx;
}

.lg.done {
  color: var(--brand-500);
}

.lg.mark {
  color: var(--warning);
}

.grid-scroll {
  flex: 1;
  max-height: 480rpx;
}

.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.cell {
  width: 84rpx;
  height: 84rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--t2);
  margin: 0 14rpx 14rpx 0;
}

.cell.done {
  background: var(--brand-500);
  border-color: var(--brand-500);
  color: #fff;
}

.cell.mark {
  border-color: var(--warning);
  color: var(--warning);
}

.confirm-btn {
  margin-top: 20rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background: var(--brand-500);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}
