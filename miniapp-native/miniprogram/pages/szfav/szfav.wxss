.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  color: var(--t3);
  font-size: 26rpx;
}

.eico {
  width: 144rpx;
  height: 144rpx;
  border-radius: 48rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.go {
  margin-top: 24rpx;
  padding: 18rpx 64rpx;
}

.f-top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.f-q {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--t1);
}

.f-arrow {
  font-size: 22rpx;
  color: var(--t4);
  margin-left: 16rpx;
}

.f-opt {
  font-size: 25rpx;
  color: var(--t2);
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-top: 10rpx;
  background: var(--fill);
}

.f-opt.ans {
  background: var(--success-bg);
  color: var(--success);
  font-weight: 600;
}

.f-ans {
  font-size: 24rpx;
  color: var(--success);
  font-weight: 600;
  margin: 14rpx 0 8rpx;
}

.f-exp {
  display: block;
  font-size: 24rpx;
  color: var(--t2);
  line-height: 1.7;
  background: var(--fill);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.f-foot {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 14rpx;
}

.f-time {
  font-size: 21rpx;
  color: var(--t4);
}

.f-del {
  font-size: 23rpx;
  color: var(--error);
}
