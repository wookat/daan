.searchbox {
  padding: 16rpx 32rpx;
  background: var(--surface);
  border-bottom: 1rpx solid var(--border);
}

.s-input {
  background: var(--fill);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 27rpx;
  color: var(--t1);
}

.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 96rpx 0;
}

.hist-h {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.hist-t {
  font-size: 26rpx;
  font-weight: 600;
}

.hist-clear {
  font-size: 23rpx;
  color: var(--t3);
}

.chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.hchip {
  font-size: 24rpx;
  color: var(--t2);
  background: var(--fill);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  margin: 0 12rpx 12rpx 0;
}

.sec-h {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--t2);
  margin: 20rpx 0 12rpx;
}

.sec-tag {
  display: inline-block;
  font-size: 20rpx;
  color: var(--brand-600);
  background: var(--brand-50);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-bottom: 10rpx;
}

.row-item {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.r-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.r-t {
  font-size: 27rpx;
  font-weight: 600;
}

.r-s {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

.r-go {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--brand-500);
  font-weight: 600;
}

.qitem {
  display: flex;
  flex-direction: column;
}

.q-tags {
  display: flex;
  flex-direction: row;
  margin-bottom: 10rpx;
}

.q-mod {
  font-size: 20rpx;
  color: var(--brand-600);
  background: var(--brand-50);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 10rpx;
}

.q-sub {
  font-size: 20rpx;
  color: var(--t3);
  background: var(--fill);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 10rpx;
}

.q-text {
  font-size: 26rpx;
  color: var(--t1);
  line-height: 1.6;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  color: var(--t3);
  font-size: 26rpx;
}

.eico {
  width: 144rpx;
  height: 144rpx;
  border-radius: 48rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 18, 30, 0.5);
  z-index: 90;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  background: var(--surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  max-height: 75vh;
}

.d-scroll {
  max-height: 62vh;
}

.d-q {
  display: block;
  font-size: 28rpx;
  color: var(--t1);
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.d-opt {
  font-size: 25rpx;
  color: var(--t2);
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: var(--fill);
}

.d-opt.ans {
  background: var(--success-bg);
  color: var(--success);
  font-weight: 600;
}

.d-ans {
  font-size: 24rpx;
  color: var(--success);
  font-weight: 600;
  margin: 12rpx 0;
}

.d-exp {
  font-size: 24rpx;
  color: var(--t2);
  line-height: 1.7;
  background: var(--fill);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
