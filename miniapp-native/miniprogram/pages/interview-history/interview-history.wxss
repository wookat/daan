.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 96rpx 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  color: var(--t3);
  font-size: 26rpx;
}

.eico {
  width: 144rpx;
  height: 144rpx;
  border-radius: 48rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.r-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
}

.r-q {
  font-size: 26rpx;
  color: var(--t1);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
}

.r-s {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 8rpx;
}

.r-score {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--brand-500);
}
