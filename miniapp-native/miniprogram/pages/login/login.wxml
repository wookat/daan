<navbar class="{{tc}}" title="{{mode === 'login' ? '登录' : '注册'}}" back="{{true}}" />
<scroll-view class="{{tc}} page-scroll" scroll-y type="list">
  <view class="wrap">
    <view class="l-logo-box">
      <image class="l-logo" src="/images/brand/icon.png" mode="aspectFit" />
      <text class="l-app">答岸</text>
    </view>
    <kg-card variant="raised" class="l-card">
      <text class="l-title">{{mode === 'login' ? '欢迎回来' : '创建账号'}}</text>
      <text class="l-sub">登录后错题与进度多端同步</text>

      <t-button
        theme="primary"
        block
        size="large"
        icon="logo-wechat-stroke"
        loading="{{wxBusy}}"
        t-class="l-btn l-wxbtn"
        bind:tap="onWxLogin"
      >微信一键登录</t-button>

      <view class="l-divider"><view class="l-line" /><text class="l-or">或邮箱登录</text><view class="l-line" /></view>

      <t-input
        label="邮箱"
        type="text"
        placeholder="请输入邮箱"
        value="{{email}}"
        maxlength="{{128}}"
        bind:change="onEmail"
      />
      <t-input
        label="密码"
        type="password"
        placeholder="至少 6 位"
        value="{{password}}"
        bind:change="onPassword"
      />
      <t-input
        wx:if="{{mode === 'register'}}"
        label="确认密码"
        type="password"
        placeholder="再次输入密码"
        value="{{password2}}"
        bind:change="onPassword2"
      />
      <t-input
        wx:if="{{mode === 'register'}}"
        label="昵称"
        placeholder="选填"
        value="{{nickname}}"
        bind:change="onNickname"
      />

      <view wx:if="{{err}}" class="l-err" role="alert">
        <l-icon name="triangle-alert" size="16" tone="bad" />
        <text>{{err}}</text>
      </view>

      <t-button
        theme="primary"
        block
        size="large"
        loading="{{busy}}"
        t-class="l-btn"
        bind:tap="onSubmit"
      >{{mode === 'login' ? '登录' : '注册并登录'}}</t-button>

      <t-button theme="light" variant="text" block size="large" t-class="l-switch" bind:tap="onSwitch">
        {{mode === 'login' ? '没有账号？去注册' : '已有账号？去登录'}}
      </t-button>
    </kg-card>
  </view>
</scroll-view>
