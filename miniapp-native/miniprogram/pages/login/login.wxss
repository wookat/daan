.wrap {
  padding: 24rpx 32rpx;
}

.l-logo-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 40rpx;
}

.l-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--r-l);
  background: var(--brand-grad);
  box-shadow: var(--sh-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  font-weight: 800;
  color: #fff;
}

.l-app {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--t1);
}

.l-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  text-align: center;
}

.l-sub {
  display: block;
  font-size: 25rpx;
  color: var(--t3);
  margin: 10rpx 0 40rpx;
  text-align: center;
}

.l-err {
  color: var(--error);
  font-size: 24rpx;
  margin-top: 16rpx;
}

.l-btn {
  margin-top: 32rpx;
  --td-button-primary-bg-color: #2e5bff;
  --td-button-primary-border-color: #2e5bff;
}

.l-wxbtn {
  margin-top: 8rpx;
  --td-button-primary-bg-color: #07c160;
  --td-button-primary-border-color: #07c160;
  --td-button-border-radius: 999rpx;
  box-shadow: 0 12rpx 32rpx rgba(7, 193, 96, 0.3);
  border-radius: 999rpx;
}

.l-btn {
  --td-button-border-radius: 999rpx;
  border-radius: 999rpx;
}

.l-divider {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 40rpx 0 16rpx;
}

.l-line {
  flex: 1;
  height: 1rpx;
  background: var(--border);
}

.l-or {
  font-size: 22rpx;
  color: var(--t4);
  margin: 0 16rpx;
}

.l-switch {
  text-align: center;
  color: var(--brand-500);
  font-size: 26rpx;
  margin-top: 24rpx;
  padding: 16rpx;
}
