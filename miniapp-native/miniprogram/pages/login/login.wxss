.wrap {
  padding: 24rpx 32rpx;
}

.l-title {
  font-size: 40rpx;
  font-weight: 700;
}

.l-sub {
  font-size: 24rpx;
  color: var(--t3);
  margin: 8rpx 0 24rpx;
}

.l-err {
  color: var(--error);
  font-size: 24rpx;
  margin-top: 16rpx;
}

.l-btn {
  margin-top: 32rpx;
  --td-button-primary-bg-color: #3b6ff5;
  --td-button-primary-border-color: #3b6ff5;
}

.l-switch {
  text-align: center;
  color: var(--brand-500);
  font-size: 26rpx;
  margin-top: 24rpx;
  padding: 16rpx;
}
