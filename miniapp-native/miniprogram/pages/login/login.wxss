/* T5 工具页：单列居中 max 480，永不双栏 */
.wrap {
  max-width: 480px;
  margin: 0 auto;
  padding: var(--sp-12) var(--page-x) calc(var(--sp-40) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.l-logo-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-24) 0 var(--sp-20);
}

.l-logo {
  width: 64px;
  height: 64px;
  border-radius: var(--r-lg);
  background: var(--brand-grad);
  box-shadow: var(--sh-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-display);
  font-weight: 600;
  color: var(--on-brand);
}

.l-app {
  margin-top: var(--sp-12);
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink);
}

.l-card {
  display: block;
}

.l-title {
  display: block;
  font-size: var(--fs-h1);
  font-weight: 600;
  color: var(--ink);
  text-align: center;
}

.l-sub {
  display: block;
  font-size: var(--fs-sub);
  color: var(--ink-3);
  margin: var(--sp-4) 0 var(--sp-20);
  text-align: center;
}

.l-err {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  color: var(--bad-strong);
  font-size: var(--fs-sub);
  margin-top: var(--sp-8);
  padding: var(--sp-8) var(--sp-12);
  border-radius: var(--r-sm);
  background: var(--bad-soft);
}

.l-btn {
  margin-top: var(--sp-16);
  --td-button-border-radius: var(--r-full);
  --td-button-large-height: var(--btn-h-lg);
  --td-button-large-font-size: var(--fs-body);
}

/* 微信绿：共享层无 --wechat token，暂映射 --ok/--ok-strong（见 PR「共享层缺口」） */
.l-wxbtn {
  margin-top: var(--sp-4);
  --td-button-primary-bg-color: var(--ok);
  --td-button-primary-border-color: var(--ok);
  --td-button-primary-active-bg-color: var(--ok-strong);
  --td-button-primary-active-border-color: var(--ok-strong);
}

.l-switch {
  margin-top: var(--sp-8);
  --td-button-light-color: var(--brand-text);
  --td-button-large-height: var(--hit-min);
}

.l-divider {
  display: flex;
  align-items: center;
  margin: var(--sp-20) 0 var(--sp-8);
}

.l-line {
  flex: 1;
  height: 1px;
  background: var(--line);
}

.l-or {
  font-size: var(--fs-caption);
  color: var(--ink-4);
  margin: 0 var(--sp-8);
}
