.wrap {
  padding: var(--sp-12) var(--page-x) calc(80px + env(safe-area-inset-bottom));
}

.sec {
  display: block;
  margin-bottom: var(--card-gap);
}

/* 0 数据解锁卡 */
.unlock {
  display: block;
}

.unlock-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: var(--sp-32) var(--card-pad) var(--card-pad);
}

.unlock-ico {
  width: 64px;
  height: 64px;
  border-radius: var(--r-full);
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--sp-16);
}

.unlock-t {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink);
}

.unlock-s {
  font-size: var(--fs-sub);
  color: var(--ink-3);
  line-height: 1.6;
  margin: var(--sp-8) 0 var(--sp-16);
}

.unlock-steps {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--sp-8);
  margin-bottom: var(--sp-20);
}

.unlock-step {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-4);
  height: var(--chip-h);
  padding: 0 var(--sp-12);
  border-radius: var(--r-full);
  background: var(--fill);
  font-size: var(--fs-caption);
  color: var(--ink-2);
}

/* 三格数字 */
.nums {
  display: block;
  margin-bottom: var(--card-gap);
}

.nums-body {
  display: flex;
  padding: var(--sp-20) 0;
}

.numcell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.numcell.divl {
  border-left: 1px solid var(--line);
}

.num-n {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-4);
  font-size: var(--fs-display);
  font-weight: 600;
  color: var(--brand-text);
  line-height: 1.2;
}

.num-n.c2 {
  color: var(--ink);
}

.num-n.c3 {
  color: var(--streak);
}

.num-t {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-4);
}

/* 热力图 */
.hm-body {
  display: flex;
  margin-top: var(--sp-4);
}

.hm-ylab {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin-right: var(--sp-8);
}

.hm-yl {
  font-size: 10px;
  color: var(--ink-4);
  height: 20px;
  line-height: 20px;
}

.hm-grid {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: var(--sp-4);
}

.hm-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}

.hm-c {
  width: 100%;
  height: 20px;
  border-radius: var(--r-xs);
  background: var(--fill);
}

.hm-c.lv1 {
  background: var(--brand-soft-2);
}

.hm-c.lv2 {
  background: var(--brand);
  opacity: 0.45;
}

.hm-c.lv3 {
  background: var(--brand);
  opacity: 0.75;
}

.hm-c.lv4 {
  background: var(--brand-press);
}

.hm-c.fut {
  opacity: 0.35;
}

.hm-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--sp-4);
  margin-top: var(--sp-12);
}

.hm-legend .hm-c {
  width: 14px;
  height: 14px;
  flex: none;
}

.hm-lt {
  font-size: var(--fs-caption);
  color: var(--ink-4);
}

.hm-note {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: var(--sp-8);
}

.h {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: var(--sp-12);
}

.h-sub {
  margin-left: auto;
  font-size: var(--fs-caption);
  font-weight: 400;
  color: var(--ink-3);
}

.sec-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 32px;
  margin: var(--sp-4) 0 var(--sp-8);
}

.sec-t {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

/* 模块行 */
.mrow {
  display: block;
  margin-bottom: var(--sp-12);
}

.mr-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-12);
  margin-bottom: var(--sp-8);
}

.mr-l {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  min-width: 0;
}

.mr-ico {
  width: 32px;
  height: 32px;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mr-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.mr-sub {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.mr-pct {
  font-size: var(--fs-h3);
  font-weight: 600;
  flex-shrink: 0;
}

.mr-pct.is-weak {
  color: var(--warn-strong);
}

.weak-tip {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  min-height: var(--hit-min);
  margin-top: var(--sp-8);
  padding: var(--sp-8) var(--sp-12);
  border-radius: var(--r-sm);
  background: var(--warn-soft);
  color: var(--warn-strong);
  font-size: var(--fs-caption);
}

.weak-tip--hover {
  opacity: 0.8;
}

.weak-txt {
  flex: 1;
  min-width: 0;
}

.weak-go {
  display: inline-flex;
  align-items: center;
  font-weight: 600;
  flex-shrink: 0;
}

/* 申论学习 / 模考成绩趋势（对齐 H5 stats.vue） */
.sl-row {
  display: flex;
  align-items: baseline;
  gap: var(--sp-4);
  margin: var(--sp-8) 0;
}

.sl-num {
  font-size: var(--fs-h1);
  font-weight: 600;
  color: var(--brand-text);
}

.sl-lab {
  font-size: var(--fs-sub);
  color: var(--ink-3);
}

.sl-last {
  margin-left: auto;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.sl-types {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-8);
}

.sl-ih {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--hit-min);
  margin-top: var(--sp-8);
  font-size: var(--fs-sub);
  color: var(--ink-2);
}

.sl-ih--hover {
  opacity: 0.7;
}

.sl-issue {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-8);
  margin-bottom: var(--sp-8);
}

.sl-it {
  flex: 1;
  font-size: var(--fs-sub);
  line-height: var(--lh-sub);
  color: var(--ink);
}

.trend {
  display: flex;
  align-items: flex-end;
  gap: var(--sp-4);
  height: 80px;
  padding-top: var(--sp-8);
}

.et-wrap {
  position: relative;
}

.trend-col {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: flex-end;
}

.trend-bar {
  width: 100%;
  min-height: 3px;
  border-radius: var(--r-xs) var(--r-xs) 0 0;
  background: var(--ok);
}

.trend-bar.is-warn {
  background: var(--warn);
}

.trend-bar.is-bad {
  background: var(--bad);
}

.trend-x {
  display: flex;
  justify-content: space-between;
  margin-top: var(--sp-4);
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.et-target {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 1;
  border-top: 1px dashed var(--warn-strong);
  pointer-events: none;
}

.et-target-t {
  position: absolute;
  right: 0;
  top: -16px;
  font-size: var(--fs-caption);
  color: var(--warn-strong);
}
