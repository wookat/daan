.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
}

.nums {
  display: flex;
  flex-direction: row;
  padding-top: 36rpx;
  padding-bottom: 36rpx;
}

.numcell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.numcell.divl {
  border-left: 1rpx solid var(--border);
}

.num-n {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--brand-500);
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.num-n.c1 {
  color: var(--brand-500);
}

.num-n.c2 {
  color: var(--t1);
}

.num-n.c3 {
  color: var(--accent-600);
}

.num-t {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  color: var(--t3);
  font-size: 26rpx;
}

.eico {
  width: 144rpx;
  height: 144rpx;
  border-radius: 48rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

/* 学习热力图 */
.hm-h {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.hm-t {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--t1);
}

.hm-total {
  font-size: 22rpx;
  color: var(--t3);
}

.hm-body {
  display: flex;
  flex-direction: row;
}

.hm-ylab {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin-right: 10rpx;
}

.hm-yl {
  font-size: 18rpx;
  color: var(--t4);
  height: 40rpx;
  line-height: 40rpx;
}

.hm-grid {
  flex: 1;
  display: flex;
  flex-direction: row;
  gap: 8rpx;
}

.hm-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hm-c {
  width: 100%;
  height: 40rpx;
  border-radius: 8rpx;
  background: var(--fill);
}

.hm-c.lv1 {
  background: var(--brand-100);
}

.hm-c.lv2 {
  background: var(--brand-300);
}

.hm-c.lv3 {
  background: var(--brand-500);
}

.hm-c.lv4 {
  background: var(--brand-700);
}

.hm-c.fut {
  opacity: 0.35;
}

.hm-legend {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 16rpx;
}

.hm-note {
  display: block;
  font-size: 22rpx;
  color: var(--t3);
  margin: 8rpx 4rpx 0;
}

.hm-legend .hm-c {
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

.hm-lt {
  font-size: 20rpx;
  color: var(--t4);
}

.mr-h {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.mr-l {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.mr-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.mr-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--t1);
}

.mr-sub {
  font-size: 22rpx;
  color: var(--t4);
  margin-left: 10rpx;
}

.mr-pct {
  font-size: 26rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.weak-tip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: #fef7e6;
  border-radius: var(--r-m);
  padding: 18rpx 22rpx;
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #b45309;
  font-weight: 600;
}

.weak-go {
  font-weight: 800;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.bar {
  height: 12rpx;
  background: var(--fill);
  border-radius: var(--r-full);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: var(--brand-grad-btn);
  border-radius: var(--r-full);
}
