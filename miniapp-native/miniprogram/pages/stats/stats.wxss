.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.nums {
  display: flex;
  flex-direction: row;
}

.numcell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.num-n {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand-500);
}

.num-t {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  color: var(--t3);
  font-size: 26rpx;
}

.eico {
  width: 144rpx;
  height: 144rpx;
  border-radius: 48rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.mr-h {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.mr-name {
  font-size: 28rpx;
  font-weight: 600;
}

.mr-pct {
  font-size: 24rpx;
  color: var(--t3);
}

.bar {
  height: 12rpx;
  background: var(--fill);
  border-radius: var(--r-full);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #5b8af8, var(--brand-500));
  border-radius: var(--r-full);
}
