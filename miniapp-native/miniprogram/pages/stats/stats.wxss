.wrap {
  padding: var(--sp-8) var(--page-x) calc(var(--sp-32) + env(safe-area-inset-bottom));
}

/* 焦点区 */
.focus {
  padding: var(--sp-8) var(--sp-4) var(--sp-4);
}

.focus-t {
  display: block;
  font-size: var(--fs-h2);
  font-weight: 600;
  line-height: 1.35;
  color: var(--ink);
}

.focus-dots {
  margin-top: var(--sp-12);
}

.focus-s {
  display: block;
  margin-top: var(--sp-8);
  font-size: var(--fs-sub);
  line-height: 1.5;
  color: var(--ink-3);
}

.focus-acts {
  margin-top: var(--sp-16);
}

/* 一行三数 */
.nums {
  display: flex;
}

.nums-it {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}

.nums-n {
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.1;
  color: var(--ink);
}

.nums-k {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

/* 组内块：同组多块以内缩分隔线相隔 */
.blk {
  position: relative;
  padding: var(--sp-16);
}

.blk + .blk::before {
  content: '';
  position: absolute;
  left: var(--sp-16);
  right: 0;
  top: 0;
  height: 1px;
  background: var(--line);
}

.blk-t {
  display: block;
  font-size: var(--fs-sub);
  color: var(--ink-3);
  margin-bottom: var(--sp-12);
}

.blk-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-8);
  margin-bottom: var(--sp-12);
}

.blk-hd .blk-t {
  margin-bottom: 0;
}

.note {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  line-height: var(--lh-caption);
  margin-top: var(--sp-12);
}

.more {
  display: block;
  text-align: center;
  font-size: var(--fs-sub);
  color: var(--brand-text);
  padding: var(--sp-12) 0 0;
}

.row--hover {
  opacity: 0.7;
}

/* 雷达 */
.radar-flex {
  display: flex;
  align-items: center;
  gap: var(--sp-16);
}

.radar-side {
  flex: 1;
  min-width: 0;
}

.rs-t {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-bottom: var(--sp-8);
}

.rs-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: var(--sp-4) 0;
}

.rs-name {
  font-size: var(--fs-body);
  color: var(--ink);
}

.rs-pct {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--bad);
}

.rs-link {
  display: inline-block;
  margin-top: var(--sp-8);
  padding: var(--sp-4) 0;
  font-size: var(--fs-sub);
  color: var(--brand-text);
}

/* 模块 / 错因行：名 · 条 · 数 */
.mrow {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  min-height: 36px;
}

.mrow-name {
  width: 64px;
  flex-shrink: 0;
  font-size: var(--fs-sub);
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mrow-bar {
  flex: 1;
  min-width: 0;
}

.mrow-n {
  width: 32px;
  flex-shrink: 0;
  text-align: right;
  font-size: var(--fs-sub);
  color: var(--ink-2);
}

.bar {
  height: 6px;
  border-radius: var(--r-full);
  background: var(--prog-track);
  overflow: hidden;
}

.bar.thin {
  flex: 1;
  min-width: 0;
}

.fill {
  height: 100%;
  border-radius: var(--r-full);
  background: var(--brand);
}

.fill.is-ok {
  background: var(--ok);
}

.fill.is-warn {
  background: var(--warn);
}

.fill.is-bad {
  background: var(--bad);
}

/* 高频题型 */
.top-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-8);
}

.top-chip {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-4);
  min-height: var(--chip-h);
  padding: 0 var(--sp-12);
  border-radius: var(--r-full);
  background: var(--fill);
  font-size: var(--fs-sub);
  color: var(--ink);
}

.top-chip.is-more {
  color: var(--brand-text);
}

.tc-n {
  color: var(--ink-3);
  font-size: var(--fs-caption);
}

/* 周正确率 */
.gw-row {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  margin-top: var(--sp-8);
}

.gw-wk {
  width: 76px;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  flex-shrink: 0;
}

.gw-pct {
  width: 88px;
  text-align: right;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink);
  flex-shrink: 0;
}

.gw-n {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  font-weight: 400;
}

.gw-delta {
  display: block;
  margin-top: var(--sp-8);
  font-size: var(--fs-caption);
  color: var(--bad-strong);
}

.gw-delta.is-up {
  color: var(--ok-strong);
}

/* 申论 */
.sl-row {
  display: flex;
  align-items: baseline;
  gap: var(--sp-4);
}

.sl-num {
  font-size: var(--fs-h1);
  font-weight: 600;
  color: var(--ink);
}

.sl-lab {
  font-size: var(--fs-sub);
  color: var(--ink-2);
}

.sl-last {
  margin-left: auto;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.sl-types {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-4);
  margin-top: var(--sp-8);
}

.sl-ih {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--hit-min);
  margin-top: var(--sp-4);
  font-size: var(--fs-sub);
  color: var(--ink-2);
}

.chev {
  display: inline-flex;
  transition: transform 0.2s;
}

.chev.is-open {
  transform: rotate(180deg);
}

.sl-issue {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-8);
  margin-bottom: var(--sp-8);
}

.sl-it {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-sub);
  color: var(--ink-2);
  line-height: var(--lh-sub);
}

/* 考点地图 */
.km-group + .km-group {
  margin-top: var(--sp-12);
}

.km-mod {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-bottom: var(--sp-4);
}

.km-items {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-8);
}

.km-chip {
  display: inline-flex;
  flex-direction: column;
  padding: var(--sp-4) var(--sp-12);
  border-radius: var(--r-sm);
  background: var(--fill);
  border-left: 3px solid var(--ink-4);
}

.km-chip.is-lo {
  border-left-color: var(--bad);
}

.km-chip.is-mid {
  border-left-color: var(--warn);
}

.km-chip.is-hi {
  border-left-color: var(--ok);
}

.km-name {
  font-size: var(--fs-sub);
  color: var(--ink);
}

.km-pct {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}
