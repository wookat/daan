<navbar title="统计" large />
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="wrap">
    <block wx:if="{{!hasData}}">
      <view class="focus">
        <text class="focus-t">再答 {{unlockLeft}} 题解锁学习统计</text>
        <view class="focus-dots"><kg-dots value="{{totalDone}}" max="{{unlockN}}" aria-label="解锁进度" /></view>
        <text class="focus-s">答满 {{unlockN}} 题后，这里会出现能力雷达、错题分布、学习热力图与考点掌握度</text>
        <view class="focus-acts">
          <kg-button variant="primary" size="lg" block bind:click="onGoPractice">去刷 {{unlockLeft}} 题</kg-button>
        </view>
      </view>
      <kg-empty wx:if="{{loadErr}}" compact icon="wifi-off" title="统计加载失败" desc="{{loadErr}}" cta-text="重试" bind:cta="onRetry" />
    </block>

    <block wx:else>
      <view class="focus">
        <view class="nums">
          <view class="nums-it">
            <text class="nums-n num">{{totalDone}}</text>
            <text class="nums-k">累计题数</text>
          </view>
          <view class="nums-it">
            <text class="nums-n num">{{accPct}}%</text>
            <text class="nums-k">正确率</text>
          </view>
          <view class="nums-it">
            <text class="nums-n num">{{streak}}</text>
            <text class="nums-k">连续天数</text>
          </view>
        </view>
      </view>

      <kg-group title="预测">
        <kg-predict-card id="predict" />
      </kg-group>

      <kg-group title="能力">
        <kg-empty wx:if="{{!hasRadar}}" compact icon="chart-column" title="还没有能力数据" desc="刷几题就能生成你的五模块能力画像" cta-text="去刷题" bind:cta="onGoPractice" />
        <view wx:else class="blk radar-flex">
          <kg-chart-radar axes="{{axes}}" size="{{184}}" />
          <view class="radar-side">
            <text wx:if="{{weakAxes.length}}" class="rs-t">{{weakAxes.length >= 2 ? '最薄弱' : '已练模块'}}</text>
            <view wx:for="{{weakAxes}}" wx:key="key" class="rs-row">
              <text class="rs-name">{{item.name}}</text>
              <text class="rs-pct num">{{item.pct}}%</text>
            </view>
            <text wx:if="{{weakAxes.length}}" class="rs-link" bind:tap="onGoWeak">{{weakAxes.length >= 2 ? '去补弱' : '继续练'}} ›</text>
          </view>
        </view>
        <view wx:if="{{trendHas}}" class="blk">
          <text class="blk-t">近 7 日正确率</text>
          <kg-chart-bars bars="{{trendBars}}" height="{{96}}" labels left-text="" right-text="" />
        </view>
        <view wx:if="{{showGrowth}}" class="blk">
          <text class="blk-t">周正确率</text>
          <view class="gw-chips">
            <kg-chip-row options="{{gwOptions}}" value="{{gwMod}}" size="sm" bind:change="onGwMod" />
          </view>
          <view wx:for="{{growthRows}}" wx:key="week" class="gw-row">
            <text class="gw-wk">{{item.label}}</text>
            <view class="bar thin"><view class="fill is-{{item.tone}}" style="width:{{item.pct}}%" /></view>
            <text class="gw-pct num">{{item.pct}}%<text class="gw-n">（{{item.n}}题）</text></text>
          </view>
          <text wx:if="{{growthDeltaText}}" class="gw-delta is-{{growthDeltaTone}}">{{growthDeltaText}}</text>
        </view>
      </kg-group>

      <kg-group title="错题" more="{{byModule.length ? '错题本' : ''}}" bind:more="onGoBook">
        <kg-empty wx:if="{{loadErr && !byModule.length}}" compact icon="wifi-off" title="加载失败" desc="{{loadErr}}" cta-text="重试" bind:cta="onRetry" />
        <kg-empty wx:elif="{{!byModule.length}}" compact icon="inbox" title="暂无错题" desc="答错的题会汇集到这里，按模块与题型统计" />
        <block wx:else>
          <view class="blk">
            <view wx:for="{{shownModules}}" wx:key="module" class="mrow" hover-class="row--hover" aria-role="button" data-mod="{{item.key}}" bind:tap="onGoPractice">
              <text class="mrow-name">{{item.name}}</text>
              <view class="mrow-bar"><kg-progress value="{{item.n}}" max="{{modTotal}}" module="{{item.key}}" thickness="{{6}}" aria-label="{{item.name}}错题占比" /></view>
              <text class="mrow-n num">{{item.n}}</text>
            </view>
            <text wx:if="{{byModule.length > 3}}" class="more" aria-role="button" bind:tap="onToggleMod">{{modOpen ? '收起' : '全部 ' + byModule.length + ' 个模块'}}</text>
          </view>
          <view wx:if="{{byType.length}}" class="blk">
            <text class="blk-t">高频题型</text>
            <view class="top-chips">
              <view wx:for="{{shownTypes}}" wx:key="index" class="top-chip" hover-class="row--hover" aria-role="button" bind:tap="onGoPractice">
                <text class="tc-name">{{item.name}}</text>
                <text class="tc-n num">{{item.n}}</text>
              </view>
              <view wx:if="{{byType.length > 5}}" class="top-chip is-more" aria-role="button" bind:tap="onToggleTop">{{topOpen ? '收起' : '+' + (byType.length - 5)}}</view>
            </view>
          </view>
          <view wx:if="{{byReason.length}}" class="blk">
            <text class="blk-t">错因</text>
            <view wx:for="{{byReason}}" wx:key="error_reason" class="mrow">
              <text class="mrow-name">{{item.error_reason}}</text>
              <view class="mrow-bar bar thin"><view class="fill is-warn" style="width:{{item.pct}}%" /></view>
              <text class="mrow-n num">{{item.n}}</text>
            </view>
          </view>
        </block>
      </kg-group>

      <kg-group wx:if="{{exam}}" title="模考">
        <view class="blk">
          <text class="blk-t">{{examTitle}}</text>
          <kg-chart-bars bars="{{examBars}}" height="{{96}}" target-pct="{{exam.targetPct}}" target-text="{{exam.target ? '目标 ' + exam.target + ' 分' : ''}}" mid-text="{{examMid}}" bind:bar="onExamBar" />
          <text class="note">点柱查看单次报告 · 不同卷难度不同，仅供参考</text>
        </view>
      </kg-group>

      <kg-group wx:if="{{sl && sl.total}}" title="申论" more="作答记录" bind:more="goShenlun">
        <view class="blk">
          <view class="sl-row">
            <text class="sl-num num">{{sl.total}}</text>
            <text class="sl-lab">次 AI 批改</text>
            <text wx:if="{{slLast}}" class="sl-last">最近 {{slLast}}</text>
          </view>
          <view class="sl-types">
            <kg-tag wx:for="{{sl.by_type}}" wx:key="qtype" tone="neutral">{{item.qtype}} ×{{item.n}}</kg-tag>
          </view>
          <block wx:if="{{sl.issues && sl.issues.length}}">
            <view class="sl-ih" aria-role="button" bind:tap="onToggleSlIssues">
              <text>近期问题点（{{sl.issues.length}}）</text>
              <view class="chev {{slIssuesOpen ? 'is-open' : ''}}"><l-icon name="chevron-down" size="16" tone="muted" /></view>
            </view>
            <view wx:if="{{slIssuesOpen}}">
              <view wx:for="{{sl.issues}}" wx:key="index" class="sl-issue">
                <kg-tag tone="{{item.kind === '提升建议' ? 'warn' : 'bad'}}">{{item.kind === '提升建议' ? '建议' : '遗漏'}}</kg-tag>
                <text class="sl-it">{{item.text}}</text>
              </view>
            </view>
          </block>
        </view>
      </kg-group>

      <kg-group title="学习热力图" more="{{hmTotal ? '近 12 周 ' + hmTotal + ' 次' : ''}}" padded>
        <kg-chart-heatmap cols="{{hmCols}}" total="{{hmTotal}}" />
      </kg-group>

      <kg-group wx:if="{{subMap.length}}" title="考点地图" more="{{kmCovText ? kmCovText + '　全部' : '全部'}}" bind:more="onGoMasteryMap">
        <view class="blk">
          <view wx:for="{{subMap}}" wx:key="module" wx:for-item="g" class="km-group">
            <text class="km-mod">{{g.name}}</text>
            <view class="km-items">
              <view wx:for="{{g.subs}}" wx:key="sub" wx:for-item="s" class="km-chip is-{{s.lv}}" aria-role="button" hover-class="row--hover" data-mod="{{g.module}}" data-sub="{{s.sub}}" bind:tap="onGoSub">
                <view class="km-dot" />
                <text class="km-name">{{s.sub}}</text>
                <text class="km-pct num">{{s.pct}}% · {{s.done}}题</text>
              </view>
            </view>
          </view>
          <text class="note">红 {{kmLegendLow}} · 黄 60–80% · 绿 {{kmLegendHigh}}，点考点直达专项练习</text>
        </view>
      </kg-group>

      <kg-group title="更多">
        <kg-row icon="calendar" title="学习计划" bind:click="onGoPlanSetup" />
        <kg-row icon="file-text" title="周学习报告" bind:click="onGoWeekly" />
        <kg-row icon="calendar-check" title="学习日历" value="{{streak ? '连续 ' + streak + ' 天' : ''}}" last bind:click="onGoCalendar" />
      </kg-group>
    </block>
  </view>
</scroll-view>
