<navbar title="统计" />
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="wrap">
    <view class="card kpis">
      <view class="kpi">
        <text class="kpi-n">{{today}}</text>
        <text class="kpi-l">今日做题</text>
      </view>
      <view class="kpi">
        <text class="kpi-n">{{total}}</text>
        <text class="kpi-l">累计做题</text>
      </view>
      <view class="kpi">
        <text class="kpi-n">{{totalPct}}%</text>
        <text class="kpi-l">总正确率</text>
      </view>
      <view class="kpi">
        <text class="kpi-n">{{streak}}</text>
        <text class="kpi-l">连续天数</text>
      </view>
    </view>

    <view class="card">
      <view class="h">近 7 天做题趋势</view>
      <view class="trend">
        <view wx:for="{{trend}}" wx:key="label" class="t-col">
          <text class="t-acc">{{item.acc != null ? item.acc + '%' : ''}}</text>
          <view class="t-bar-w"><view class="t-bar {{item.n ? '' : 'none'}}" style="height: {{item.h}}%" /></view>
          <text class="t-n">{{item.n}}</text>
          <text class="t-l">{{item.label}}</text>
        </view>
      </view>
      <text class="note">柱高为做题量，柱顶为当日正确率</text>
    </view>

    <view class="card">
      <view class="h">模块能力雷达</view>
      <canvas id="radar" type="2d" class="radar" />
      <view wx:if="{{weakName}}" class="weak-line" bind:tap="onPracticeWeak">
        <text class="weak-t">薄弱模块：{{weakName}}，建议优先补强</text>
        <text class="weak-go">去练 ›</text>
      </view>
    </view>

    <view class="card entry" bind:tap="onMastery">
      <view class="e-main">
        <text class="e-t">🗺️ 掌握度地图</text>
        <text class="e-s">按考点（tag3）查看掌握度，弱点一目了然</text>
      </view>
      <text class="e-go">›</text>
    </view>

    <view class="card entry" bind:tap="onWeekly">
      <view class="e-main">
        <text class="e-t">📊 周学习报告</text>
        <text class="e-s">每周一生成，回顾上周成长与下周建议</text>
      </view>
      <text class="e-go">›</text>
    </view>

    <view wx:if="{{rows.length}}" class="card">
      <view class="h">分模块统计</view>
      <view wx:for="{{rows}}" wx:key="key" class="mrow">
        <text class="mrow-name">{{item.name}}</text>
        <view class="mrow-main">
          <view class="mrow-bar"><view class="mrow-fill" style="width: {{item.pct}}%" /></view>
          <text class="mrow-sub">做 {{item.done}} 题 · 对 {{item.correct}} · {{item.pct}}%</text>
        </view>
      </view>
    </view>
    <view wx:if="{{!rows.length}}" class="empty">
      <view class="eico">📈</view>
      <text>还没有做题记录，先去刷几题吧</text>
    </view>
  </view>
</scroll-view>
