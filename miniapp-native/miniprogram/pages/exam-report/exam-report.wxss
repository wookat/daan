.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 96rpx 0;
}

.hero {
  background: linear-gradient(135deg, var(--brand-500), #6c9bff);
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-score {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin: 12rpx 0 8rpx;
}

.score-n {
  font-size: 88rpx;
  font-weight: 800;
  color: #fff;
}

.score-u {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-left: 8rpx;
}

.hero-meta {
  display: flex;
  flex-direction: row;
}

.hm {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.9);
  margin: 0 14rpx;
}

.h {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.rank-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.rank-big {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--brand-500);
  margin-right: 12rpx;
}

.rank-sub {
  font-size: 23rpx;
  color: var(--t3);
}

.dist {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  height: 160rpx;
}

.dist-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.dist-bar-w {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}

.dist-bar {
  width: 60%;
  min-height: 4rpx;
  background: var(--border);
  border-radius: 4rpx 4rpx 0 0;
}

.dist-bar.me {
  background: var(--brand-500);
}

.dist-l {
  font-size: 18rpx;
  color: var(--t4);
  margin-top: 4rpx;
}

.note {
  display: block;
  font-size: 21rpx;
  color: var(--t3);
  margin-top: 10rpx;
}

.mrow {
  display: flex;
  flex-direction: row;
  padding: 12rpx 0;
}

.mrow-name {
  flex-shrink: 0;
  width: 130rpx;
  font-size: 24rpx;
  color: var(--t2);
  padding-top: 4rpx;
}

.mrow-main {
  flex: 1;
}

.mrow-bar {
  height: 14rpx;
  background: var(--brand-50);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.mrow-fill {
  height: 100%;
  background: var(--brand-500);
  border-radius: 999rpx;
}

.mrow-sub {
  font-size: 21rpx;
  color: var(--t3);
}

.curve {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  height: 200rpx;
}

.curve-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.curve-v {
  font-size: 20rpx;
  color: var(--t3);
  margin-bottom: 4rpx;
}

.curve-bar {
  width: 60%;
  max-width: 44rpx;
  background: var(--brand-300);
  border-radius: 8rpx 8rpx 0 0;
}

.qgrid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.qcell {
  width: 84rpx;
  height: 84rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--t3);
  margin: 0 14rpx 14rpx 0;
}

.qcell.ok {
  background: var(--success-bg);
  border-color: var(--success);
  color: var(--success);
}

.qcell.bad {
  background: var(--error-bg);
  border-color: var(--error);
  color: var(--error);
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 18, 30, 0.5);
  z-index: 90;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  background: var(--surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}

.sheet-scroll {
  flex: 1;
}

.d-q {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.d-opt {
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  font-size: 25rpx;
}

.d-opt.right {
  border-color: var(--success);
  background: var(--success-bg);
}

.d-opt.wrong {
  border-color: var(--error);
  background: var(--error-bg);
}

.d-ans {
  font-size: 24rpx;
  color: var(--t2);
  margin: 12rpx 0;
}

.d-exp {
  font-size: 24rpx;
  color: var(--t2);
  line-height: 1.8;
  background: var(--fill);
  border-radius: 12rpx;
  padding: 20rpx;
}
