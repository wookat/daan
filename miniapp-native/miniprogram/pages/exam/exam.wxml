<navbar title="模考" large />
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="wrap">
    <!-- 焦点：未交卷续考优先，否则迷你模考；一屏一个主按钮 -->
    <view wx:if="{{examResume}}" class="focus">
      <text class="focus-k">未交卷</text>
      <text class="focus-t">{{examResume.title}}</text>
      <text class="focus-s">已答 {{examResume.answered}}/{{examResume.total}} 题，剩余 {{examResume.leftText}}</text>
      <view class="focus-acts">
        <kg-button variant="primary" size="lg" block bind:click="onResumeExam">继续作答</kg-button>
        <kg-button variant="text" size="md" bind:click="onDropResume">放弃本次</kg-button>
      </view>
    </view>
    <view wx:else class="focus">
      <text class="focus-t">迷你模考</text>
      <text class="focus-s">30 题混合五大模块，限时 30 分钟，交卷即出成绩报告与薄弱考点</text>
      <view class="focus-acts"><kg-button variant="primary" size="lg" block bind:click="onMini">开始迷你模考</kg-button></view>
    </view>

    <kg-group title="更多模考">
      <kg-grid4 items="{{entries}}" bind:click="onEntry" />
    </kg-group>

    <kg-group wx:if="{{recent.length}}" title="最近成绩" more="全部" bind:more="onAllAttempts">
      <kg-row
        wx:for="{{recent}}"
        wx:key="id"
        title="{{item.title}}"
        desc="{{item.desc}}"
        value="{{item.scoreText}}"
        valueTone="{{item.scoreTone}}"
        last="{{index === recent.length - 1}}"
        data-id="{{item.id}}"
        bind:click="onAttemptTap"
      />
    </kg-group>

    <kg-group title="真题卷库" more="{{total > papers.length ? '全部 ' + total + ' 套' : ''}}" bind:more="onAllPapers">
      <view wx:if="{{loading}}" class="ph">
        <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="ph-row"><t-skeleton theme="text" animation="gradient" /></view>
      </view>
      <kg-empty
        wx:if="{{!loading && loadErr && !papers.length}}"
        icon="wifi-off"
        title="真题卷库加载失败"
        desc="{{'请检查网络后重试 · ' + loadErr}}"
        ctaText="重试"
        bind:cta="onRetry"
      />
      <kg-empty
        wx:elif="{{!loading && !papers.length}}"
        icon="files"
        title="真题卷搜集中"
        desc="真题卷上线后可整卷计时作答，先用迷你模考体验完整报告"
      />
      <block wx:if="{{!loading && papers.length}}">
        <kg-row
          wx:for="{{papers}}"
          wx:key="id"
          title="{{item.title}}"
          desc="{{item.subText}}"
          value="{{item.best_score !== null && item.best_score !== undefined ? '最好 ' + item.best_score + ' 分' : ''}}"
          valueTone="ok"
          last="{{index === papers.length - 1}}"
          data-id="{{item.id}}"
          bind:click="onPaperTap"
        />
      </block>
    </kg-group>
    <text wx:if="{{!loading && papers.length && total <= papers.length}}" class="list-end">共 {{total}} 套，已全部展示</text>
  </view>
</scroll-view>
