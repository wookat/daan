.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 48rpx;
}

.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.clock {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand-500);
}

.topinfo {
  font-size: 24rpx;
  color: var(--t3);
}

.progress {
  height: 6rpx;
  background: var(--fill);
  border-radius: var(--r-full);
  overflow: hidden;
  margin-bottom: 22rpx;
}

.pfill {
  height: 100%;
  background: var(--brand-grad-btn);
  border-radius: var(--r-full);
}

.q {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--t1);
  margin-bottom: 24rpx;
}

.opt {
  display: flex;
  flex-direction: row;
  align-items: center;
  border: 1rpx solid var(--border);
  border-radius: var(--r-m);
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  background: var(--surface);
}

.opt.sel {
  border-color: var(--brand-500);
  background: var(--brand-50);
}

.okey {
  font-weight: 700;
  color: var(--brand-500);
  margin-right: 16rpx;
}

.otext {
  flex: 1;
  font-size: 28rpx;
  color: var(--t1);
  line-height: 1.6;
}

.navrow {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 8rpx;
}

.nbtn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: var(--r-m);
  border: 1rpx solid var(--border);
  background: var(--surface);
  font-size: 28rpx;
  color: var(--t1);
}

.nbtn.dis {
  opacity: 0.4;
}

.nbtn.main {
  background: var(--brand-500);
  border-color: var(--brand-500);
  color: #fff;
  font-weight: 600;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  z-index: 30;
}

.sheet {
  background: var(--bg);
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 32rpx 48rpx;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.sheet-h {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sheet-t {
  font-size: 30rpx;
  font-weight: 700;
}

.sheet-x {
  color: var(--t3);
  font-size: 30rpx;
  padding: 8rpx;
}

.acard-scroll {
  max-height: 44vh;
}

.acard-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.acard-n {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-m);
  border: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--t2);
  background: var(--surface);
}

.acard-n.done {
  background: var(--brand-50);
  border-color: var(--brand-500);
  color: var(--brand-500);
  font-weight: 600;
}

.acard-n.cur {
  border-width: 3rpx;
  border-color: var(--brand-500);
}

.acard-foot {
  font-size: 24rpx;
  color: var(--t3);
  margin: 20rpx 0 16rpx;
  text-align: center;
}
