.wrap {
  padding: var(--sp-12) var(--page-x) calc(var(--bar-h) + var(--sp-24) + env(safe-area-inset-bottom));
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-12);
  min-height: 28px;
  margin-bottom: var(--sp-8);
}

.clock {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-4);
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--brand-text);
}

.clock.low {
  color: var(--error);
}

.topinfo {
  font-size: var(--fs-sub);
  color: var(--ink-3);
}

.progress {
  margin-bottom: var(--sp-12);
}

.qcard {
  display: block;
  margin-bottom: var(--card-gap);
}

.q {
  display: block;
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--ink);
  margin-bottom: var(--sp-16);
}

.opts {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
}

.qimg {
  width: 100%;
  border-radius: 12rpx;
  margin: 0 0 24rpx;
  background: var(--fill);
}

.opt {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  min-height: var(--hit-min);
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  padding: var(--sp-8) var(--sp-12);
  background: var(--card);
  box-sizing: border-box;
}

.opt--hover {
  background: var(--fill);
}

.opt.sel {
  border-color: var(--brand);
  background: var(--brand-soft);
}

.okey {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  border-radius: var(--r-full);
  background: var(--fill);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink-2);
}

.opt.sel .okey {
  background: var(--brand);
  color: var(--on-brand);
}

.otext {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--ink);
  line-height: 1.6;
}

/* 底栏按钮（slot 内容归页面样式，等分三键、主键略宽） */
.abar-btn {
  display: block;
  flex: 1;
  min-width: 0;
}

.abar-main {
  flex: 1.4;
}

/* 答题卡 sheet */
.sheet {
  background: var(--card);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: var(--sp-8) var(--page-x) calc(var(--sp-16) + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.sheet-handle {
  width: 36px;
  height: 4px;
  border-radius: var(--r-full);
  background: var(--line-strong);
  margin: 0 auto var(--sp-8);
}

.sheet-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--hit-min);
  margin-bottom: var(--sp-8);
}

.sheet-t {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.sheet-x {
  width: var(--hit-min);
  height: var(--hit-min);
  margin-right: calc(-1 * var(--sp-8));
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
}

.sheet-x--hover {
  background: var(--fill);
}

.acard-scroll {
  max-height: 44vh;
}

.acard-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-8);
}

.acard-n {
  width: 44px;
  height: 44px;
  border-radius: var(--r-sm);
  border: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sub);
  color: var(--ink-2);
  background: var(--card);
  box-sizing: border-box;
}

.acard-n.done {
  background: var(--brand-soft);
  border-color: var(--brand);
  color: var(--brand-text);
  font-weight: 600;
}

.acard-n.cur {
  border-width: 2px;
  border-color: var(--brand);
}

.acard-foot {
  font-size: var(--fs-sub);
  color: var(--ink-3);
  margin: var(--sp-12) 0;
  text-align: center;
}
