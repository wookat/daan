<navbar title="{{title}}" back="{{true}}" />
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="wrap">
    <block wx:if="{{loading}}">
      <view class="topbar"><t-skeleton theme="text" animation="gradient" /></view>
      <kg-card variant="raised" class="qcard"><t-skeleton theme="paragraph" animation="gradient" /></kg-card>
    </block>

    <block wx:if="{{!loading && cur}}">
      <view class="topbar">
        <kg-tag tone="brand">{{idx + 1}}/{{items.length}}</kg-tag>
        <view class="clock {{lowTime ? 'low' : ''}}"><l-icon name="timer" size="16" tone="{{lowTime ? 'bad' : 'brand-text'}}" /><text class="num">{{fmtLeft}}</text></view>
        <text class="topinfo">已答 <text class="num">{{answered}}</text></text>
      </view>
      <view class="progress"><kg-progress value="{{idx + 1}}" max="{{items.length}}" thickness="{{4}}" aria-label="作答进度" /></view>

      <!-- kg-question-card / kg-option-group 小程序版未落地：页内按 T3 结构实现 -->
      <kg-card variant="raised" class="qcard">
        <text class="q q-text" user-select>{{cur.question}}</text>
        <image wx:if="{{cur.image}}" class="qimg" src="{{cur.image}}" mode="widthFix" bind:tap="onPreviewImg" />
        <view class="opts">
          <view
            wx:for="{{cur.optList}}"
            wx:key="k"
            class="opt {{cur._picked === item.k ? 'sel' : ''}}"
            hover-class="opt--hover"
            hover-stay-time="60"
            role="radio"
            aria-checked="{{cur._picked === item.k ? 'true' : 'false'}}"
            data-key="{{item.k}}"
            bind:tap="onPick"
          >
            <text class="okey">{{item.k}}</text>
            <text class="otext q-text">{{item.v}}</text>
          </view>
        </view>
      </kg-card>
    </block>
  </view>
</scroll-view>

<kg-action-bar wx:if="{{!loading && cur}}" layout="answer" index="{{idx}}" total="{{items.length}}">
  <kg-button class="abar-btn" variant="ghost" size="lg" disabled="{{idx === 0}}" icon="chevron-left" bind:click="onPrev">上一题</kg-button>
  <kg-button class="abar-btn" variant="ghost" size="lg" icon="clipboard-list" bind:click="onOpenCard">答题卡</kg-button>
  <kg-button wx:if="{{idx + 1 < items.length}}" class="abar-btn abar-main" variant="primary" size="lg" bind:click="onNext">下一题</kg-button>
  <kg-button wx:else class="abar-btn abar-main" variant="primary" size="lg" loading="{{submitting}}" bind:click="onConfirmSubmit">交卷</kg-button>
</kg-action-bar>

<!-- 答题卡 -->
<t-popup visible="{{cardOpen}}" placement="bottom" bind:visible-change="onCardVisible">
  <view class="sheet">
    <view class="sheet-handle" />
    <view class="sheet-h">
      <text class="sheet-t">答题卡</text>
      <view class="sheet-x" hover-class="sheet-x--hover" bind:tap="onCloseCard"><l-icon name="x" size="24" tone="muted" /></view>
    </view>
    <scroll-view scroll-y class="acard-scroll" type="list">
      <view class="acard-grid">
        <view
          wx:for="{{items}}"
          wx:key="index"
          class="acard-n num {{item._picked ? 'done' : ''}} {{index === idx ? 'cur' : ''}}"
          hover-class="opt--hover"
          data-i="{{index}}"
          bind:tap="onJump"
        >{{index + 1}}</view>
      </view>
    </scroll-view>
    <view class="acard-foot">已答 <text class="num">{{answered}}/{{items.length}}</text> · 剩余 <text class="num">{{fmtLeft}}</text></view>
    <kg-button variant="primary" size="lg" block loading="{{submitting}}" bind:click="onConfirmSubmit">交卷</kg-button>
  </view>
</t-popup>
