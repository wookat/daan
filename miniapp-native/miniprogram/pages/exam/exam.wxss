.wrap {
  padding: var(--sp-12) var(--page-x) calc(80px + env(safe-area-inset-bottom));
}

/* 迷你模考 hero */
.hero {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  background: var(--brand-grad);
  border-radius: var(--r-lg);
  padding: var(--sp-20) var(--card-pad);
  margin-bottom: var(--card-gap);
  box-shadow: var(--sh-2);
  position: relative;
  overflow: hidden;
}

.hero-deco {
  position: absolute;
  right: var(--sp-12);
  top: var(--sp-12);
  width: 56px;
  height: 56px;
  border-radius: var(--r-full);
  background: var(--brand-press);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.9;
}

.hero-top {
  display: flex;
  position: relative;
  z-index: 1;
}

.hero-t {
  font-size: var(--fs-h1);
  font-weight: 600;
  color: var(--on-brand);
  margin-top: var(--sp-8);
  position: relative;
  z-index: 1;
}

.hero-s {
  font-size: var(--fs-sub);
  color: var(--on-brand-2);
  margin: var(--sp-4) 0 var(--sp-16);
  position: relative;
  z-index: 1;
}

.stat-row {
  display: flex;
  gap: var(--sp-24);
  margin-bottom: var(--sp-16);
  position: relative;
  z-index: 1;
}

.stat {
  display: flex;
  flex-direction: column;
}

.stat-n {
  font-size: var(--fs-h1);
  font-weight: 600;
  color: var(--on-brand);
  line-height: 1.1;
}

.stat-u {
  font-size: var(--fs-caption);
  font-weight: 500;
  margin-left: 2px;
}

.stat-k {
  font-size: var(--fs-caption);
  color: var(--on-brand-2);
  margin-top: 2px;
}

/* 卷列表 */
.prow {
  display: block;
  margin-bottom: var(--sp-8);
}

.p-row {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
}

.p-badge {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  border-radius: var(--r-sm);
  background: var(--brand-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pb-y {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--brand-text);
  line-height: 1.1;
}

.pb-k {
  font-size: var(--fs-caption);
  color: var(--brand-text);
  margin-top: 2px;
}

.p-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.p-t {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p-s {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}

.more {
  margin-top: var(--sp-8);
}

.list-end {
  display: block;
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--ink-4);
  padding: var(--sp-12) 0;
}

.p-go {
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--brand-text);
  flex-shrink: 0;
}

.resume {
  margin-bottom: var(--sp-12);
}

.rs-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--sp-8);
}

.rs-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.rs-t {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

.rs-s {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rs-go {
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--warn-strong);
  flex-shrink: 0;
}

.att-scroll {
  white-space: nowrap;
  margin-bottom: var(--sp-12);
}

.att {
  display: inline-flex;
  flex-direction: column;
  vertical-align: top;
  width: 150px;
  margin-right: var(--sp-8);
  box-sizing: border-box;
}

.att-score {
  font-size: var(--fs-h1);
  font-weight: 700;
  color: var(--brand-text);
  line-height: 1.1;
}

.att-u {
  font-size: var(--fs-caption);
  font-weight: 600;
  margin-left: 2px;
}

.att-t {
  display: block;
  font-size: var(--fs-sub);
  color: var(--ink);
  margin-top: var(--sp-8);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.att-d {
  display: block;
  font-size: var(--fs-caption);
  color: var(--ink-3);
  margin-top: 2px;
}
