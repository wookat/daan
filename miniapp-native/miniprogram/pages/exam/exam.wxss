.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx 40rpx;
}

.hero-mini {
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, var(--warning-bg), var(--surface));
}

.hm-t {
  font-size: 32rpx;
  font-weight: 700;
}

.hm-s {
  font-size: 24rpx;
  color: var(--t3);
  margin: 8rpx 0 20rpx;
}

.contest {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.c-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.c-t {
  font-size: 30rpx;
  font-weight: 700;
}

.c-s {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

.c-go {
  font-size: 26rpx;
  color: var(--brand-500);
  font-weight: 600;
}

.fscroll {
  width: 100%;
  margin-bottom: 12rpx;
}

.frow {
  display: flex;
  flex-direction: row;
}

.fchip {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 64rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: var(--t2);
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  padding: 0 26rpx;
  margin-right: 12rpx;
}

.fchip.on {
  color: #fff;
  background: var(--brand-500);
  border-color: var(--brand-500);
  font-weight: 600;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 48rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  color: var(--t3);
  font-size: 26rpx;
}

.eico {
  width: 144rpx;
  height: 144rpx;
  border-radius: 48rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.paper-t {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.5;
}

.paper-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.paper-meta .tag {
  margin-right: 12rpx;
}

.pmeta {
  font-size: 23rpx;
  color: var(--t3);
}

.pbest {
  display: block;
  font-size: 22rpx;
  color: var(--warning);
  margin-top: 10rpx;
}

.pbest.none {
  color: var(--t3);
}

.paper-btns {
  display: flex;
  flex-direction: row;
  margin-top: 20rpx;
}

.pbtn {
  flex: 1;
  min-height: 80rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--brand-500);
  color: var(--brand-500);
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 500;
  margin-right: 16rpx;
}

.pbtn:last-child {
  margin-right: 0;
}

.pbtn.main {
  background: var(--brand-500);
  color: #fff;
}

.h {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.arow {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  min-height: 88rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.arow:last-child {
  border-bottom: none;
}

.arow-l {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
}

.arow-t {
  font-size: 25rpx;
  color: var(--t1);
}

.arow-s {
  font-size: 21rpx;
  color: var(--t3);
  margin-top: 4rpx;
}

.arow-score {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand-500);
}
