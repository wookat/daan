.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
}

.hero-mini {
  display: flex;
  flex-direction: column;
  background: linear-gradient(160deg, #8b5cf6 0%, #6d4fd8 60%, #5b3fc4 100%);
  border-radius: var(--r-xl);
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(139, 92, 246, 0.32);
}

.hm-t {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
}

.hm-s {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin: 10rpx 0 24rpx;
}

.hm-btn {
  background: #fff;
  color: #6d4fd8;
  border-radius: var(--r-full);
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 700;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 48rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  color: var(--t3);
  font-size: 26rpx;
}

.eico {
  width: 144rpx;
  height: 144rpx;
  border-radius: 48rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.prow {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.p-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
}

.p-t {
  font-size: 28rpx;
  font-weight: 600;
}

.p-s {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}
