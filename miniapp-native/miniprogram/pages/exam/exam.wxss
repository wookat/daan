.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
}

.hero-mini {
  display: flex;
  flex-direction: column;
}

.hm-t {
  font-size: 32rpx;
  font-weight: 700;
}

.hm-s {
  font-size: 24rpx;
  color: var(--t3);
  margin: 8rpx 0 20rpx;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 48rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  color: var(--t3);
  font-size: 26rpx;
}

.eico {
  width: 144rpx;
  height: 144rpx;
  border-radius: 48rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.prow {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.p-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
}

.p-t {
  font-size: 28rpx;
  font-weight: 600;
}

.p-s {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}
