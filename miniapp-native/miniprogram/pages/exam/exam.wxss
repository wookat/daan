.wrap {
  padding: var(--sp-8) var(--page-x) calc(var(--tab-h) + var(--sp-24) + env(safe-area-inset-bottom));
}

/* 焦点：一句话 + 副文 + 唯一主按钮 */
.focus {
  padding: var(--sp-8) var(--sp-4) var(--sp-4);
}

.focus-k {
  display: block;
  font-size: var(--fs-sub);
  color: var(--warn);
  margin-bottom: var(--sp-4);
}

.focus-t {
  display: block;
  font-size: var(--fs-h2);
  font-weight: 600;
  line-height: 1.35;
  color: var(--ink);
}

.focus-s {
  display: block;
  margin-top: var(--sp-4);
  font-size: var(--fs-sub);
  line-height: 1.5;
  color: var(--ink-3);
}

.focus-acts {
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
  margin-top: var(--sp-12);
}

.focus-hint {
  display: block;
  margin-top: var(--sp-8);
  font-size: var(--fs-caption);
  line-height: 1.5;
  color: var(--brand);
}

.ph {
  padding: var(--sp-12) var(--sp-16);
}

.ph-row {
  padding: var(--sp-8) 0;
}

.list-end {
  display: block;
  text-align: center;
  padding: var(--sp-12) 0;
  font-size: var(--fs-caption);
  color: var(--ink-3);
}
