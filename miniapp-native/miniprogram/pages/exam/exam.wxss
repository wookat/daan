.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
}

.hero-mini {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background: linear-gradient(150deg, #6d5cf6 0%, #4f46e5 60%, #3b2fc9 100%);
  border-radius: var(--r-xl);
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(79, 70, 229, 0.32);
  position: relative;
  overflow: hidden;
}

.hm-deco {
  position: absolute;
  right: 16rpx;
  bottom: -28rpx;
  font-size: 184rpx;
  opacity: 0.16;
  transform: rotate(-12deg);
}

.hm-t {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  position: relative;
  z-index: 1;
}

.hm-s {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin: 8rpx 0 32rpx;
  position: relative;
  z-index: 1;
}

.mh-stats {
  display: flex;
  flex-direction: row;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.mh-stat {
  display: flex;
  flex-direction: column;
  margin-right: 40rpx;
}

.mh-n {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.mh-u {
  font-size: 24rpx;
  font-weight: 700;
}

.mh-k {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.hm-btn {
  background: #fff;
  color: #4f46e5;
  border-radius: var(--r-full);
  text-align: center;
  padding: 22rpx 52rpx;
  font-size: 30rpx;
  font-weight: 800;
  position: relative;
  z-index: 1;
}

.spin {
  text-align: center;
  color: var(--t3);
  padding: 48rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  color: var(--t3);
  font-size: 26rpx;
}

.eico {
  width: 144rpx;
  height: 144rpx;
  border-radius: 48rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.prow {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.p-badge {
  width: 88rpx;
  height: 96rpx;
  border-radius: var(--r-s);
  background: var(--brand-50);
  color: var(--brand-600);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.pb-y {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.pb-k {
  font-size: 18rpx;
  font-weight: 600;
  opacity: 0.8;
}

.p-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
  min-width: 0;
}

.p-t {
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p-s {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 4rpx;
}
