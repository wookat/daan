.wrap {
  padding: var(--sp-12) var(--page-x) calc(var(--bar-h) + var(--sp-24) + env(safe-area-inset-bottom));
}

.sec {
  display: block;
  margin-bottom: var(--card-gap);
}

/* 分数 hero */
.hero {
  position: relative;
  overflow: hidden;
  background: var(--brand-grad);
  border-radius: var(--r-lg);
  padding: var(--sp-20) var(--card-pad);
  margin-bottom: var(--card-gap);
  box-shadow: var(--sh-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hero-skel {
  background: var(--card);
  box-shadow: none;
  align-items: stretch;
}

.hero-deco {
  position: absolute;
  right: -40px;
  top: -60px;
  width: 180px;
  height: 180px;
  border-radius: var(--r-full);
  background: var(--on-brand);
  opacity: 0.08;
}

.hero-s {
  font-size: var(--fs-sub);
  color: var(--on-brand-2);
  position: relative;
  z-index: 1;
}

.score-row {
  display: flex;
  align-items: baseline;
  gap: var(--sp-4);
  margin-top: var(--sp-4);
  position: relative;
  z-index: 1;
}

.score {
  font-size: var(--fs-display);
  font-weight: 600;
  color: var(--on-brand);
  line-height: 1.1;
}

.score-u {
  font-size: var(--fs-body);
  color: var(--on-brand-2);
}

.pct-pill {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-4);
  height: var(--tag-h);
  padding: 0 var(--sp-12);
  margin-top: var(--sp-8);
  border-radius: var(--r-full);
  background: var(--brand-press);
  font-size: var(--fs-caption);
  color: var(--on-brand);
  position: relative;
  z-index: 1;
}

.hero-row {
  display: flex;
  width: 100%;
  margin-top: var(--sp-16);
  padding-top: var(--sp-12);
  border-top: 1px solid var(--brand-press);
  position: relative;
  z-index: 1;
}

.hstat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hv {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--on-brand);
  line-height: 1.2;
}

.hu {
  font-size: var(--fs-caption);
  font-weight: 500;
  margin-left: 1px;
}

.hk {
  font-size: var(--fs-caption);
  color: var(--on-brand-2);
  margin-top: 2px;
}

/* 区块标题 */
.h {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  margin-bottom: var(--sp-12);
}

.h-sub {
  margin-left: auto;
  font-size: var(--fs-caption);
  font-weight: 400;
  color: var(--ink-3);
}

/* 薄弱考点行 */
.wrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-12);
  min-height: var(--cell-h);
  padding: var(--sp-8) 0;
  border-top: 1px solid var(--line);
}

.wrow--hover {
  opacity: 0.7;
}

.wrow-l {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.wrow-t {
  font-size: var(--fs-body);
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wrow-s {
  font-size: var(--fs-caption);
  color: var(--bad-strong);
  margin-top: 2px;
}

.wrow-go {
  display: inline-flex;
  align-items: center;
  height: var(--btn-h-sm);
  padding: 0 var(--sp-8) 0 var(--sp-12);
  border-radius: var(--r-full);
  background: var(--brand-soft);
  color: var(--brand-text);
  font-size: var(--fs-sub);
  font-weight: 600;
  flex-shrink: 0;
}

/* 模块得分 */
.mrow {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  min-height: 32px;
}

.mname {
  flex: 0 0 72px;
  font-size: var(--fs-sub);
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mbar {
  flex: 1;
  min-width: 0;
}

.mval {
  flex: 0 0 48px;
  text-align: right;
  font-size: var(--fs-sub);
  color: var(--ink);
}

/* 逐题回顾 */
.qgrid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-8);
}

.qn {
  width: 44px;
  height: 44px;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sub);
  font-weight: 600;
  border: 1px solid var(--line);
  box-sizing: border-box;
}

.qn--hover {
  opacity: 0.7;
}

.qn.ok {
  background: var(--ok-soft);
  border-color: var(--ok-soft);
  color: var(--ok-strong);
}

.qn.bad {
  background: var(--bad-soft);
  border-color: var(--bad-soft);
  color: var(--bad-strong);
}

.qn.blank {
  background: var(--fill);
  color: var(--ink-3);
}

.legend {
  display: flex;
  gap: var(--sp-16);
  margin-top: var(--sp-12);
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.lg {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-4);
}

.lg-dot {
  width: 10px;
  height: 10px;
  border-radius: 3px;
}

.lg-dot.ok {
  background: var(--ok);
}

.lg-dot.bad {
  background: var(--bad);
}

.lg-dot.blank {
  background: var(--line-strong);
}

/* 题目详情 sheet */
.sheet {
  background: var(--card);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: var(--sp-8) var(--page-x) calc(var(--sp-16) + env(safe-area-inset-bottom));
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.sheet-handle {
  width: 36px;
  height: 4px;
  border-radius: var(--r-full);
  background: var(--line-strong);
  margin: 0 auto var(--sp-8);
}

.sheet-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--hit-min);
  margin-bottom: var(--sp-8);
}

.sheet-t-row {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
}

.sheet-t {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
}

.sheet-x {
  width: var(--hit-min);
  height: var(--hit-min);
  margin-right: calc(-1 * var(--sp-8));
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
}

.sheet-x--hover {
  background: var(--fill);
}

.detail-scroll {
  max-height: 64vh;
}

.q {
  display: block;
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--ink);
  margin-bottom: var(--sp-12);
}

.opts {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
}

.opt {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  min-height: var(--hit-min);
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  padding: var(--sp-8) var(--sp-12);
  background: var(--card);
  box-sizing: border-box;
}

.opt.right {
  border-color: var(--ok);
  background: var(--ok-soft);
}

.opt.wrong {
  border-color: var(--bad);
  background: var(--bad-soft);
}

.okey {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  border-radius: var(--r-full);
  background: var(--fill);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--ink-2);
}

.opt.right .okey {
  background: var(--ok);
  color: var(--on-brand);
}

.opt.wrong .okey {
  background: var(--bad);
  color: var(--on-brand);
}

.otext {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--ink);
  line-height: 1.6;
}

.exp-row {
  display: flex;
  align-items: center;
  gap: var(--sp-8);
  margin-top: var(--sp-16);
  font-size: var(--fs-sub);
}

.exp-k {
  color: var(--ink-3);
}

.exp-ans {
  font-size: var(--fs-h3);
  font-weight: 600;
}

.okc {
  color: var(--ok-strong);
}

.badc {
  color: var(--bad-strong);
}

.exp-picked {
  color: var(--ink-3);
  margin-left: auto;
}

.exp-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--sp-8);
  margin-top: var(--sp-12);
  padding: var(--sp-12);
  border-radius: var(--r-sm);
  background: var(--fill);
}

.exp {
  display: block;
  white-space: pre-wrap;
  font-size: var(--fs-sub);
  line-height: 1.7;
  color: var(--ink-2);
}
