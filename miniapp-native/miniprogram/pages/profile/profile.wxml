<navbar title="我的" />
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="wrap">
    <view class="card usercard">
      <view class="avatar">{{user ? (user.nickname || user.phone || '用').slice(0, 1) : '游'}}</view>
      <view class="u-main">
        <text class="u-name">{{user ? (user.nickname || user.phone) : '游客模式'}}</text>
        <text class="u-sub">{{user ? '已登录 · 多端同步中' : '登录后错题与进度多端同步'}}</text>
      </view>
      <view wx:if="{{!user}}" class="u-btn" bind:tap="onLogin">登录 / 注册</view>
      <view wx:else class="u-btn ghost" bind:tap="onLogout">退出</view>
    </view>

    <view wx:if="{{badgeInfo}}" class="card badges">
      <view class="badge-head">
        <text class="badge-cur">当前连续 {{badgeInfo.streak}} 天</text>
        <text class="badge-best">历史最长 {{badgeInfo.best_streak}} 天</text>
      </view>
      <block wx:if="{{nextMilestone}}">
        <view class="ms-bar"><view class="ms-fill" style="width: {{nextMilestone.pct}}%" /></view>
        <text class="ms-sub">再打卡 {{nextMilestone.left}} 天解锁「{{nextMilestone.days}} 天」徽章</text>
      </block>
      <text wx:elif="{{badgeInfo.badges.length}}" class="ms-sub">已解锁全部打卡徽章，太强了！</text>
      <view class="badge-grid">
        <view
          wx:for="{{badgeInfo.badges}}"
          wx:key="days"
          class="badge {{item.unlocked ? '' : 'off'}}"
          data-days="{{item.days}}"
          data-unlocked="{{item.unlocked}}"
          bind:tap="onTapBadge"
        >
          <text class="badge-ico">{{item.unlocked ? '🏅' : '🔒'}}</text>
          <text class="badge-d">{{item.days}} 天</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="row-i link" bind:tap="onTeam">
        <text class="r-k">刷题小队</text>
        <text class="r-v">组队打卡 · 互相催学 ›</text>
      </view>
    </view>

    <view class="card">
      <view class="row-i"><text class="r-k">本机标识</text><text class="r-v">{{uid}}</text></view>
      <view class="row-i"><text class="r-k">数据同步</text><text class="r-v">{{user ? '账号云端同步' : '匿名（登录后自动合并）'}}</text></view>
      <view class="row-i"><text class="r-k">版本</text><text class="r-v">原生小程序 一期 0.1.0</text></view>
    </view>
  </view>
</scroll-view>
