<view class="hero-bleed"><view class="bleed-c1" /><view class="bleed-c2" /></view>
<navbar title="我的" brand />
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="wrap">
    <!-- 用户信息（沉浸头部上，无卡片） -->
    <view class="u-card">
      <view class="avatar">{{avatarChar}}</view>
      <view class="u-main">
        <text class="u-name">{{user ? (user.nickname || user.phone) : '游客模式'}}</text>
        <text class="u-sub">{{user ? '已登录 · 多端同步中' : '登录后错题与进度多端同步'}}</text>
      </view>
      <kg-button wx:if="{{!user}}" variant="primary" tone="inverse" size="sm" bind:click="onLogin">登录 / 注册</kg-button>
      <kg-button wx:else variant="secondary" tone="inverse" size="sm" bind:click="onLogout">退出</kg-button>
    </view>

    <!-- 数据概览 -->
    <kg-card variant="raised" class="u-stats" padding="{{0}}" body-class="u-stats-body">
      <view class="us-cell"><text class="us-n num c-brand">{{totalDone}}</text><text class="us-t">累计刷题</text></view>
      <view class="us-cell"><text class="us-n num c-streak">{{streakN}}</text><text class="us-t">连续天数</text></view>
      <view class="us-cell"><text class="us-n num c-ok">{{mistakeN}}</text><text class="us-t">错题收录</text></view>
      <view class="us-cell"><text class="us-n num c-info">{{badgeN}}</text><text class="us-t">徽章</text></view>
    </kg-card>

    <kg-card wx:if="{{badgeInfo}}" variant="raised" class="badges">
      <view class="badge-head">
        <text class="badge-cur">当前连续 <text class="badge-b num">{{badgeInfo.streak}}</text> 天</text>
        <text class="badge-best">历史最长 <text class="num">{{badgeInfo.best_streak}}</text> 天</text>
      </view>
      <block wx:if="{{nextMilestone}}">
        <kg-progress value="{{nextMilestone.pct}}" thickness="{{6}}" aria-label="下一徽章进度" />
        <text class="ms-sub">再打卡 <text class="num">{{nextMilestone.left}}</text> 天解锁「{{nextMilestone.days}} 天」徽章</text>
      </block>
      <text wx:elif="{{badgeInfo.badges.length}}" class="ms-sub">已解锁全部打卡徽章，太强了！</text>
      <view class="badge-grid">
        <view
          wx:for="{{badgeInfo.badges}}"
          wx:key="days"
          class="badge {{item.unlocked ? '' : 'off'}}"
          hover-class="badge--hover"
          data-days="{{item.days}}"
          data-unlocked="{{item.unlocked}}"
          bind:tap="onTapBadge"
        >
          <view class="badge-ico">
            <l-icon name="{{item.unlocked ? 'medal' : 'eye-off'}}" size="24" tone="{{item.unlocked ? 'streak' : 'faint'}}" />
          </view>
          <text class="badge-d"><text class="num">{{item.days}}</text> 天</text>
        </view>
      </view>
    </kg-card>

    <t-cell-group class="cells">
      <t-cell title="真题卷库" description="历年真题 · 模考记录" arrow hover bind:click="onExamList">
        <view slot="left-icon" class="row-ico bg-brand"><l-icon name="file-text" size="20" tone="brand" /></view>
      </t-cell>
      <t-cell title="申论专区" description="真题 + AI 采分点批改 · 素材范文" arrow hover bind:click="onShenlun">
        <view slot="left-icon" class="row-ico bg-brand"><l-icon name="pen-line" size="20" tone="brand" /></view>
      </t-cell>
      <t-cell title="刷题小队" description="组队打卡 · 互相催学" arrow hover bind:click="onTeam">
        <view slot="left-icon" class="row-ico bg-brand"><l-icon name="users" size="20" tone="brand" /></view>
      </t-cell>
      <t-cell title="学习提醒" description="{{reminderOn ? '已开启 · 点击关闭' : '每天提醒我打卡刷题'}}" arrow hover bind:click="onReminder">
        <view slot="left-icon" class="row-ico bg-streak"><l-icon name="alarm-clock" size="20" tone="streak" /></view>
      </t-cell>
    </t-cell-group>

    <t-cell-group class="cells">
      <t-cell title="数据同步" note="{{user ? '账号云端同步' : '匿名（登录后自动合并）'}}">
        <view slot="left-icon" class="row-ico bg-info"><l-icon name="refresh-cw" size="20" tone="info" /></view>
      </t-cell>
      <t-cell title="本机标识" note="{{uid}}">
        <view slot="left-icon" class="row-ico bg-fill"><l-icon name="user-round" size="20" tone="muted" /></view>
      </t-cell>
      <t-cell title="版本" note="v0.2">
        <view slot="left-icon" class="row-ico bg-fill"><l-icon name="info" size="20" tone="muted" /></view>
      </t-cell>
    </t-cell-group>
  </view>
</scroll-view>
