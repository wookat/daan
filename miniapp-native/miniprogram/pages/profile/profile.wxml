<navbar class="{{tc}}" title="我的" large>
  <view class="nav-icon-btn" hover-class="nav-icon-btn--hover" aria-role="button" aria-label="消息" bind:tap="onInbox">
    <l-icon name="bell" size="22" tone="ink" />
    <view wx:if="{{inboxUnread}}" class="nav-dot" />
  </view>
</navbar>
<scroll-view class="{{tc}} page-scroll" scroll-y type="list">
  <view class="wrap">
    <view class="user">
      <view class="avatar">{{avatarChar}}</view>
      <view class="u-main">
        <text class="u-name">{{user ? (user.nickname || user.phone) : '游客模式'}}</text>
        <text class="u-sub">{{user ? '已登录 · 多端同步中' : '登录后错题与进度多端同步'}}</text>
      </view>
      <kg-button wx:if="{{!user}}" variant="primary" size="sm" bind:click="onLogin">登录</kg-button>
    </view>

    <view class="nums">
      <view class="nums-it"><text class="nums-n num">{{totalDone}}</text><text class="nums-k">累计题数</text></view>
      <view class="nums-it"><text class="nums-n num">{{streakN}}</text><text class="nums-k">连续天数</text></view>
      <view class="nums-it"><text class="nums-n num">{{mistakeN}}</text><text class="nums-k">错题</text></view>
      <view class="nums-it"><text class="nums-n num">{{medalsGot}}</text><text class="nums-k">成就</text></view>
    </view>

    <kg-group title="记录">
      <kg-row icon="clock" title="练习历史" bind:click="onPracticeHistory" />
      <kg-row icon="clipboard-list" title="模考记录" bind:click="onExamList" />
      <kg-row icon="pen-line" title="申论作答" bind:click="onShenlun" />
      <kg-row icon="mic" title="面试陪练记录" bind:click="onInterviewHistory" />
      <kg-row icon="swords" title="PK 战绩" value="{{pkN ? pkN + ' 局' : ''}}" bind:click="onPk" />
      <kg-row icon="bookmark" title="收藏与笔记" last bind:click="onFavorites" />
    </kg-group>

    <kg-group title="成长">
      <view class="badges-hd">
        <text class="badges-t">成就勋章</text>
        <text class="badges-s">已获 {{medalsGot}}/{{medals.length}}</text>
      </view>
      <view class="medals">
        <view wx:for="{{medals}}" wx:key="name" class="medal {{item.got ? 'is-got' : ''}}">
          <l-icon name="{{item.icon}}" size="24" tone="{{item.got ? 'warn' : 'faint'}}" />
          <text class="m-name">{{item.name}}</text>
          <text class="m-sub">{{item.progress}}</text>
        </view>
      </view>
      <view wx:if="{{badgeInfo && badgeInfo.badges.length}}" class="badges">
        <view class="badges-hd">
          <text class="badges-t">打卡徽章</text>
          <text wx:if="{{nextMilestone}}" class="badges-s">再坚持 {{nextMilestone.left}} 天解锁 {{nextMilestone.days}} 天</text>
          <text wx:else class="badges-s">全部解锁</text>
        </view>
        <view class="badges-row">
          <view wx:for="{{badgeInfo.badges}}" wx:key="days" class="badge {{item.unlocked ? 'is-on' : ''}}" aria-role="button" aria-label="{{item.days + ' 天打卡徽章' + (item.unlocked ? '，已解锁' : '，未解锁')}}" hover-class="row--hover" data-days="{{item.days}}" data-unlocked="{{item.unlocked}}" bind:tap="onTapBadge">
            <view class="badge-dot" />
            <text class="badge-n num">{{item.days}}<text class="badge-k">天</text></text>
          </view>
        </view>
      </view>
      <kg-row icon="users" title="刷题小队" last bind:click="onTeam" />
    </kg-group>

    <kg-group title="外观">
      <view class="theme-sec">
        <text class="theme-k">深色模式</text>
        <kg-segmented options="{{themeModes}}" value="{{modeKey}}" bind:change="onThemeMode" />
        <text class="theme-k">主题色</text>
        <view class="theme-accs" role="radiogroup">
          <view wx:for="{{themeAccents}}" wx:key="key" class="theme-acc {{accKey === item.key ? 'on' : ''}}" role="radio" aria-checked="{{accKey === item.key}}" data-key="{{item.key}}" bind:tap="onThemeAcc">
            <view class="acc-dot" style="background: {{item.color}}" />
            <text class="acc-t">{{item.label}}</text>
          </view>
        </view>
      </view>
    </kg-group>

    <kg-group title="设置">
      <kg-row icon="package" title="离线题包" value="{{offlineN ? offlineN + ' 个' : ''}}" bind:click="onOffline" />
      <kg-row wx:if="{{remindAvail}}" icon="alarm-clock" title="学习提醒" value="{{reminderOn ? '已开启' : '未开启'}}" bind:click="onReminder" />
      <kg-row icon="refresh-cw" title="数据同步" desc="{{user ? '' : '登录后错题与进度跨设备同步'}}" value="{{user ? '云端' : '仅本机'}}" chevron="{{false}}" bind:click="onCopyUid" />
      <kg-row wx:if="{{user}}" icon="log-out" title="退出登录" chevron="{{false}}" bind:click="onLogout" />
      <kg-row icon="info" title="版本" value="{{version}}" chevron="{{false}}" last />
    </kg-group>
  </view>
</scroll-view>
