.wrap {
  padding: var(--sp-8) var(--page-x) calc(var(--tab-h) + var(--sp-24) + env(safe-area-inset-bottom));
}

.nav-dot {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 8px;
  height: 8px;
  border-radius: var(--r-full);
  background: var(--bad);
}

/* 用户信息 */
.user {
  display: flex;
  align-items: center;
  gap: var(--sp-12);
  padding: var(--sp-8) var(--sp-4) var(--sp-16);
}

.avatar {
  width: 52px;
  height: 52px;
  border-radius: var(--r-full);
  background: var(--fill);
  color: var(--ink-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-h2);
  font-weight: 600;
  flex-shrink: 0;
}

.u-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.u-name {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.u-sub {
  font-size: var(--fs-sub);
  color: var(--ink-3);
}

/* 一行四数 */
.nums {
  display: flex;
  padding: 0 var(--sp-4);
}

.nums-it {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}

.nums-n {
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.1;
  color: var(--ink);
}

.nums-k {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

/* 成长组内块 */
.badges-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--sp-16) var(--sp-16) 0;
}

.badges-t {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--ink);
}

.badges-s {
  font-size: var(--fs-caption);
  color: var(--ink-3);
}

.medals {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--sp-12) var(--sp-8);
  padding: var(--sp-12) var(--sp-16) var(--sp-16);
}

.medal {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-4);
  text-align: center;
}

.m-name {
  font-size: var(--fs-caption);
  color: var(--ink-3);
  line-height: 1.3;
}

.medal.is-got .m-name {
  color: var(--ink);
  font-weight: 500;
}

.m-sub {
  font-size: 10px;
  color: var(--ink-4);
  line-height: 1.3;
}

.badges {
  position: relative;
}

.badges::before {
  content: '';
  position: absolute;
  left: var(--sp-16);
  right: 0;
  top: 0;
  height: 1px;
  background: var(--line);
}

.badges-row {
  display: flex;
  gap: var(--sp-8);
  padding: var(--sp-12) var(--sp-16) var(--sp-16);
}

.badge {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 2px;
  height: 36px;
  border-radius: var(--r-sm);
  background: var(--fill);
  color: var(--ink-4);
}

.badge.is-on {
  background: var(--warn-soft);
  color: var(--warn);
}

.badge-n {
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 36px;
}

.badge-k {
  font-size: var(--fs-caption);
}

.row--hover {
  opacity: 0.7;
}
