.page-scroll {
  flex: 1;
  height: 100%;
}

.wrap {
  padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
}

.usercard {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-full);
  background: var(--brand-50);
  color: var(--brand-500);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 20rpx;
}

.u-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.u-name {
  font-size: 30rpx;
  font-weight: 600;
}

.u-sub {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

.u-btn {
  background: var(--brand-500);
  color: #fff;
  border-radius: var(--r-full);
  padding: 14rpx 32rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.u-btn.ghost {
  background: var(--fill);
  color: var(--t2);
}

.row-i {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-top: 1rpx solid var(--border);
}

.row-i:first-of-type {
  border-top: none;
}

.r-k {
  font-size: 27rpx;
  color: var(--t1);
}

.r-v {
  font-size: 23rpx;
  color: var(--t3);
  max-width: 60%;
  text-align: right;
}

.row-i.link .r-v {
  color: var(--brand-500);
}

/* 打卡里程碑徽章墙 */
.badges {
  padding: 26rpx 28rpx;
}
.badge-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.badge-cur {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--t1);
}
.badge-best {
  font-size: 22rpx;
  color: var(--t3);
}
.ms-bar {
  height: 12rpx;
  background: var(--fill);
  border-radius: var(--r-full);
  overflow: hidden;
  margin-bottom: 8rpx;
}
.ms-fill {
  height: 100%;
  background: linear-gradient(90deg, #5b8af8, var(--brand-500));
  border-radius: var(--r-full);
}
.ms-sub {
  display: block;
  font-size: 22rpx;
  color: var(--t3);
  margin-bottom: 20rpx;
}
.badge-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}
.badge {
  width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: var(--brand-50);
  border-radius: 18rpx;
  padding: 18rpx 0;
}
.badge.off {
  background: var(--fill);
  opacity: 0.7;
}
.badge-ico {
  font-size: 40rpx;
}
.badge-d {
  font-size: 22rpx;
  color: var(--t2);
  font-weight: 600;
}
