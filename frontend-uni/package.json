{
  "name": "uni-preset-vue",
  "version": "0.0.0",
  "scripts": {
    "dev:custom": "uni -p",
    "dev:h5": "uni",
    "dev:h5:ssr": "uni --ssr",
    "build:custom": "uni build -p",
    "build:h5": "npm run sync-brand && uni build && node scripts/inline-critical-css.mjs && node scripts/route-preload.mjs && node scripts/gen-precache-manifest.mjs && node scripts/copy-sw.mjs",
    "build:h5:ssr": "uni build --ssr",
    "build:android": "VITE_API_BASE=${VITE_API_BASE:-https://kaogong.zalize.com} uni build && cap sync android && (cd android && ./gradlew assembleDebug)",
    "sync-brand": "node scripts/sync-brand-tokens.mjs",
    "lint": "npm run lint:tokens && eslint src tests && npm run lint:edge",
    "lint:tokens": "node ../tools/design-tokens/build.mjs --check && node ../tools/design-tokens/lint-pages.mjs --quiet",
    "tokens": "node ../tools/design-tokens/build.mjs",
    "lint:edge": "cd .. && eslint deploy/cf-pages/functions",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "8.0.1",
    "@capacitor/camera": "8.2.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "8.1.2",
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-components": "3.0.0-5010520260709002",
    "@dcloudio/uni-h5": "3.0.0-5010520260709002",
    "@zalize/brand": "github:wookat/zalize-brand#129920bc1df1b69f415d8bf75fd3f95b7988e79e",
    "vue": "^3.4.21",
    "wot-design-uni": "1.14.0",
    "echarts": "^5.6.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5010520260709002",
    "@dcloudio/uni-stacktracey": "3.0.0-5010520260709002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
    "@vue/runtime-core": "^3.4.21",
    "eslint": "^9.39.3",
    "eslint-plugin-vue": "^10.6.2",
    "rollup": "4.63.0",
    "sass": "^1.99.0",
    "vite": "5.2.8",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "adm-zip": ">=0.6.0",
    "jpeg-js": ">=0.4.4",
    "path-to-regexp": ">=0.1.13",
    "postcss": ">=8.5.23",
    "ws": ">=8.21.0",
    "nanoid": "^3.3.18",
    "js-yaml": ">=3.15.1",
    "@intlify/message-resolver": "9.1.11",
    "@intlify/core-base": ">=9.14.5"
  }
}