{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/ask/ask",
      "style": { "navigationBarTitleText": "拍题讲解" }
    },
    {
      "path": "pages/practice/practice",
      "style": { "navigationBarTitleText": "刷题" }
    },
    {
      "path": "pages/book/book",
      "style": { "navigationBarTitleText": "错题本" }
    },
    {
      "path": "pages/stats/stats",
      "style": { "navigationBarTitleText": "统计" }
    },
    {
      "path": "pages/stats/calendar",
      "style": { "navigationBarTitleText": "学习日历" }
    },
    {
      "path": "pages/shenlun/shenlun",
      "style": { "navigationBarTitleText": "申论专区" }
    },
    {
      "path": "pages/user/login",
      "style": { "navigationBarTitleText": "登录 / 注册" }
    },
    {
      "path": "pages/exam/list",
      "style": { "navigationBarTitleText": "真题卷库" }
    },
    {
      "path": "pages/exam/exam",
      "style": { "navigationBarTitleText": "全真模考" }
    },
    {
      "path": "pages/exam/report",
      "style": { "navigationBarTitleText": "成绩报告" }
    }
  ],
  "tabBar": {
    "color": "#8a90a0",
    "selectedColor": "#3b6ff5",
    "backgroundColor": "#ffffff",
    "list": [
      { "pagePath": "pages/ask/ask", "text": "拍题讲解", "iconPath": "static/tab/ask.png", "selectedIconPath": "static/tab/ask-on.png" },
      { "pagePath": "pages/practice/practice", "text": "刷题", "iconPath": "static/tab/practice.png", "selectedIconPath": "static/tab/practice-on.png" },
      { "pagePath": "pages/book/book", "text": "错题本", "iconPath": "static/tab/book.png", "selectedIconPath": "static/tab/book-on.png" },
      { "pagePath": "pages/stats/stats", "text": "统计", "iconPath": "static/tab/stats.png", "selectedIconPath": "static/tab/stats-on.png" }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "考公错题助手",
    "navigationBarBackgroundColor": "#f6f7fb",
    "backgroundColor": "#f5f6fa"
  }
}
