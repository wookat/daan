{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "考公错题助手 设计 token 唯一来源（docs/design-system/SPEC.md §6.2）。DTCG $type/$value + 两个约定：$dark 深色值、{a.b.c} 引用。改这里，然后 node tools/design-tokens/build.mjs。",
  "color": {
    "$description": "原始层：不生成 CSS 变量。brand.* 抄录 @zalize/brand（frontend-uni/src/static/brand/zalize-tokens.css），--check 比对。",
    "brand": {
      "50": { "$type": "color", "$value": "#eef3ff" },
      "100": { "$type": "color", "$value": "#dbe6ff" },
      "200": { "$type": "color", "$value": "#b8ccff" },
      "300": { "$type": "color", "$value": "#8aa9ff" },
      "400": { "$type": "color", "$value": "#5c82ff" },
      "500": { "$type": "color", "$value": "#2e5bff" },
      "600": { "$type": "color", "$value": "#1e44d9" },
      "700": { "$type": "color", "$value": "#1735ab" }
    },
    "ink": {
      "900": { "$type": "color", "$value": "#17181c" },
      "700": { "$type": "color", "$value": "#40434e" },
      "500": { "$type": "color", "$value": "#6b7280" },
      "300": { "$type": "color", "$value": "#b0b4c0" },
      "200": { "$type": "color", "$value": "#e7e9f0" },
      "100": { "$type": "color", "$value": "#f2f3f7" },
      "50": { "$type": "color", "$value": "#f6f7fb" }
    },
    "night": {
      "900": { "$type": "color", "$value": "#15161c" },
      "800": { "$type": "color", "$value": "#1d1f28" },
      "700": { "$type": "color", "$value": "#23252f" },
      "600": { "$type": "color", "$value": "#2b2e3a" },
      "500": { "$type": "color", "$value": "#5c6070" },
      "400": { "$type": "color", "$value": "#8a8ea0" },
      "200": { "$type": "color", "$value": "#c3c7d4" },
      "50": { "$type": "color", "$value": "#f2f3f7" }
    },
    "green": {
      "600": { "$type": "color", "$value": "#16a34a" },
      "700": { "$type": "color", "$value": "#15803d" },
      "400": { "$type": "color", "$value": "#4ade80" },
      "50": { "$type": "color", "$value": "#ecfdf5" }
    },
    "red": {
      "600": { "$type": "color", "$value": "#dc2626" },
      "700": { "$type": "color", "$value": "#b91c1c" },
      "400": { "$type": "color", "$value": "#f87171" },
      "50": { "$type": "color", "$value": "#fef2f2" }
    },
    "amber": {
      "600": { "$type": "color", "$value": "#d97706" },
      "700": { "$type": "color", "$value": "#b45309" },
      "400": { "$type": "color", "$value": "#fbbf24" },
      "50": { "$type": "color", "$value": "#fffbeb" }
    },
    "sky": {
      "600": { "$type": "color", "$value": "#0284c7" },
      "800": { "$type": "color", "$value": "#075985" },
      "300": { "$type": "color", "$value": "#7dd3fc" },
      "50": { "$type": "color", "$value": "#f0f9ff" }
    },
    "white": { "$type": "color", "$value": "#ffffff" }
  },
  "sem": {
    "$description": "语义层：每个键生成 --<key>（浅色）与 .theme-dark / prefers-color-scheme 深色映射。页面只允许引用这一层。",
    "brand": { "$type": "color", "$value": "{color.brand.500}" },
    "brand-press": { "$type": "color", "$value": "{color.brand.600}" },
    "brand-text": { "$type": "color", "$value": "{color.brand.600}", "$dark": "#8fa8ff" },
    "brand-soft": { "$type": "color", "$value": "{color.brand.50}", "$dark": "#1e2a4a" },
    "brand-soft-2": { "$type": "color", "$value": "{color.brand.100}", "$dark": "#24345c" },
    "brand-grad": { "$type": "gradient", "$value": "linear-gradient(135deg, {color.brand.400}, {color.brand.500})" },
    "on-brand": { "$type": "color", "$value": "{color.white}" },
    "on-brand-2": { "$type": "color", "$value": "rgba(255,255,255,.78)" },

    "ok": { "$type": "color", "$value": "{color.green.600}" },
    "ok-strong": { "$type": "color", "$value": "{color.green.700}", "$dark": "{color.green.400}" },
    "ok-soft": { "$type": "color", "$value": "{color.green.50}", "$dark": "#0e2b1e" },
    "bad": { "$type": "color", "$value": "{color.red.600}" },
    "bad-strong": { "$type": "color", "$value": "{color.red.700}", "$dark": "{color.red.400}" },
    "bad-soft": { "$type": "color", "$value": "{color.red.50}", "$dark": "#331416" },
    "warn": { "$type": "color", "$value": "{color.amber.600}" },
    "warn-strong": { "$type": "color", "$value": "{color.amber.700}", "$dark": "{color.amber.400}" },
    "warn-soft": { "$type": "color", "$value": "{color.amber.50}", "$dark": "#33260e" },
    "info": { "$type": "color", "$value": "{color.sky.600}" },
    "info-strong": { "$type": "color", "$value": "{color.sky.800}", "$dark": "{color.sky.300}" },
    "info-soft": { "$type": "color", "$value": "{color.sky.50}", "$dark": "#0e2233" },

    "ink": { "$type": "color", "$value": "{color.ink.900}", "$dark": "{color.night.50}" },
    "ink-2": { "$type": "color", "$value": "{color.ink.700}", "$dark": "{color.night.200}" },
    "ink-3": { "$type": "color", "$value": "{color.ink.500}", "$dark": "{color.night.400}" },
    "ink-4": { "$type": "color", "$value": "{color.ink.300}", "$dark": "{color.night.500}" },
    "line": { "$type": "color", "$value": "{color.ink.200}", "$dark": "{color.night.600}" },
    "line-strong": { "$type": "color", "$value": "#c9cdd8", "$dark": "#3a3e4c" },
    "fill": { "$type": "color", "$value": "{color.ink.100}", "$dark": "{color.night.700}" },
    "card": { "$type": "color", "$value": "{color.white}", "$dark": "{color.night.800}" },
    "bg": { "$type": "color", "$value": "{color.ink.50}", "$dark": "{color.night.900}" },
    "mask": { "$type": "color", "$value": "rgba(23,24,28,.45)", "$dark": "rgba(0,0,0,.6)" },
    "card-fade": { "$type": "color", "$value": "rgba(255,255,255,.9)", "$dark": "rgba(29,31,40,.9)", "$description": "卡面渐隐（滚轮选择器上下遮罩起点）" },
    "card-fade-2": { "$type": "color", "$value": "rgba(255,255,255,.25)", "$dark": "rgba(29,31,40,.25)" },
    "hl-bg": { "$type": "color", "$value": "#fef08a", "$dark": "rgba(250,204,21,.22)", "$description": "题干关键词高亮底" },
    "hl-ink": { "$type": "color", "$value": "inherit", "$dark": "#fde047" },

    "sh-1": { "$type": "shadow", "$value": "0 2px 8px rgba(23,24,28,.06)", "$dark": "none" },
    "sh-2": { "$type": "shadow", "$value": "0 8px 24px rgba(23,24,28,.12)", "$dark": "none" },
    "sh-3": { "$type": "shadow", "$value": "0 12px 32px rgba(23,24,28,.18)", "$dark": "none" },

    "font-sans": { "$type": "fontFamily", "$value": "Inter, -apple-system, BlinkMacSystemFont, 'PingFang SC', 'HarmonyOS Sans', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC', system-ui, sans-serif" },
    "fw-regular": { "$type": "fontWeight", "$value": 400 },
    "fw-medium": { "$type": "fontWeight", "$value": 500 },
    "fw-semibold": { "$type": "fontWeight", "$value": 600 }
  },
  "fs": {
    "$description": "字阶 7 档，px 优先；rpx 换算（×2）必须为偶数，--check 校验。$lineHeight 额外生成 --lh-<name>。",
    "display": { "$type": "dimension", "$value": "32px", "$lineHeight": 1.2 },
    "h1": { "$type": "dimension", "$value": "24px", "$lineHeight": 1.25 },
    "h2": { "$type": "dimension", "$value": "20px", "$lineHeight": 1.3 },
    "h3": { "$type": "dimension", "$value": "17px", "$lineHeight": 1.3 },
    "body": { "$type": "dimension", "$value": "15px", "$lineHeight": 1.55 },
    "sub": { "$type": "dimension", "$value": "13px", "$lineHeight": 1.45 },
    "caption": { "$type": "dimension", "$value": "12px", "$lineHeight": 1.4 }
  },
  "lh": {
    "question": { "$type": "number", "$value": 1.7 }
  },
  "sp": {
    "4": { "$type": "dimension", "$value": "4px" },
    "8": { "$type": "dimension", "$value": "8px" },
    "12": { "$type": "dimension", "$value": "12px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "20": { "$type": "dimension", "$value": "20px" },
    "24": { "$type": "dimension", "$value": "24px" },
    "32": { "$type": "dimension", "$value": "32px" },
    "40": { "$type": "dimension", "$value": "40px" },
    "48": { "$type": "dimension", "$value": "48px" }
  },
  "r": {
    "xs": { "$type": "dimension", "$value": "6px" },
    "sm": { "$type": "dimension", "$value": "10px" },
    "md": { "$type": "dimension", "$value": "14px" },
    "lg": { "$type": "dimension", "$value": "20px" },
    "full": { "$type": "dimension", "$value": "999px" }
  },
  "dur": {
    "instant": { "$type": "duration", "$value": "100ms" },
    "fast": { "$type": "duration", "$value": "150ms" },
    "base": { "$type": "duration", "$value": "250ms" },
    "slow": { "$type": "duration", "$value": "400ms" }
  },
  "ease": {
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
    "decel": { "$type": "cubicBezier", "$value": [0.05, 0.7, 0.1, 1] },
    "accel": { "$type": "cubicBezier", "$value": [0.3, 0, 0.8, 0.15] }
  },
  "icon": {
    "sm": { "$type": "dimension", "$value": "16px" },
    "md": { "$type": "dimension", "$value": "20px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "32px" }
  },
  "z": {
    "sticky": { "$type": "number", "$value": 10 },
    "bar": { "$type": "number", "$value": 50 },
    "overlay": { "$type": "number", "$value": 1000, "$description": "uni-h5 壳 page-head/tabbar 998、原生 toast/modal 999（node_modules/@dcloudio/uni-h5/style/framework）；遮罩+sheet 必须压过壳" },
    "toast": { "$type": "number", "$value": 1100 }
  },
  "bp": {
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1024px" },
    "xl": { "$type": "dimension", "$value": "1366px" }
  },
  "comp": {
    "$description": "组件层常量（COMPONENTS.md §3）。",
    "btn-h-lg": { "$type": "dimension", "$value": "44px" },
    "btn-h-md": { "$type": "dimension", "$value": "36px" },
    "btn-h-sm": { "$type": "dimension", "$value": "32px" },
    "input-h": { "$type": "dimension", "$value": "44px" },
    "chip-h": { "$type": "dimension", "$value": "32px" },
    "tag-h": { "$type": "dimension", "$value": "20px" },
    "cell-h": { "$type": "dimension", "$value": "52px" },
    "bar-h": { "$type": "dimension", "$value": "64px" },
    "card-pad": { "$type": "dimension", "$value": "16px" },
    "card-gap": { "$type": "dimension", "$value": "12px" },
    "page-x": { "$type": "dimension", "$value": "16px" },
    "opt-letter": { "$type": "dimension", "$value": "26px" },
    "acard-cell": { "$type": "dimension", "$value": "40px" },
    "hit-min": { "$type": "dimension", "$value": "44px" },
    "prog-track": { "$type": "color", "$value": "{color.brand.100}", "$dark": "{color.night.600}", "$description": "进度条/环形槽色，深色独立映射（修 3 处深色槽漏网）" },
    "streak": { "$type": "color", "$value": "#ff8a3d" },
    "streak-soft": { "$type": "color", "$value": "#fff1e8", "$dark": "#3a2418" }
  },
  "mod": {
    "$description": "模块色：同时生成 --mod-<key>/--mod-<key>-soft 与 module-meta.js/.ts（替代 home/practice/discuss/favorites 4 份 COLORS 表）。",
    "ziliao": { "$type": "color", "$value": "#0d9488", "$soft": "#e6f5f3", "$softDark": "#0e332f", "label": "资料分析", "short": "资料", "icon": "chart-pie" },
    "shuliang": { "$type": "color", "$value": "#2e5bff", "$soft": "#e8effe", "$softDark": "#1c2742", "label": "数量关系", "short": "数量", "icon": "calculator" },
    "yanyu": { "$type": "color", "$value": "#e11d48", "$soft": "#fce8ec", "$softDark": "#3b1520", "label": "言语理解", "short": "言语", "icon": "message-square" },
    "panduan": { "$type": "color", "$value": "#7c3aed", "$soft": "#f1eafd", "$softDark": "#291f45", "label": "判断推理", "short": "判断", "icon": "puzzle" },
    "changshi": { "$type": "color", "$value": "#d97706", "$soft": "#fbf1e0", "$softDark": "#3a2b0e", "label": "常识判断", "short": "常识", "icon": "lightbulb" }
  }
}
